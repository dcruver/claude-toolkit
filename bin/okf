#!/usr/bin/env bash
# okf — OKF code knowledge for a repository.
#
# Deterministic, offline bookkeeping over co-located OKF concept files: which
# sources are in scope, what has drifted, how often a type is referenced, and
# (Tier B, opt-in) chunking/embedding for semantic search. The design reference
# is SPEC.md; §7 defines this CLI surface and its exit codes.
#
# This script never parses source code and never invokes an LLM. Reading source,
# deciding a tier and authoring prose belong to the commands/okf-*.md slash
# commands — see SPEC.md's division of labour.
#
# Exit codes (SPEC.md §7):
#   0  success
#   1  error, or a missing prerequisite
#   2  a Tier B subcommand was invoked without an `index` block in okf.json
#   3  `check --strict` found drift
#
# Installed exactly like bin/ralph: copied onto $PATH by install.sh. There is no
# compiled artifact and no build step.

set -euo pipefail

# The SPEC.md §7 subcommand surface, and the single source of truth for what
# dispatch accepts. Each name routes to the cmd_<name> function below; adding a
# name here without its function is caught at dispatch rather than silently
# doing nothing.
OKF_SUBCOMMANDS=(init list hash fanin check index verify chunk embed search)

# The help text, and the user-facing half of the SPEC.md §7 CLI surface.
#
# Written out as one literal block rather than generated from OKF_SUBCOMMANDS,
# because the flags and the one-line summaries are as much a part of that
# surface as the names are, and a generated list could only ever print names.
# The names here and in OKF_SUBCOMMANDS are both checked against SPEC.md §7 by
# tests/toolkit.sh, so the two cannot drift apart unnoticed.
#
# Nothing here reads okf.json or the repo: help is the one thing that must
# print the same for every caller, in any directory, whatever the bundle
# contains. SPEC.md §3's preflight still runs ahead of it, and so does -C's own
# check that the directory it names is there: an invocation okf cannot carry
# out is better answered with the reason than with a page of help.
usage() {
  # Printed with printf rather than a here-document into `cat`: what bin/okf
  # needs is SPEC.md §3's list and nothing besides. A `cat` here would be a
  # tool the preflight does not know to check and so could never name — the
  # one failure it exists to turn into a single readable line.
  printf '%s\n' \
    'okf — OKF code knowledge for a repository.' \
    '' \
    'Usage: okf [-C DIR] [--config PATH] <subcommand> [flags]' \
    '' \
    'Subcommands:' \
    '  init [--force]                       write okf.json + the bundle-root index.md' \
    '  list [--missing] [--orphans]         in-scope source files' \
    '  hash <file>                          the sha256: digest of one file' \
    '  fanin <Name>                         whole-word reference count for a name' \
    '  check [--strict] [--stamp] [--json]  drift, missing and orphan concepts' \
    '  index                                regenerate the per-directory index.md files' \
    '  verify <concept> [--by ACTOR]        append a verified entry' \
    '  chunk <concept>                      JSON chunks for one concept' \
    '  embed [--all]                        embed and upsert to Qdrant' \
    '  search <query> [--hyde-prompt] [--k N] [--repo R] [--type T]' \
    '' \
    'Global flags:' \
    '  -C DIR                               resolve every path against DIR' \
    '                                       instead of the current directory' \
    '  --config PATH                        read settings from PATH, itself' \
    '                                       relative to the root (default:' \
    '                                       ./okf.json)' \
    '  -h, --help                           print this help' \
    '' \
    '-C and --config may be given before or after the subcommand; -h is asked' \
    'for on its own.' \
    '' \
    'chunk, embed and search are Tier B: each needs an `index` block in okf.json.' \
    '' \
    'Exit codes:' \
    '  0  success' \
    '  1  error, or a missing prerequisite' \
    '  2  a Tier B subcommand was invoked without an `index` block in okf.json' \
    '  3  `check --strict` found drift'
}

# One or more lines on stderr, each prefixed so a line of okf's is telling apart
# from a line of whatever it shelled out to. stderr and not stdout because a
# subcommand's stdout is its answer — a listing a caller pipes into something —
# and a warning mixed into it becomes a path that names no file.
warn() { # $1.. = message lines
  local line
  for line in "$@"; do
    printf 'okf: %s\n' "$line" >&2
  done
}

# The same lines, and then no further work. Every exit here is SPEC.md §7's
# 1 — an error, or a missing prerequisite.
die() { # $1.. = message lines
  warn "$@"
  exit 1
}

# Placeholder for a subcommand that dispatch recognises but that has not been
# built yet. Exits 1 — "recognised" is not "succeeded", and a stub that exited 0
# would let a caller mistake doing nothing for having done the work.
not_implemented() { # $1 = subcommand name
  die "$1 is not implemented yet"
}

# ---------------------------------------------------------------------------
# Preflight (SPEC.md §3)
# ---------------------------------------------------------------------------

# Everything bin/okf shells out to, in SPEC.md §3's order. jq and rg are on
# this list as hard requirements and not as niceties: install.sh can fall back
# to a jq-less permission merge, but nothing okf does — reading okf.json,
# counting fan-in — has a fallback, and a half-finished run is worse than a
# refusal. bash is listed because §3 lists it; see have_tool for how it is
# checked.
#
# The list is §3's, not an inventory of what today's subcommands happen to
# invoke. §3 added `sort` on 2026-08-27 for the merge of untracked files into
# `okf list`, which is not written yet: a preflight that waited for the first
# caller to need it would let a machine without `sort` install okf, pass every
# check, and then fail on the run that finally used it.
OKF_REQUIRED_TOOLS=(bash git sha256sum awk sed sort rg jq)

# Needed by Tier B alone, which is the only part of okf that speaks HTTP. Its
# absence degrades okf to Tier A rather than breaking it, so it is required
# only of the invocations that would use it — `okf list` on a machine without
# curl is a perfectly good okf.
#
# Deliberately not announced on the runs it does not affect: a warning printed
# by every `okf list` and every `okf --help` is noise on the many invocations
# that are working perfectly, and stderr is where a caller's pipeline reads its
# errors. What SPEC.md §3 asks be said about degradation is said on the one run
# that is degraded, by the subcommand that cannot proceed without it.
OKF_TIER_B_TOOLS=(curl)

# The subcommands that actually reach for those tools. Not the same thing as
# the Tier B subcommands, and the difference matters: SPEC.md §9 has `chunk`
# split a concept body into JSON locally, and only Qdrant — which is to say
# embed and search — go over REST. Demanding curl of `okf chunk` would refuse
# a command that was never going to need it.
#
# Every name here is also in OKF_SUBCOMMANDS, and tests/toolkit.sh checks that,
# that the help still calls each of them Tier B, and that the Tier B
# subcommands left out of this list are not asked for curl.
OKF_HTTP_SUBCOMMANDS=(embed search)

have_tool() { # $1 = command name
  # bash is satisfied by the interpreter already running this script rather
  # than by a PATH lookup: an environment that got as far as this function has
  # bash, whether or not PATH happens to mention it, and reporting it missing
  # there would be a lie the caller cannot act on.
  if [ "$1" = bash ] && [ -n "${BASH_VERSION:-}" ]; then
    return 0
  fi
  command -v -- "$1" > /dev/null 2>&1
}

# Exits 1 naming every one of the given tools that is not installed, all on one
# line: someone who has to install three things wants all three now, not one
# per re-run. Returns 0 when they are all there.
require_tools() { # $1 = trailing clause for the message, may be empty; $2.. = tools
  local why="$1"
  shift

  # The missing ones are accumulated as a string rather than an array: an empty
  # array expanded under `set -u` is an unbound variable on bash 3.2, which is
  # still what macOS ships, and empty is the case on every healthy run.
  local missing="" count=0 tool
  for tool in "$@"; do
    if ! have_tool "$tool"; then
      missing="${missing:+$missing, }$tool"
      count=$((count + 1))
    fi
  done
  [ -n "$missing" ] || return 0

  local noun="tool"
  if [ "$count" -gt 1 ]; then
    noun="tools"
  fi
  die "missing required $noun: $missing$why"
}

# SPEC.md §3's preflight, run on every invocation ahead of both help and
# dispatch — a subcommand that dies halfway through for want of rg has already
# half-written the bundle, and there is no point printing help describing
# subcommands that would every one of them fail.
#
# Takes no arguments on purpose. What it checks does not depend on what was
# asked for, so the SPEC.md §7 global flags cannot throw it off: `okf -C
# some/repo list` preflights exactly as `okf list` does, and does so before
# anything looks at -C's directory.
preflight() {
  require_tools "" "${OKF_REQUIRED_TOOLS[@]}"
}

# The Tier B half of the same check, for the tools SPEC.md §3 needs only there.
# Called from dispatch rather than from main, because that is where the
# subcommand is a name that was matched against OKF_SUBCOMMANDS rather than
# whatever happened to be the first argument — which, with -C DIR and --config
# PATH in the language, is as likely to be a flag as a subcommand.
http_preflight() { # $1 = the subcommand being dispatched, $2.. = its arguments
  local sub="$1" name arg
  shift
  for name in "${OKF_HTTP_SUBCOMMANDS[@]}"; do
    [ "$sub" = "$name" ] || continue

    # SPEC.md §9's one exception: `okf search --hyde-prompt` prints a prompt
    # for the slash command to answer and exits, reaching neither Qdrant nor an
    # embedding endpoint. Refusing that one for want of curl would be the same
    # mistake as demanding it of `okf chunk`. The flag is looked for anywhere
    # in the arguments, since it may as easily follow the query as precede it —
    # but not past a `--`, after which the same word is a query that happens to
    # look like a flag, and that query does have to reach Qdrant.
    if [ "$sub" = search ]; then
      for arg in ${1+"$@"}; do
        if [ "$arg" = -- ]; then
          break
        fi
        if [ "$arg" = --hyde-prompt ]; then
          return 0
        fi
      done
    fi
    # Says why curl is being demanded of `okf search` when `okf list` never
    # mentions it. Without that, the line reads as okf having grown a new
    # requirement rather than as these two subcommands needing something the
    # rest of okf does not.
    local subs="${OKF_HTTP_SUBCOMMANDS[*]}"
    require_tools " (needed only by ${subs// /, }, which reach Qdrant over HTTP)" \
      "${OKF_TIER_B_TOOLS[@]}"
    return 0
  done
  return 0
}

# ---------------------------------------------------------------------------
# Global flags (SPEC.md §7)
# ---------------------------------------------------------------------------

# The two things every subcommand needs before it can resolve a single path:
# where the repo root is, and which settings file describes it. Filled in by
# parse_globals ahead of dispatch, so a subcommand reads these rather than
# reaching for $PWD or the string "okf.json" on its own — the one place -C and
# --config would otherwise have to be honoured ten times over.
OKF_ROOT=""
OKF_CONFIG=""

# Whether --config named that path or it is SPEC.md §7's default. The two are
# the same string to everything downstream but not the same request: SPEC.md §6
# says every field defaults if absent, so a repo with no okf.json is a repo
# using the defaults, while a --config pointing at a file that is not there is a
# caller who meant a particular file and mistyped it. Only the second is an
# error, and nothing but this flag can tell them apart.
OKF_CONFIG_GIVEN=0

# SPEC.md §7's default, `./okf.json`, and SPEC.md §6's "okf.json (repo root)":
# the same file named twice. Relative to the root, so -C moves it too.
OKF_CONFIG_DEFAULT="okf.json"

# What is left of the command line once the global flags are taken out of it —
# the subcommand and its own arguments, in their original order.
OKF_ARGV=()

# Reads the SPEC.md §7 global flags out of the whole command line and leaves
# the rest in OKF_ARGV.
#
# Scanned across the entire line rather than only its head, because SPEC.md §7
# says *every subcommand* accepts these two: `okf check -C ../other` is as
# valid as `okf -C ../other check`. Doing it here, once, is also what keeps
# them out of every future subcommand's own argument parser.
#
# Both values are resolved after the whole line has been read, so the flags are
# order-independent: `okf --config ci.json -C repo list` and `okf -C repo
# --config ci.json list` are the same invocation. Repeating either one is an
# error rather than a last-wins race, because a silently ignored -C is a run
# against the wrong repository.
parse_globals() { # $1.. = the command line, minus the program name
  local dir="" config="" seen_dir=0 seen_config=0 flag
  local -a rest=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # Past `--` the same word is an argument and not a flag of ours,
        # however much it looks like one.
        #
        # Which side of the subcommand it falls on decides whose marker it is.
        # Ahead of the subcommand there is nothing yet for it to belong to, so
        # it is this parser's — consumed, leaving `okf -- list` to run list
        # rather than to look for a subcommand called `--`. After it, it is the
        # subcommand's own end-of-flags marker — `okf search -- --hyde-prompt`
        # is a query that begins with a dash — and is passed along untouched.
        if [ "${#rest[@]}" -eq 0 ]; then
          shift
        fi
        rest+=(${1+"$@"})
        break
        ;;
      -C | --config)
        flag="$1"
        shift
        # An option whose value is missing swallows whatever follows it, and
        # what follows it here is usually the subcommand: `okf -C list` would
        # otherwise run against a directory named "list", or against no
        # subcommand at all.
        [ $# -gt 0 ] || die "$flag needs an argument"
        # A value that is itself a flag is the same slip one argument later:
        # `okf check --config --strict` is a --config whose path was left out,
        # and taking --strict for a filename loses the flag and reads a config
        # that is not there. A file whose name really does begin with a dash is
        # reachable as ./-name, which is how every other tool spells it too.
        case "$1" in
          -*)
            die "$flag needs an argument, but the next word is a flag: $1" \
              "spell it ./$1 if that really is the name"
            ;;
        esac
        if [ "$flag" = -C ]; then
          [ "$seen_dir" -eq 0 ] || die "-C given more than once"
          seen_dir=1
          dir="$1"
        else
          [ "$seen_config" -eq 0 ] || die "--config given more than once"
          # `okf --config list` is a --config that lost its path, not a request
          # to read settings from a file called "list". -C catches the same
          # slip for free, because no such directory exists; --config would
          # otherwise take the subcommand, find nothing left to run, and answer
          # a typo with a page of help.
          local known
          for known in "${OKF_SUBCOMMANDS[@]}"; do
            [ "$1" = "$known" ] || continue
            die "--config needs a path, but was given the subcommand: $1" \
              "spell it ./$1 if that really is the settings file"
          done
          seen_config=1
          config="$1"
        fi
        ;;
      # `--config=PATH` is accepted because it is what anyone used to the GNU
      # tools will type, and left to fall through it would be an okf.json
      # silently not read. Its short counterpart `-CDIR` is deliberately *not*
      # accepted: SPEC.md §7 spells the flag `-C DIR`, and two subcommands take
      # free-form text — `okf search <query>`, `okf fanin <Name>` — which a
      # scan that glued -C to whatever followed it would quietly eat. Left
      # alone, `okf search -Csrc` searches for "-Csrc", and `okf -Csrc list`
      # is rejected by name rather than acted on.
      --config=*)
        [ "$seen_config" -eq 0 ] || die "--config given more than once"
        seen_config=1
        config="${1#--config=}"
        ;;
      *)
        rest+=("$1")
        ;;
    esac
    shift
  done

  if [ "$seen_dir" -eq 1 ]; then
    [ -n "$dir" ] || die "-C needs a directory, not an empty argument"
    # Checked here rather than left to the cd below, so the message names -C
    # and the directory the caller typed instead of reporting a failure from
    # somewhere in the middle of a subcommand.
    [ -d "$dir" ] || die "-C: no such directory: $dir"
    # Made absolute now, while the process is still where the caller invoked
    # it: a relative -C is relative to that directory and to nothing else, and
    # a root that is still relative once entered would resolve differently for
    # any subcommand that itself changes directory.
    # CDPATH is cleared for the cd, not inherited: with it set, a relative -C
    # is looked up along it before the current directory, so `okf -C src` would
    # silently run against someone else's src — and cd would echo the directory
    # it picked into this command substitution on top of it.
    #
    # cd's own diagnostic is silenced for the same reason: it names a line
    # number inside this script, and arrives ahead of the line below that
    # actually says which flag and which directory the caller has to do
    # something about.
    OKF_ROOT="$(CDPATH= cd -- "$dir" 2> /dev/null && pwd)" \
      || die "-C: cannot enter directory: $dir"
  else
    OKF_ROOT="$PWD"
  fi

  # An explicit empty path is a mistake — `--config ""` — and not a request for
  # the default, so it is caught before the resolution below turns it into one.
  if [ "$seen_config" -eq 1 ] && [ -z "$config" ]; then
    die "--config needs a path, not an empty argument"
  fi

  OKF_CONFIG_GIVEN="$seen_config"

  case "$config" in
    "")
      # Not given. SPEC.md §7's default, which is the root's okf.json.
      OKF_CONFIG="$OKF_ROOT/$OKF_CONFIG_DEFAULT"
      ;;
    /*)
      OKF_CONFIG="$config"
      ;;
    *)
      # Relative to the root, not to the caller's directory. -C sets what `.`
      # means for the run — the default config is `./okf.json` in the root — so
      # `okf -C ../other --config okf.ci.json` reads the other repo's CI
      # config, which is the one a caller pairing the two flags means. An
      # absolute path, handled above, is the way to point somewhere else.
      OKF_CONFIG="$OKF_ROOT/$config"
      ;;
  esac

  # ${rest[@]+"..."} rather than "${rest[@]}": an empty array expanded under
  # `set -u` is an unbound variable on bash 3.2, which is still what macOS
  # ships, and empty is exactly the case of a bare `okf -C somewhere`.
  OKF_ARGV=(${rest[@]+"${rest[@]}"})
}

# Clears the git environment variables that would have git answer for a
# different repository than the one okf was pointed at.
#
# `git ls-files` reads GIT_DIR, GIT_WORK_TREE and GIT_INDEX_FILE ahead of the
# directory it is run in, so those three outrank both -C and the caller's own
# cwd. They are not exotic: git exports them to every hook it runs, and to
# everything under `git rebase --exec` — which is exactly where SPEC.md §11 has
# bin/ralph refreshing concepts as part of a commit. An okf that inherited them
# would list another repository's files, and the failure would be silent, since
# none of those paths exists under the real root and what comes out is an empty
# listing exiting 0.
#
# Cleared for the same reason CDPATH is cleared at every cd here, and ripgrep is
# run with --no-config: what okf answers has to depend on the repository it was
# pointed at, and on nothing else that happens to be in the environment.
isolate_git_environment() {
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_CEILING_DIRECTORIES \
    GIT_NAMESPACE
}

# Enters the root, so that every relative path a subcommand touches — and every
# `git ls-files` it runs — resolves against it without that subcommand having
# to remember to. Split from parse_globals so the resolution can be reasoned
# about, and tested, without a process changing directory underneath it.
enter_root() {
  # CDPATH cleared as above. OKF_ROOT is absolute by the time it gets here, so
  # nothing should consult CDPATH at all — but a cd that reads it is one
  # relative path away from entering the wrong tree, and it also prints where
  # it went, which nothing calling this expects on stdout.
  CDPATH= cd -- "$OKF_ROOT" || die "cannot enter the repo root: $OKF_ROOT"
}

# A path as the caller would have typed it: relative to the root when it is
# inside it, absolute when it is not.
#
# Every path okf holds is absolute — parse_globals makes them so, and enter_root
# then moves the process — but "okf.json already exists" is a better line than
# that same sentence with forty characters of temp directory in front of the one
# word that matters. Absolute is kept for anything outside the root, where the
# path is the news: `--config /etc/okf.json` did not write in this repo at all.
display_path() { # $1 = an absolute path
  case "$1" in
    "$OKF_ROOT"/*) printf '%s\n' "${1#"$OKF_ROOT"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The same file, spelled the same way: the directory part resolved, the final
# component left exactly as given. What it is for is telling whether two paths
# okf holds are one file — `--config index.md` and `--config ./index.md` both
# name the bundle root's own index.md, and a plain string comparison sees three
# different paths there.
#
# cd and `pwd -P` rather than realpath, which is not on SPEC.md §3's list, and
# rather than `-ef`, which compares inodes and so can only answer for files
# that already exist — the interesting case here is two paths okf is about to
# create. `-P` and not a plain pwd: a symlinked directory component is exactly
# how two paths that look nothing alike turn out to name one file, and the
# logical pwd would hand back the path as typed and hide it. The final
# component is deliberately left unresolved: a symlink named by it is the link
# and not its target, which is what init_guard refuses.
#
# A directory that does not exist cannot be resolved, so the path is returned
# as it came. That is the right answer for a comparison — an unresolvable path
# is not demonstrably the same file as anything — and the write that follows
# reports the missing directory itself.
canonical_path() { # $1 = an absolute path
  local dir="${1%/*}" base="${1##*/}" resolved

  [ -n "$dir" ] || dir="/"
  # CDPATH cleared and stderr silenced for the reasons every other cd here is.
  resolved="$(CDPATH= cd -- "$dir" 2> /dev/null && pwd -P)" || {
    printf '%s\n' "$1"
    return 0
  }
  case "$resolved" in
    */) printf '%s%s\n' "$resolved" "$base" ;;
    *) printf '%s/%s\n' "$resolved" "$base" ;;
  esac
}

# ---------------------------------------------------------------------------
# Settings (SPEC.md §6)
# ---------------------------------------------------------------------------

# The effective settings for this run: SPEC.md §6's defaults with the repo's
# okf.json laid over them. Read once and kept, because several subcommands ask
# for several of its lists and each ask is a jq process.
OKF_SETTINGS=""
OKF_SETTINGS_LOADED=0

# Resolves okf.json against the defaults, per SPEC.md §6's "every field defaults
# if absent".
#
# The overlay is jq's `*`, which merges objects recursively and lets the
# right-hand side win — so a repo that sets only `bundle.include` keeps §6's
# `exclude` and `extensions`, and an `index` block, which the defaults
# deliberately have not got, arrives intact. Arrays replace rather than
# concatenate, which is what a caller narrowing `extensions` to `["java"]`
# means; a `*` that appended would leave them with all eight and no way back.
#
# OKF_DEFAULT_CONFIG is reused as the left-hand side rather than a second
# transcription of §6, so `okf init` and every later run agree on what a field
# means when it is missing — including in a repo that never ran init.
load_settings() {
  [ "$OKF_SETTINGS_LOADED" -eq 0 ] || return 0

  # `-L` as well as `-e`, so a symlink pointing at nothing is diagnosed as the
  # broken settings file it is rather than silently taken for no settings at
  # all.
  if [ -e "$OKF_CONFIG" ] || [ -L "$OKF_CONFIG" ]; then
    [ -f "$OKF_CONFIG" ] || die "$(display_path "$OKF_CONFIG") is not a regular file"
    [ -r "$OKF_CONFIG" ] || die "$(display_path "$OKF_CONFIG") is not readable"

    local merged
    # jq reads the file itself, so its parse errors name it. --slurpfile rather
    # than plain input because it makes "how many JSON values are in there?"
    # answerable: an empty okf.json and a file with two objects in it are both
    # mistakes, and both would otherwise pass as something.
    merged="$(jq -n --argjson defaults "$OKF_DEFAULT_CONFIG" \
      --slurpfile given "$OKF_CONFIG" '
        if ($given | length) != 1 then
          error("expected one JSON object, found "
            + (($given | length) | tostring) + " JSON values")
        elif ($given[0] | type) != "object" then
          error("expected a JSON object, found " + ($given[0] | type))
        else
          ($defaults * $given[0]) as $merged
          | if ($merged.bundle | type) != "object" then
              error("bundle must be a JSON object, found " + ($merged.bundle | type))
            else $merged end
        end' 2>&1)" \
      || die "cannot read settings from $(display_path "$OKF_CONFIG")" "$merged"
    OKF_SETTINGS="$merged"
  elif [ "$OKF_CONFIG_GIVEN" -eq 1 ]; then
    # See OKF_CONFIG_GIVEN: a path the caller named and okf cannot find is a
    # typo, not a request for the defaults.
    die "--config: no such file: $(display_path "$OKF_CONFIG")"
  else
    OKF_SETTINGS="$OKF_DEFAULT_CONFIG"
  fi

  # SPEC.md §6 gives `bundle.root` a default of `.` and says nothing else about
  # it, and nothing in okf acts on any other value: the bundle root is the repo
  # root, which is what -C DIR moves. A setting nothing reads is worse than one
  # that is not there — the caller has said where the bundle is and been ignored
  # — so a root that is anything but the default is refused rather than quietly
  # treated as the default. Whichever checklist item teaches okf to honour it
  # replaces this.
  # stderr to /dev/null: the merge above has already settled that `.bundle` is
  # an object, so there is nothing left here for jq to complain about, and a
  # diagnostic naming `<stdin>` would arrive ahead of okf's own line if there
  # ever were.
  local root
  root="$(printf '%s\n' "$OKF_SETTINGS" \
    | jq -r '.bundle.root // "." | tostring' 2> /dev/null)" \
    || die "cannot read bundle.root from $(display_path "$OKF_CONFIG")"
  case "$root" in
    . | ./ | "") ;;
    *)
      die "bundle.root is set to \"$root\" in $(display_path "$OKF_CONFIG")" \
        "okf does not act on it yet: the bundle root is the repo root" \
        "use -C DIR to run against another root, and set bundle.root back to \".\""
      ;;
  esac

  OKF_SETTINGS_LOADED=1
}

# One of SPEC.md §6's lists of strings, one per line.
#
# load_settings has already laid §6's defaults underneath, so every list §6
# defines is there by the time this runs and a `null` cannot mean "not
# configured" — it can only be one somebody wrote, and jq's `*` merge lets it
# override the default it was written over. `{"exclude": null}` would otherwise
# read as an empty exclude list and quietly put the whole build directory in
# scope, which is the one wrong shape a type check would let through. Refused by
# name instead, alongside every other wrong shape; an exclude list of nothing is
# spelled `[]`.
#
# An empty string in one of these lists is refused here too, and refused here
# rather than in the caller: by the time the caller reads this back, an empty
# list and a list holding one empty string are both a single blank line and
# cannot be told apart. Dropped as unusable, `"include": [""]` would leave no
# include patterns at all, which reads as no narrowing — and so would put the
# whole repository in scope for a setting nobody could act on.
#
# Newline-separated rather than NUL-separated, and a value containing a newline
# is refused rather than supported: these are globs and file extensions, a
# newline in one could only be a mistake, and every caller reads the result back
# through a command substitution, which drops NUL bytes.
#
# The key path arrives as jq's own $ARGS.positional rather than interpolated
# into the program text, so nothing here has to reason about quoting.
settings_strings() { # $1.. = the path to a list, e.g. `bundle include`
  load_settings

  local label="" part
  for part in "$@"; do
    label="$label.$part"
  done

  local out
  out="$(printf '%s\n' "$OKF_SETTINGS" | jq -r '
      getpath($ARGS.positional) as $list
      | if ($list | type) != "array" then
          error("must be a list, found " + ($list | type))
        else $list end
      | map(
          if type != "string" then
            error("must hold strings, found " + type)
          elif . == "" then
            error("must not hold an empty value")
          elif contains([10] | implode) then
            error("must not hold a value with a newline in it")
          else . end)
      | .[]' --args "$@" 2>&1)" \
    || die "$(display_path "$OKF_CONFIG"): $label ${out#jq: error*: }"

  printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Scope (SPEC.md §5)
# ---------------------------------------------------------------------------

# SPEC.md §5's last exclusion: "files carrying a `@Generated`-style annotation".
#
# What has to be told apart here is a file a generator wrote from a file that
# merely says the word. Four branches, each shaped by how one family of language
# actually writes the marker, and each narrow enough that prose does not fit:
#
#   `^@Generated(`     the annotation on the file's top-level type, which in
#                      every language that has annotations sits in column 0 —
#                      bare, or package-qualified as `@javax.annotation.Generated`.
#   `^ * @generated`   the same fact inside a comment, at any indentation: the
#                      docblock convention JavaScript and Flow use puts it on a
#                      javadoc continuation line, and `#` languages put it in a
#                      header comment.
#   Go's header        which has no annotations and so states it in the only
#                      form it has, in a shape its own tooling defines exactly.
#
# Every branch that anchors on the end of a line allows a `\r` before it, so a
# repository checked out with CRLF line endings is scanned the same as one
# without: without that, a generated file would read as hand-written on Windows
# and on any checkout configured for it.
#
# Three narrowings do the work of telling a marker from a sentence, and each one
# is a hand-written file that would otherwise be dropped from the bundle in
# silence:
#
#   * Column 0, for the annotation form. A member annotation is indented and a
#     type annotation is not, so a hand-written class carrying one generated
#     `@Generated("lombok")` accessor stays — losing a whole file to one
#     generated method would lose exactly the code most worth documenting.
#   * Nothing after the marker but its own argument list or the end of the line.
#     Column 0 alone cannot tell an annotation from prose in a language whose
#     string literals reach it: a Python docstring opening a line with
#     "@generated is what the codegen writes" is a sentence. This is also what
#     keeps `@NotGenerated(...)` and `@regenerated` out — the name must be
#     `Generated` itself, or a qualified path ending in it, and not merely end
#     with the letters.
#   * Lower case, for the comment form. `@generated` in a comment is the
#     docblock convention, whereas `@Generated` is the name of a Java annotation
#     — and Java writes that annotation in the code, never in a comment. So a
#     comment naming it, as in `// @Generated marks the classes our codegen
#     owns`, is a sentence about the annotation and not a marker.
#   * Nothing after the comment form either, unless it closes the comment —
#     `/* @generated */` is the whole of one — or it is the provenance a
#     generator stamps beside it: `by`, `from`, `with`, or Facebook's
#     `SignedSource`. That list is short because the real conventions are, and
#     it is what separates `# @generated by codegen` from `# @generated is the
#     marker our codegen writes` — the same shape, one a marker and one a
#     sentence about markers. A generator that words its provenance some other
#     way is missed, and a generated file left in the listing is at least a
#     visible mistake; a hand-written file dropped from the bundle is not.
#
# JPA's `@GeneratedValue`, an ordinary field annotation on hand-written code, is
# kept out by all of them at once.
#
# Deliberately no bare "DO NOT EDIT": that phrase turns up in hand-written
# configuration and in comments about generated files, and dropping a source
# from the bundle is a silent loss, so the marker has to be one nothing but a
# generator writes.
#
# Written without a repeated group — `[A-Za-z_.]*` rather than
# `([A-Za-z_][A-Za-z0-9_]*\.)*` — because ripgrep 14.1.0 silently stops matching
# a repeated group once a second pattern is in play, and this pattern has four.
OKF_GENERATED_MARKER='^@[Gg]enerated(\(|\r?$)|^@[A-Za-z_.]*\.[Gg]enerated(\(|\r?$)|^[[:space:]]*[/#*]+[[:space:]]*@generated([[:space:]]+(by|from|with|SignedSource)\b|[[:space:]]*\*/|\(|\r?$)|^//[[:space:]]*Code generated .* DO NOT EDIT\.\r?$'

# How many paths go to ripgrep at once. One process for the whole repo would be
# ideal and one per file would be slow; a batch keeps the argument list well
# inside any ARG_MAX while leaving a normal repo at a single invocation.
OKF_GENERATED_BATCH=400

# The in-scope sources, bundle-relative and sorted, as `load_in_scope` left them.
OKF_IN_SCOPE=()

# The repo's concept files, bundle-relative and sorted, as `load_concepts` left
# them.
OKF_CONCEPTS=()

# The repo's tracked paths, bundle-relative and sorted, as `load_tracked_paths`
# left them.
OKF_TRACKED=()

# The file extensions in scope, as `load_bundle_globs` read them from the
# settings.
OKF_EXTENSIONS=()

# SPEC.md §6's `include` and `exclude`, compiled to the anchored regular
# expressions matches_any wants, as `load_bundle_globs` left them.
OKF_INCLUDE_RES=()
OKF_EXCLUDE_RES=()

# `git ls-files` is how SPEC.md §5's first exclusion — "anything gitignored" —
# is honoured, so a bundle root outside a work tree is not a scope okf can
# answer for. Said here rather than left to git, whose own line is about a
# missing .git directory and does not mention okf or the root it was pointed at.
require_git_repo() {
  local inside
  inside="$(git rev-parse --is-inside-work-tree 2> /dev/null)" || inside=""
  [ "$inside" = "true" ] || die "not inside a git work tree: $OKF_ROOT" \
    "okf reads the repo's scope from git ls-files, which needs one"
}

# Compiles SPEC.md §6's `include` and `exclude` into the anchored regular
# expressions matches_any wants, and reads `extensions` alongside them.
#
# Its own function rather than the head of load_in_scope because the orphan
# listing needs the same bundle boundary: it asks these globs about a concept's
# `resource`, which is a source path like any other. Transcribed a second time,
# the two listings could disagree about the edges of one bundle — `okf list` and
# `okf list --orphans` answering for different repositories — and the
# disagreement would surface only as a concept nobody could account for.
load_bundle_globs() {
  load_settings

  # Assigned on their own lines, not as `local x="$(...)"`: `local` returns
  # success whatever the command substitution did, which would swallow both
  # `set -e` and the status of a settings_strings that died inside the subshell
  # having already printed why.
  local includes excludes extensions
  includes="$(settings_strings bundle include)" || exit 1
  excludes="$(settings_strings bundle exclude)" || exit 1
  extensions="$(settings_strings bundle extensions)" || exit 1

  OKF_INCLUDE_RES=()
  OKF_EXCLUDE_RES=()
  local pattern
  # The blank line is the empty list, not an empty pattern: settings_strings
  # refuses an empty string outright, and a here-string of nothing is still one
  # line. Past it, bundle_pattern always answers with a pattern — the bundle
  # root comes back as `**` rather than as nothing — so there is nothing else
  # here to skip.
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    check_supported_glob "$pattern" .bundle.include
    OKF_INCLUDE_RES+=("$(glob_regex "$(bundle_pattern "$pattern")")")
  done <<< "$includes"
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    check_supported_glob "$pattern" .bundle.exclude
    OKF_EXCLUDE_RES+=("$(glob_regex "$(bundle_pattern "$pattern")")")
  done <<< "$excludes"

  OKF_EXTENSIONS=()
  local ext
  while IFS= read -r ext; do
    [ -n "$ext" ] || continue
    # A settings file that spells them `.java` means the same thing as `java`.
    OKF_EXTENSIONS+=("${ext#.}")
  done <<< "$extensions"
}

# Whether a bundle-relative path is inside the bundle SPEC.md §6's `include` and
# `exclude` describe. `exclude` is asked first, because it is the one that can
# take a path back out of an `include` that reached it.
in_bundle_globs() { # $1 = a bundle-relative path
  if matches_any "$1" ${OKF_EXCLUDE_RES[@]+"${OKF_EXCLUDE_RES[@]}"}; then
    return 1
  fi
  # An include list that narrows nothing is no narrowing rather than no files:
  # `include` is the filter, and with nothing to filter by there is nothing
  # filtered out.
  if [ "${#OKF_INCLUDE_RES[@]}" -gt 0 ]; then
    matches_any "$1" "${OKF_INCLUDE_RES[@]}" || return 1
  fi
  return 0
}

# Fills OKF_TRACKED with every path `git ls-files` names, in git's order and
# without git's repeats.
#
# No pathspec: the whole index comes out here and each caller narrows it
# afterwards, because `include` and `exclude` have to be matched by one matcher
# and git's cannot be the one — see glob_regex.
load_tracked_paths() {
  local -a records=()
  local record
  while IFS= read -r -d '' record; do
    records+=("$record")
  done < <(
    # A process substitution's exit status is invisible to the shell reading it,
    # so git's is carried out as one more NUL record. Without it, a git that
    # failed — an unreadable index, a repository in a state it will not answer
    # for — would be an empty listing reported as a repo with nothing in scope.
    # `set +e` because the errexit inherited here would otherwise take the
    # subshell down before the status could be written.
    set +e
    git ls-files -z
    printf 'status:%s\0' "$?"
  )

  local count="${#records[@]}"
  [ "$count" -gt 0 ] \
    || die "git ls-files wrote nothing at all, not even its exit status"
  local status="${records[$((count - 1))]}"
  unset "records[$((count - 1))]"
  [ "$status" = "status:0" ] \
    || die "git ls-files failed in $OKF_ROOT — see its message above"

  OKF_TRACKED=()
  local previous="" path
  for path in ${records[@]+"${records[@]}"}; do
    # `git ls-files` prints an unmerged path once per stage, so a repo stopped
    # in the middle of a conflicted merge names the same file three times. The
    # listing is sorted, so the repeats are adjacent.
    [ "$path" != "$previous" ] || continue
    previous="$path"
    OKF_TRACKED+=("$path")
  done
}

# Refuses the gitignore constructs glob_regex does not implement, rather than
# letting them through to be escaped into literals that can never match. Every
# other setting of the wrong shape is refused by name; a `[Gg]` that quietly
# excluded nothing at all would be the one that was not.
check_supported_glob() { # $1 = a glob from okf.json, $2 = the key it came from
  local where
  where="$(display_path "$OKF_CONFIG"): $2"
  case "$1" in
    '!'*)
      die "$where: a leading ! is gitignore's negation, which okf has not got: $1" \
        "an exclude is undone by narrowing include, not by negating the exclude"
      ;;
    *'['* | *']'* | *'\'*)
      die "$where: okf's globs have no character classes and no escapes: $1" \
        "its wildcards are **, * and ?"
      ;;
    # The whole bundle, however it is spelled. Named here so the segment check
    # below does not read the `.` in it as a segment going nowhere.
    . | ./ | /) return 0 ;;
  esac

  # A `..` names something outside the bundle and a bare `.` names a step that
  # goes nowhere, and okf matches the paths git lists — which have neither in
  # them, so either one is a pattern that can only ever match nothing. Wrapped
  # in separators so the test is on whole segments: a directory called `..stuff`
  # is a perfectly ordinary name.
  local segments="/${1#./}/"
  case "$segments" in
    */../* | */./*)
      die "$where: a glob cannot contain a . or a .. segment: $1" \
        "okf matches the paths under the bundle root that git lists, and they have neither"
      ;;
  esac
}

# One of SPEC.md §6's globs, spelled the one way the matcher below expects, or
# nothing when it says nothing.
#
# Only what is genuinely redundant is folded away: a leading `./`, which says
# nothing a bare name does not, and a run of trailing separators, which is one
# separator. The leading `/` and the single trailing `/` are both left in place
# and both mean something to glob_regex — anchored to the bundle root, and names
# a directory. A leading `/` is SPEC.md §4's bundle-absolute spelling and
# gitignore's anchor at once, and the two say the same thing: measured from the
# bundle root and from nowhere else.
#
# A pattern that says only that — `.`, `/`, `./` — is the whole bundle, and
# comes back as the `**` that says so. See the case at the end for why that is
# not the same as dropping it.
bundle_pattern() { # $1 = a glob from okf.json
  local pattern="$1"

  # `./x` becomes `/x` rather than `x`: both spellings say "x at the bundle
  # root", and it is the leading `/` that carries that here. Stripped to a bare
  # `x`, the pattern would be one with no `/` in it, which glob_regex reads as
  # matching at any depth — `./src` would start matching `vendor/src/`.
  #
  # `./?*` and not `./*`: a bare `./` is the bundle root itself, and stripping
  # it to nothing would lose that rather than shorten it.
  local anchor=""
  while :; do
    case "$pattern" in
      ./?*)
        pattern="${pattern#./}"
        anchor="/"
        ;;
      *) break ;;
    esac
  done
  pattern="$anchor$pattern"

  # A run of separators is one separator, wherever it falls: `src//**` is
  # `src/**` written twice over, and left alone it compiles to a regular
  # expression with a `//` in it that no path can match — an include that
  # silently selects nothing.
  while :; do
    case "$pattern" in
      *//*) pattern="${pattern%%//*}/${pattern#*//}" ;;
      *) break ;;
    esac
  done

  # The bundle root, however it is spelled, is the whole bundle — and is written
  # out as such rather than dropped. Dropped, it would read as "narrows
  # nothing", which is the right answer for `include` and the exact opposite of
  # it for `exclude`: `"exclude": ["/"]` means every file, not no files.
  case "$pattern" in
    . | / | ./) pattern="**" ;;
  esac

  printf '%s\n' "$pattern"
}

# One of SPEC.md §6's globs as an anchored extended regular expression, which is
# what bash's `=~` matches paths with.
#
# The dialect is gitignore's, because that is the one every `exclude` glob in
# §6's defaults is written in and the one anybody editing okf.json will expect:
#
#   `**`      a whole path component of nothing but asterisks: any run of
#             characters, `/` included
#   `**/`     the same at the head of a component: any number of directories,
#             none among them
#   `*`       any run of characters within a single path component — and so is
#             a `**` that is not a whole component of its own, which is what
#             makes `src/**.ts` the same pattern as `src/*.ts`
#   `?`       one character, but not `/`
#   anything else, literally
#
# Gitignore's remaining constructs — `!` negation, `[...]` classes, backslash
# escapes — are not implemented, and check_supported_glob refuses a pattern that
# uses one rather than letting this function escape it into a literal nobody
# meant and nothing matches.
#
# And gitignore's two rules about the separator, which are what decide where a
# pattern is measured from and how far down it reaches:
#
#   * A `/` anywhere but at the end anchors the pattern to the bundle root, and
#     a leading `/` anchors it while saying nothing else. A pattern with no `/`
#     in it — `target`, `*.min.js` — matches at any depth, which is what makes
#     the obvious `"exclude": ["target"]` reach `src/target/` and not only a
#     `target/` sitting at the root.
#   * Every pattern matches what is under it as well as itself, because okf only
#     ever matches file paths and a pattern naming a directory would otherwise
#     match nothing at all: `git ls-files` prints no directories for `vendor` or
#     `**/vendor/` to match. A trailing `/` says the pattern names a directory,
#     and then it is only the contents that match.
#
# Written here rather than handed to `git ls-files` as a `:(glob,exclude)`
# pathspec, which is where this started: git derives a common directory prefix
# from the positive pathspecs and matches the negative ones against paths with
# that prefix already taken off, so `**/vendor/**` stops excluding as soon as
# every include shares one directory — and a second exclude that matches nothing
# at all can empty the listing outright (git 2.43). Matching both lists here
# instead also means include and exclude cannot disagree about what a pattern
# means, which two matchers eventually would.
glob_regex() { # $1 = a normalised glob
  local rest="$1" out tail='(/.*)?$' ch anchored=0

  case "$rest" in
    */)
      rest="${rest%/}"
      tail='/.*$'
      ;;
  esac

  case "$rest" in
    /*)
      anchored=1
      rest="${rest#/}"
      ;;
    */*) anchored=1 ;;
  esac

  if [ "$anchored" -eq 1 ]; then
    out="^"
  else
    out="^(.*/)?"
  fi

  # Whether the next character starts a whole path component, which is what
  # decides between gitignore's two readings of `**`: a component that is
  # nothing but `**` crosses separators, and asterisks anywhere else are a
  # plain `*` however many of them there are. `src/**.ts` is `src/*.ts`.
  local at_component=1

  while [ -n "$rest" ]; do
    case "$rest" in
      '**/'*)
        if [ "$at_component" -eq 1 ]; then
          out="$out(.*/)?"
          rest="${rest#'**/'}"
          at_component=1
          continue
        fi
        ;;
      '**')
        if [ "$at_component" -eq 1 ]; then
          out="$out.*"
          rest=""
          continue
        fi
        ;;
    esac

    case "$rest" in
      '*'*)
        # A run of asterisks that is not a whole component: one `*`, per
        # gitignore's "other consecutive asterisks are considered regular
        # asterisks".
        while :; do
          case "$rest" in
            '*'*) rest="${rest#'*'}" ;;
            *) break ;;
          esac
        done
        out="$out[^/]*"
        at_component=0
        ;;
      '?'*)
        out="$out[^/]"
        rest="${rest#?}"
        at_component=0
        ;;
      /*)
        out="$out/"
        rest="${rest#/}"
        at_component=1
        ;;
      *)
        # The first character, taken by removing everything after it. Only the
        # extended regular expression metacharacters are escaped: a backslash
        # before an ordinary character is undefined in POSIX ERE, so escaping
        # everything would be the less safe of the two. `*`, `?` and `/` are not
        # on the list because the branches above have already taken every one of
        # them.
        ch="${rest%"${rest#?}"}"
        case "$ch" in
          '\' | '.' | '[' | ']' | '(' | ')' | '{' | '}' | '+' | '|' | '^' | '$')
            out="$out\\$ch"
            ;;
          *) out="$out$ch" ;;
        esac
        rest="${rest#?}"
        at_component=0
        ;;
    esac
  done

  printf '%s%s\n' "$out" "$tail"
}

# Whether a path matches any of the given anchored regular expressions. No
# expressions is no match, which is what leaves an empty `exclude` excluding
# nothing.
matches_any() { # $1 = a bundle-relative path, $2.. = anchored regular expressions
  local path="$1" expression
  shift
  # ${1+"$@"} rather than "$@": under `set -u` an empty "$@" is an unbound
  # variable on bash 3.2, which is still what macOS ships, and empty is exactly
  # the case of an `exclude` list with nothing in it.
  for expression in ${1+"$@"}; do
    # Unquoted on the right, which is what makes bash read it as a pattern
    # rather than as the literal text of one.
    if [[ $path =~ $expression ]]; then
      return 0
    fi
  done
  return 1
}

# Whether a path's extension is one of SPEC.md §6's `extensions`.
#
# Matched exactly as written, not case-folded: the settings say `java`, every
# toolchain in §6's default list writes its extension in lower case, and folding
# would need a tool SPEC.md §3 does not list. A project whose sources are `.CBL`
# spells it `CBL` in okf.json.
#
# An empty list is no restriction rather than no files: `extensions` narrows the
# listing, and there is nothing to narrow by. A file whose name has no dot in it
# past a leading one has no extension at all, so `.gitignore` is not a file with
# a `gitignore` extension.
in_scope_extension() { # $1 = a bundle-relative path
  [ "${#OKF_EXTENSIONS[@]}" -gt 0 ] || return 0

  local name="${1##*/}" ext want
  name="${name#.}"
  case "$name" in
    *.*) ext="${name##*.}" ;;
    *) return 1 ;;
  esac

  for want in "${OKF_EXTENSIONS[@]}"; do
    [ "$ext" = "$want" ] || continue
    return 0
  done
  return 1
}

# Appends the given paths to OKF_IN_SCOPE, in the order given, minus the ones
# carrying a generated marker.
#
# One batch, one ripgrep, and the membership test that follows is over that
# batch alone. That bound is the point of batching, not the argument list: the
# test is a substring search per path over a string holding the batch's
# generated paths, so what it costs depends on OKF_GENERATED_BATCH and not on
# how big the repository is. Over the whole repository at once it would be
# quadratic in the file count, and worst exactly where it matters — a repo that
# is mostly generated code has both the most paths to test and the longest
# string to test them against.
#
# The paths are joined by newlines and each wrapped in them, so the test is on
# whole paths and not on any path that ends in another. That is exact for every
# path without a newline in it; one that has a newline is legal, vanishingly
# rare and cheap to notice, and falls back to a scan of the batch's generated
# paths rather than being matched against the wrong entry.
keep_hand_written() { # $1.. = one batch of candidate paths
  local -a generated=()
  local record
  while IFS= read -r -d '' record; do
    generated+=("$record")
  done < <(
    # ripgrep's status carried out in the stream, since a process
    # substitution's own is invisible to the shell reading it. Without it a
    # ripgrep that failed outright would hand back no generated paths at all —
    # which reads exactly like a batch with none, and would put every generated
    # file in the bundle with nothing said. `set +e` so the errexit inherited
    # here does not act on the 1 that means "nothing matched", which is the
    # ordinary answer for a hand-written repo.
    set +e
    rg --no-config --no-ignore --files-with-matches --null \
      -e "$OKF_GENERATED_MARKER" -- "$@"
    printf 'status:%s\0' "$?"
  )

  local count="${#generated[@]}"
  [ "$count" -gt 0 ] \
    || die "the generated-source scan wrote nothing at all, not even its exit status"
  local status="${generated[$((count - 1))]}"
  unset "generated[$((count - 1))]"
  case "$status" in
    # Matched, or matched nothing. Anything else is a scan that did not happen,
    # and a scan that did not happen looks exactly like a batch with no
    # generated code — so it is said rather than acted on. ripgrep's own
    # message, naming the file it could not read, has already gone to stderr.
    status:0 | status:1) ;;
    *)
      die "ripgrep could not scan for generated sources — see its message above" \
        "okf cannot tell which of these files a generator wrote, so it will not guess"
      ;;
  esac

  local newline='
'
  local blob="" joined=1
  for record in ${generated[@]+"${generated[@]}"}; do
    case "$record" in
      *"$newline"*)
        joined=0
        break
        ;;
    esac
    blob="$blob$record$newline"
  done
  blob="$newline$blob"

  local path marked
  for path in "$@"; do
    if [ "$joined" -eq 1 ]; then
      case "$blob" in
        *"$newline$path$newline"*) marked=1 ;;
        *) marked=0 ;;
      esac
    else
      marked=0
      for record in ${generated[@]+"${generated[@]}"}; do
        if [ "$record" = "$path" ]; then
          marked=1
          break
        fi
      done
    fi
    [ "$marked" -eq 0 ] || continue
    OKF_IN_SCOPE+=("$path")
  done
}

# Fills OKF_IN_SCOPE with the repo's in-scope sources: SPEC.md §5's exclusions
# applied to `git ls-files`, narrowed by SPEC.md §6's include, exclude and
# extensions.
#
# The exclusions divide up as follows. Gitignored files are absent from
# `git ls-files` to begin with — which also settles the one case where "is it
# ignored?" has two answers: a file somebody committed with `git add -f` matches
# an ignore rule and is tracked anyway, and git does not ignore it. Neither does
# okf. A file deliberately put under version control is part of what the repo
# says it is, and a repo that wants it out of the bundle as well says so in
# `exclude`, where it can be seen.
#
# Build and output directories and vendored trees
# are `exclude` globs, and nothing here hard-codes either: a list okf applied on
# top of the settings would be one no okf.json could take back out, and §6 makes
# `exclude` the place that decision is written down.
#
# That leaves one gap worth naming: §5 calls out vendored trees and §6's default
# `exclude` covers only the build and output directories — `target`, `build`,
# `node_modules`, `dist` — so a repo with a `vendor/` tree and no okf.json lists
# it. §6 is where that is settled and §6 is read-only, so the answer is a
# `**/vendor/**` in the repo's own okf.json, which is what tests/fixtures/scoped
# does.
#
# The `@Generated` scan is the one that has to read files, so it runs last, over
# what is left.
load_in_scope() {
  require_git_repo
  load_bundle_globs
  load_tracked_paths

  local -a candidates=()
  local path
  for path in ${OKF_TRACKED[@]+"${OKF_TRACKED[@]}"}; do
    # Extension first: it is the cheapest of the three and, on the repos §6's
    # defaults describe, the one that rules out the most.
    in_scope_extension "$path" || continue
    # A tracked symbolic link is a path whose content, as far as git is
    # concerned, is the target it names and not the source at the end of it.
    # Following one would put a second concept beside a file that already has
    # its own — SPEC.md §5 co-locates one concept per declared type, and a link
    # is not a second declaration — and the two would then drift apart
    # independently. A link out of the work tree is worse: what `okf check`
    # would take a sha256 of is content git does not version at all. Tested
    # before `-f`, which follows the link and would answer for its target.
    [ ! -L "$path" ] || continue
    # `git ls-files` answers from the index, which still holds a file that has
    # been deleted from the working tree and not yet staged as removed. Nothing
    # downstream of this listing can do anything with a path that is not there —
    # not the @Generated scan below, not the sha256 `okf check` will want, and
    # not the read a slash command has to do to document it.
    [ -f "$path" ] || continue
    in_bundle_globs "$path" || continue
    candidates+=("$path")
  done

  OKF_IN_SCOPE=()
  [ "${#candidates[@]}" -gt 0 ] || return 0

  # The @Generated scan, in batches: one ripgrep per batch, and each batch
  # filtered against its own results before the next one starts. Batching keeps
  # the argument list well inside any ARG_MAX, and — see keep_hand_written —
  # keeps the cost of deciding which paths came back bounded by the batch rather
  # than by the size of the repository.
  local -a batch=()
  for path in "${candidates[@]}"; do
    batch+=("$path")
    if [ "${#batch[@]}" -ge "$OKF_GENERATED_BATCH" ]; then
      keep_hand_written "${batch[@]}"
      batch=()
    fi
  done
  [ "${#batch[@]}" -eq 0 ] || keep_hand_written "${batch[@]}"
}

# ---------------------------------------------------------------------------
# Co-location (SPEC.md §5)
# ---------------------------------------------------------------------------

# SPEC.md §4's reserved OKF filenames. Neither is ever a source's concept:
# `index.md` is the directory's own document — `type: Package`, or `type:
# Codebase` at the bundle root — and `log.md` is left to OKF's own semantics and
# is never generated.
OKF_RESERVED_CONCEPT_NAMES=(index.md log.md)

# Whether a file carries a SPEC.md §4 frontmatter block: `---` on line 1, closed
# by the next line that is exactly `---`. Both ends are checked, because a file
# that opens one and never closes it is the half-written concept this is here to
# tell from a whole one.
#
# Whether the block *says* anything in particular is not asked. Which fields are
# in there is read_frontmatter's question; what is being asked here is only
# whether there is frontmatter at all, and the two are kept apart because this
# one is asked of every tracked `.md` in the repository — most of them prose
# that stops at the first line — where read_frontmatter is asked only of the
# files this has already said yes to.
has_frontmatter() { # $1 = a path to a file
  local line opened=0
  # `|| [ -n "$line" ]` so a last line with no newline after it is still read.
  while IFS= read -r line || [ -n "$line" ]; do
    # A checkout with CRLF line endings ends every line with a `\r`, and an
    # editor on Windows opens the file with a UTF-8 BOM. Neither changes what
    # the line says, and neither may turn a concept into something unrecognised
    # — a source whose concept goes unrecognised is one that never comes off
    # `okf list --missing`.
    line="${line#$'\xef\xbb\xbf'}"
    line="${line%$'\r'}"
    if [ "$opened" -eq 0 ]; then
      [ "$line" = "---" ] || return 1
      opened=1
      continue
    fi
    [ "$line" != "---" ] || return 0
  # stderr redirected before the input, and not after it: the order is the
  # order they are opened in, and a `2> /dev/null` written second is set up too
  # late to catch the shell's own complaint about the first. A concept whose
  # permissions have been taken away is answered by the source turning up in
  # `okf list --missing`, which is a line the caller can act on — not by a
  # "Permission denied" carrying a line number from inside this script.
  done 2> /dev/null < "$1"
  # Falls through for an empty file, one that opens a block it never closes, and
  # one that could not be read at all — none of them a concept.
  return 1
}

# Whether a source has the co-located concept SPEC.md §5 puts beside it:
# `UserException.java` -> `UserException.md` in the same directory. Returns 0
# when it is there, 1 when it is not. The path is bundle-relative, as everything
# out of `load_in_scope` is, and is resolved against the root okf is standing
# in.
#
# The stem is the name minus its final extension, so the concept for
# `helper.ts` is `helper.md` and not `helper.ts.md`. A name that is all
# extension — a dotfile such as `.gitignore` — keeps its whole name, because
# stripping it would leave nothing and every dotfile in a directory would then
# share the one concept `.md`.
#
# Only `<stem>.md` is looked for, never the `<stem>.<TypeName>.md` files §5
# gives a file's *additional* top-level types: §5 also says the first or
# same-named type takes `<stem>.md`, so a documented source always has that one.
# Which types a file declares is Claude's to know and not the shell's — see
# SPEC.md §1's division of labour — so the additional files cannot be predicted
# here anyway.
#
# Existence on disk, not `git ls-files`: a concept written by /okf-generate and
# not yet committed is a concept, and a run of `okf list --missing` straight
# after generating is the obvious way to see what is left.
#
# One thing this cannot see, deliberately: two sources in one directory sharing
# a stem — `helper.ts` beside `helper.py` — share `helper.md`, so documenting
# either covers both. Telling them apart means reading the concept's `resource`
# field with read_frontmatter and deciding which source it names, which is a
# change to what `--missing` means rather than to how a name is derived; it
# belongs to whichever item needs that, and the answer here stays the mechanical
# one §5 describes.
has_concept() { # $1 = a bundle-relative source path
  local path="$1" dir base stem
  base="${path##*/}"
  case "$path" in
    */*) dir="${path%/*}/" ;;
    *) dir="" ;;
  esac
  case "$base" in
    ?*.*) stem="${base%.*}" ;;
    *) stem="$base" ;;
  esac

  # A directory named `Foo.md`, or a symlink pointing at nothing, is not a
  # concept file — `-f` answers for both.
  [ -f "$dir$stem.md" ] || return 1

  # A `.md` source is not its own concept. `bundle.extensions` decides what
  # counts as a source and nothing stops it naming `md`, and a source called
  # `notes.md` has a stem of `notes` and so derives itself: without this, every
  # markdown source in the bundle would mark itself documented and drop out of
  # the listing /okf-generate walks.
  [ ! "$dir$stem.md" -ef "$path" ] || return 1

  # It has to carry SPEC.md §4 frontmatter to be a concept and not just a
  # markdown file that happens to sit there: a README beside a source of the
  # same name is prose, and a `/okf-generate` interrupted part way through
  # leaves a file that opens like a concept and stops. Counted as concepts,
  # either would take that source off this list for good — including out of the
  # re-run that is the way to finish the interrupted write.
  has_frontmatter "$dir$stem.md" || return 1

  # Last, one of SPEC.md §4's reserved names is not a concept either, whatever
  # is written in it. A source whose stem collides with one — `index.ts`,
  # `log.py` — has no concept of its own to be found, because that name is
  # already spoken for: `index.md` is the directory's own document and `log.md`
  # belongs to OKF. So it is reported as having none.
  #
  # Reporting it is the honest answer — it really has none — and the one whose
  # mistakes are visible. The alternative is counting the directory's own
  # `index.md`, which would have `okf index` mark every such source documented
  # without writing a word about it, and a source silently dropped from the
  # bundle is the failure nobody goes looking for.
  #
  # It is also, admittedly, a source `/okf-generate` cannot take off this list:
  # every name it could write the concept under is either reserved or §5's
  # additional-type spelling `<stem>.<TypeName>.md`, and a `<stem>.<X>.md` is
  # indistinguishable from the concept of a sibling source called
  # `<stem>.<X>.<ext>` — `index.spec.md` beside `index.spec.ts` — so matching
  # one here would hide `index.ts` the moment its neighbour got documented.
  # SPEC.md does not settle what that concept is called, and this is not the
  # place to invent it: a name for it belongs in SPEC.md, and until there is
  # one, saying so every run beats guessing wrong in silence.
  #
  # Asked of the filesystem with `-ef` rather than of the string, because the
  # two disagree on a case-insensitive one — macOS's APFS, Windows — where
  # `Index.md` and the directory's own `index.md` are one file that a string
  # compare reads as two. That is exactly the silent drop this is here to stop,
  # so it is the file that has to be identified and not the name. `-ef` is
  # false when the reserved file is not there at all, which is the ordinary
  # case and needs no check of its own.
  local reserved
  for reserved in "${OKF_RESERVED_CONCEPT_NAMES[@]}"; do
    [ ! "$dir$stem.md" -ef "$dir$reserved" ] || return 1
  done
  return 0
}

# The file a concept documents, resolved to a bundle-relative path this bundle
# can go and look at, left in OKF_CONCEPT_RESOURCE. Returns 1 — with
# OKF_CONCEPT_RESOURCE emptied — when the concept names no resource this bundle
# answers for.
#
# Takes the `resource` field rather than reading it, so that a caller which has
# already read the concept's frontmatter for its own reasons does not open the
# file a second time, and so that nothing here depends on which read_frontmatter
# call last ran. load_bundle_globs must have run, which is the one thing it does
# reach for.
#
# Shared by `okf list --orphans` and `okf check`, which ask the same question of
# the same files and must not answer it differently: a concept counted as this
# bundle's when drift is measured and as some other bundle's when orphans are
# listed is one that can be reported drifted forever and never cleaned up.
#
# What it enforces, in order:
#
#   * A concept that declares no `resource` is not resolvable. okf has not been
#     told what it documents, so it cannot find out anything about that thing.
#   * SPEC.md §4 puts path-valued fields in bundle-absolute form — a leading `/`
#     that means the bundle root and not the filesystem's. okf is standing in
#     the root, so dropping it makes the path one this can test directly. A
#     `resource` written without the leading `/` is read the same way rather
#     than refused: the two spellings name one file, and §4's form is a
#     recommendation about surviving file moves, not a gate on being read.
#   * SPEC.md §5's co-location, asked as a directory and not as a filename: the
#     concept lives beside its source, so a `resource` naming a file in some
#     other directory is not one this concept documents by §5's rules. The
#     filename is deliberately not derived — §5 gives a file's additional
#     top-level types the spelling `<stem>.<TypeName>.md`, which no source is
#     ever named — so the directory is as much as can be checked, and it is the
#     part that matters.
#
#     What it is really guarding is the bundle boundary. A vendored or nested
#     repository with its own okf.json is its own bundle, and its concepts write
#     `resource` bundle-absolute against *its* root: read from out here,
#     `/src/util/helper.ts` is a file that was never in this repository, and
#     every concept it has would be answered for by this bundle.
#   * SPEC.md §6's `include` and `exclude`, asked of the source and not of the
#     concept. Both settings are written about sources, and one written
#     `src/**/*.py` matches no `.md` in the repository at all. Co-location above
#     has already made this the concept's directory, so what the two spellings
#     differ over is only the filename, which is exactly the part these globs are
#     entitled to have an opinion about.
#
#     `extensions` is deliberately not asked. It says what kind of file gets
#     documented, and a concept that exists is evidence one already was:
#     narrowing `extensions` to `["java"]` today does not make yesterday's
#     TypeScript concept stop being this bundle's to answer for.
#
# Whether the file is *there* is deliberately not asked. That is the difference
# between the two callers — gone is what `--orphans` reports, and present is
# what `okf check` hashes — and answering it here would leave neither able to
# tell an unresolvable concept from a resolved one whose source has been
# deleted.
OKF_CONCEPT_RESOURCE=""
concept_resource() { # $1 = a bundle-relative concept path, $2 = its `resource` field
  local concept="$1" resource="$2" resource_dir concept_dir
  OKF_CONCEPT_RESOURCE=""

  [ -n "$resource" ] || return 1
  resource="${resource#/}"
  # A `resource` of nothing but `/` names the bundle root, which is a directory
  # and not a source. Asked again after the strip, because that is where a value
  # that was only ever a leading slash becomes empty.
  [ -n "$resource" ] || return 1

  case "$resource" in
    */*) resource_dir="${resource%/*}/" ;;
    *) resource_dir="" ;;
  esac
  case "$concept" in
    */*) concept_dir="${concept%/*}/" ;;
    *) concept_dir="" ;;
  esac
  [ "$resource_dir" = "$concept_dir" ] || return 1

  in_bundle_globs "$resource" || return 1

  OKF_CONCEPT_RESOURCE="$resource"
  return 0
}

# One concept's SPEC.md §4 frontmatter, as `read_frontmatter` last left it:
# every field §4 lists as shell-read, plus the few that another section of the
# spec names outright. The rest of what a concept carries — `tags`, `sources`,
# `code.members` — is Claude's to write and OKF's to define, and a variable
# here is this script claiming an opinion about a field, so nothing joins this
# list that a section of SPEC.md has not asked for by name. SPEC.md §1's
# division of labour is what that line is drawn from.
#
# The names are §4's own field names, mechanically: `OKF_FM_` then the field
# with its dots turned into underscores, its `[]` dropped and the whole thing
# upper-cased. `generated.at` is OKF_FM_GENERATED_AT; `verified[].at` is
# OKF_FM_VERIFIED_AT. tests/toolkit.sh derives those names from §4's own
# sentence and checks each one exists, so a field added there with no variable
# here fails rather than going quietly unread.
#
# Empty means absent, for every one of them. A field that is not in the block,
# one written with nothing after its colon, and one whose value is an empty
# string are the same fact to every caller — okf was not told — and none of the
# fields §4 lists has a meaningful empty value that would need telling apart.
#
# This is called once at load, immediately below, so every variable exists from
# the moment bin/okf is sourced: under `set -u` a caller reading one before any
# concept has been read would otherwise abort where it should see "absent".
clear_frontmatter() {
  OKF_FM_TYPE=""
  # Not on §4's shell-read list, and read for the reason OKF_FM_VERIFIED_BY
  # below is read: another section asks for them by name. SPEC.md §9 has a Tier
  # 0 concept with no body yield "exactly one summary chunk built from title,
  # description, and code.signature", and there is no such chunk to build
  # without all three. Read here rather than by `okf chunk` alone so that
  # reading a concept stays the one pass over its block that this function is.
  OKF_FM_TITLE=""
  OKF_FM_DESCRIPTION=""
  OKF_FM_RESOURCE=""
  OKF_FM_STATUS=""
  OKF_FM_STALE_AFTER=""
  OKF_FM_GENERATED_AT=""
  OKF_FM_GENERATED_BY=""
  OKF_FM_CODE_CONTENT_HASH=""
  OKF_FM_CODE_TIER=""
  OKF_FM_CODE_SYMBOL=""
  OKF_FM_CODE_LANGUAGE=""
  # SPEC.md §9's third stub field — see OKF_FM_TITLE.
  OKF_FM_CODE_SIGNATURE=""
  # SPEC.md §9's payload carries `tags`, `lines` and `commit` on every point,
  # and none of the three is on §4's shell-read list — read here for the reason
  # OKF_FM_TITLE above is read here, so that opening a concept stays the one
  # pass over its block that this function is.
  #
  # `tags` is a list where every other extension field is a scalar, so it comes
  # back as an array; §4 writes it `[routing, cache]`, and a block sequence
  # under a bare `tags:` is the same document and is read too.
  OKF_FM_TAGS=()
  # `code.lines` exactly as written, `[28, 214]` and all. What SPEC.md §9 wants
  # on the payload is the pair, and turning a pair into JSON is the renderer's
  # job rather than the reader's — see chunk_lines_json.
  OKF_FM_CODE_LINES=""
  OKF_FM_CODE_COMMIT=""
  # A list where the others are scalars, because SPEC.md §8 says verified
  # entries are never stripped: a concept accumulates them, and the last one is
  # not the only one that matters. Document order.
  OKF_FM_VERIFIED_AT=()
  # The actor each of those instants was recorded by, at the same index — and
  # the number of `verified` entries the block held, which is not the same
  # number: an entry written with no `at:` leaves nothing in either array.
  #
  # `verified[].by` is not on SPEC.md §4's list of fields the shell reads, and
  # is read all the same because §8's trust rule cannot be computed without it:
  # "verified only by non-`human:` actors → Machine-confirmed" is a question
  # about the actor, and an instant on its own cannot answer it. Kept beside
  # `verified[].at` rather than in a shape of its own so that the pair is one
  # entry read two ways: OKF_FM_VERIFIED_BY[i] is who recorded
  # OKF_FM_VERIFIED_AT[i].
  OKF_FM_VERIFIED_BY=()
  OKF_FM_VERIFIED_COUNT=0
}
clear_frontmatter

# The value half of a frontmatter `key: value` line — everything after the
# colon, with its quotes, its trailing comment and its surrounding whitespace
# taken off — left in OKF_FRONTMATTER_SCALAR rather than printed. Reading a
# concept costs no subprocess at all that way, which is what it takes for `okf
# check` to read every concept in a bundle: printed instead, each field would be
# a `$(...)` and so a fork apiece.
#
# Surrounding quotes come off. SPEC.md §4's own example writes `resource:` bare
# and `content_hash:` quoted, so both spellings are in circulation, and a value
# read with its quotes still on is one no comparison ever matches: a quoted
# `content_hash` reports a concept drifted that is not, and a quoted `resource`
# reports a live concept an orphan.
#
# A trailing `# comment` comes off with them, for the same reason and at the
# same cost. YAML ends a scalar at an unquoted `#` that has whitespace in front
# of it, and a note somebody left beside a hash — `content_hash: "sha256:…"  #
# regenerate after the refactor` — read as part of the value is a file reported
# drifted for as long as the note is there. Quoted first and comment second,
# which is the order YAML resolves them in: a `#` inside quotes is part of the
# value, and the comment can only begin after the closing quote.
#
# The rest of YAML's scalar rules are deliberately not implemented — an escape
# sequence inside a double-quoted value stays as written, a doubled '' inside a
# single-quoted one stays doubled. §4's formatting contract rules out what would
# need them (no multi-line and no folded scalars in any field the shell reads),
# and the fields §4 lists are timestamps, digests, paths and identifiers.
OKF_FRONTMATTER_SCALAR=""
frontmatter_scalar() { # $1 = everything after a frontmatter key's colon
  local value="$1" quote="" rest
  # Leading whitespace, so what is left starts with the value itself — or with
  # the quote or `#` that decides how the rest of it is read.
  value="${value#"${value%%[![:space:]]*}"}"

  case "$value" in
    '"'*) quote='"' ;;
    "'"*) quote="'" ;;
  esac
  if [ -n "$quote" ]; then
    rest="${value#"$quote"}"
    case "$rest" in
      *"$quote"*)
        # Up to the closing quote, and nothing after it: the value ends there,
        # and whatever follows is a comment or a stray.
        OKF_FRONTMATTER_SCALAR="${rest%%"$quote"*}"
        return 0
        ;;
    esac
    # A quote that is never closed is not a quoted value at all. Read on as if
    # it were bare, which leaves the opening quote in place — a `resource` that
    # visibly still has one is a path that visibly does not exist, and that is
    # a better answer than silently inventing where the value was meant to end.
  fi

  # The first `#` with whitespace in front of it starts a comment. `%%` removes
  # the longest matching suffix, which is the earliest such `#` — a later one
  # inside the comment cannot pull the cut back the other way. A `#` in the
  # first column of the value is a comment too, and leaves nothing.
  value="${value%%[[:space:]]#*}"
  case "$value" in
    '#'*) value="" ;;
  esac

  # Trailing whitespace last, once the comment that was behind it has gone. A
  # value that is nothing but whitespace comes out empty, which is exactly what
  # absent looks like: `resource:` with nothing after it names no file.
  value="${value%"${value##*[![:space:]]}"}"
  OKF_FRONTMATTER_SCALAR="$value"
}

# One item onto OKF_FLOW_ITEMS. An item that is empty is dropped rather than
# recorded: `[routing, ]` is a trailing comma somebody left behind, and an empty
# tag is not a tag.
#
# Nothing is trimmed here, because by this point there is nothing left to trim
# and no way to tell what would be safe to: yaml_flow_items drops the whitespace
# that sits *outside* an item's quotes as it goes, which is the only whitespace
# that was never part of the value. Trimming here instead would take the spaces
# out of `[" a "]` — the one thing the quotes in it were for.
flow_item_push() { # $1 = one item, with its quotes already off
  [ -n "$1" ] || return 0
  OKF_FLOW_ITEMS+=("$1")
}

# One YAML flow sequence — `[routing, cache]`, `[28, 214]` — as its items, left
# in OKF_FLOW_ITEMS. Returns 1 when the value is not a flow sequence at all,
# with the array empty, so a caller can tell `tags: []` from `tags: routing`.
#
# SPEC.md §4 writes both of the fields this exists for — `tags` and
# `code.lines` — in flow form on one line, and §4's formatting contract rules
# out the alternative for anything the shell reads: "no multi-line or folded
# scalars". So one short line is the whole of what has to be parsed, and a
# character loop over it costs no subprocess.
#
# Quotes come off an item the way frontmatter_scalar takes them off a scalar,
# and a comma inside them separates nothing: a tag is whatever somebody typed,
# and `["routing, cached"]` is one tag. Nothing else of YAML's flow syntax is
# implemented, because the two fields this reads hold identifiers and integers:
# a nested sequence is refused outright rather than misread, and the escapes
# understood are the two YAML defines inside quotes — `\"` in a double-quoted
# item and `''` in a single-quoted one.
#
# Given the value as the line spells it, `[` and `]` and any trailing comment
# included, rather than what frontmatter_scalar makes of it. That function ends
# a scalar at the first ` #`, which is right for every field but this one: a `#`
# inside a quoted item — `tags: [alpha, "beta #gamma"]` — is part of the tag,
# and a value cut there stops being a sequence at all. So the closing `]` is
# found here, by the same scan that already has to know where the quotes are,
# and whatever follows it is the comment.
OKF_FLOW_ITEMS=()
yaml_flow_items() { # $1 = a YAML flow sequence, as the line spells it
  local value="$1" inner="" item="" seg="" pending="" quote="" ch at closed=0
  OKF_FLOW_ITEMS=()

  value="${value#"${value%%[![:space:]]*}"}"
  case "$value" in
    "["*) ;;
    *) return 1 ;;
  esac

  for ((at = 1; at < ${#value}; at++)); do
    ch="${value:at:1}"
    if [ -n "$quote" ]; then
      # A backslash inside a double-quoted item takes the next character with
      # it, which is YAML's rule and is the whole of why this branch exists: a
      # `\"` read as a closing quote puts the rest of the sequence outside the
      # quotes, and the first `]` in it ends a sequence that had not ended.
      # Single quotes have no backslash escape in YAML, so this is asked of
      # double ones only.
      if [ "$quote" = '"' ] && [ "$ch" = "\\" ] && [ $((at + 1)) -lt ${#value} ]; then
        at=$((at + 1))
        continue
      fi
      # YAML's escape inside single quotes, which is a doubled quote and not a
      # backslash: `'it''s'` is one item. Read as a close followed by an open,
      # everything after it would be outside the quotes it is inside.
      if [ "$quote" = "'" ] && [ "$ch" = "'" ] \
        && [ "${value:at+1:1}" = "'" ]; then
        at=$((at + 1))
        continue
      fi
      [ "$ch" = "$quote" ] && quote=""
      continue
    fi
    case "$ch" in
      # A nested sequence, which this does not read — see the header. Refused
      # outright rather than ended at the inner `]`, which would drop every item
      # after it and put a `[a` on the payload as though it were a tag.
      "[") return 1 ;;
      # Only where an item begins — the parse loop below applies the same rule,
      # and the two must agree or this scan ends the sequence somewhere that
      # loop does not. `seg` is this scan's view of the item so far, holds no
      # whitespace, and exists only to answer that one question.
      '"' | "'") [ -n "$seg" ] || quote="$ch" ;;
      "]")
        closed=1
        break
        ;;
      ,)
        seg=""
        continue
        ;;
      [[:space:]]) continue ;;
    esac
    seg="$seg$ch"
  done

  # A `[` that is never closed is not a sequence, whatever it was meant to be.
  # Answered with the 1 that says "not a flow sequence" rather than with the
  # items found so far, which would be a list okf finished on the author's
  # behalf out of a line that was cut off.
  [ "$closed" -eq 1 ] || return 1
  inner="${value:1:at-1}"

  # `[]`, or `[  ]`: a sequence, and an empty one. Told apart here from a value
  # that is not a sequence at all, which is the 1 above — an empty `tags` list
  # is a decision somebody wrote down, and a missing one is not.
  case "$inner" in
    *[![:space:]]*) ;;
    *) return 0 ;;
  esac

  quote=""
  item=""
  for ((at = 0; at < ${#inner}; at++)); do
    ch="${inner:at:1}"
    if [ -n "$quote" ]; then
      # The escape the scan above already had to understand, here taking the
      # escaped character into the value: `"a\"b"` is one item holding a quote.
      if [ "$quote" = '"' ] && [ "$ch" = "\\" ] && [ $((at + 1)) -lt ${#inner} ]; then
        at=$((at + 1))
        item="$item${inner:at:1}"
        continue
      fi
      # The single-quoted escape the scan above also understands: two quotes
      # stand for one, and the item goes on.
      if [ "$quote" = "'" ] && [ "$ch" = "'" ] \
        && [ "${inner:at+1:1}" = "'" ]; then
        at=$((at + 1))
        item="$item'"
        continue
      fi
      if [ "$ch" = "$quote" ]; then
        quote=""
      else
        item="$item$ch"
      fi
      continue
    fi

    # Whitespace outside an item's quotes is held back rather than added, and
    # added only once something else follows it inside the same item. That is
    # what separates `[a, b]` from `[" a "]`: the spaces around a value are
    # never part of it, the spaces inside its quotes always are, and a trim
    # applied afterwards could no longer tell which had been which.
    case "$ch" in
      [[:space:]])
        pending="$pending$ch"
        continue
        ;;
    esac
    # The comma ends the item ahead of the flush, so whitespace held back at the
    # end of one — `[ alpha , beta ]` — is dropped with the item rather than
    # written into it.
    if [ "$ch" = "," ]; then
      flow_item_push "$item"
      item=""
      pending=""
      continue
    fi

    [ -z "$item" ] || item="$item$pending"
    pending=""

    case "$ch" in
      # A quote opens a quoted scalar only where an item begins, which is YAML's
      # rule and is what keeps an apostrophe inside a word from opening one:
      # `[don't, care]` is two tags, and a quote taken at face value there would
      # swallow the comma and answer one.
      '"' | "'")
        if [ -z "$item" ]; then
          quote="$ch"
        else
          item="$item$ch"
        fi
        ;;
      *) item="$item$ch" ;;
    esac
  done
  flow_item_push "$item"
  return 0
}

# Reads one concept's SPEC.md §4 frontmatter into the OKF_FM_ variables above.
#
# Returns 0 when the file carries a block — `---` on line 1, closed by the next
# line that is exactly `---` — and 1 when it has none, opens one it never
# closes, or cannot be read at all. On 1 every variable is empty: a failed read
# must not leave the last successful one's values standing, or a caller looping
# over concepts would attribute one concept's hash to the next one along.
#
# One pass over the file, every field at once, rather than a function per field.
# Eleven readers would be eleven opens of the same few lines for every concept
# in the bundle, on exactly the subcommands — `check`, `chunk` — that ask about
# all of them.
#
# Read to §4's formatting contract and no further, because that contract is what
# makes reading YAML with `case` honest rather than lucky:
#
#   * A top-level key is unindented. Anchoring on that is what keeps the
#     `  - resource: https://example.invalid/DON-86` inside a `sources:` list
#     out of `resource` — §4 is explicit that `sources` is for external
#     references and never a restatement of `resource`, so reading one as the
#     other would point okf at a URL that is not a path at all.
#   * `code.X` is "the first line matching `^  X: ` after the `^code:` line and
#     before the next unindented key", which is §4's extraction rule quoted.
#     Exactly two spaces, because §4 puts the block's scalars at two and its
#     list items at four: a `code.members` entry describing a member called
#     `symbol` or `language` sits a level deeper than anything read here.
#     `generated.at` and `generated.by` are read by the same rule under
#     `generated:`, that being the only reading of §4 that does not invent a
#     second rule for a block it describes the same way.
#   * A bare block header opens a block and `code: something` does not. What
#     may follow the colon is whitespace and a comment, neither of which is a
#     difference in what the line says.
#   * A blank line closes nothing. §4's boundary is the next unindented *key*,
#     and a blank line between two verified entries is cosmetic.
#
# The first line naming a value wins, for every field. A block with two
# `status:` lines is malformed YAML with no defined meaning, and taking the
# first is what §4's `code.X` rule does — the only choice that does not depend
# on how far past the mistake the reader happened to keep going.
#
# `verified[].at` is collected per list entry: an entry opens on a `-`, and its
# `at:` is whichever of that line and the lines that follow it at the entry's
# own key column names one first. An entry naming none contributes nothing, so what comes back is
# timestamps and not entries — there is no instant to compare with
# `generated.at` in an entry that has not got one, and SPEC.md §8's trust rule
# is entirely about comparing the two. It is also why an entry's own `by:` is
# not read here: §4's shell-read list does not include it, and the subcommand
# that needs it can say so then.
#
# CRLF and a UTF-8 BOM are stripped, for the reason has_frontmatter strips them:
# a checkout on Windows changes how the lines are spelled and not what they say,
# and a concept okf stopped recognising there is one it silently reports as
# documenting nothing.
read_frontmatter() { # $1 = a path to a concept file
  local path="$1" line rest prefix indent opened=0 closed=0 block="" pending=0
  # Where the open `verified` entry's `-` sits, and the column its keys line up
  # in; -1 for "no entry open" and "not established yet" respectively.
  local v_dash=-1 v_key=-1
  # The open entry's own `by:`: whether one is still awaited, the actor read
  # before that entry's instant arrived, and the index its instant went to once
  # it did — see OKF_FM_VERIFIED_BY, and note that `by:` and `at:` come in
  # either order.
  local by_pending=0 v_by="" v_at=-1
  local f_type="" f_title="" f_description="" f_resource="" f_status=""
  local f_stale_after="" f_generated_at="" f_generated_by=""
  local f_content_hash="" f_tier="" f_symbol="" f_language="" f_signature=""
  local f_commit="" f_lines=""
  # Whether a `tags:` key has been met, which the other fields answer with
  # `[ -z "$f_tags" ]` and a list cannot: an empty `tags: []` is a value
  # somebody wrote, and a second `tags:` line below it must not overwrite it.
  local tags_seen=0
  local -a f_tags=()
  local f_verified_count=0
  local -a f_verified_at=() f_verified_by=()

  clear_frontmatter

  # Asked before the redirection, not left to it: a redirection that fails is a
  # failure of the `while` itself, and under `set -e` that takes the whole
  # script down instead of returning the 1 every caller here is written to
  # handle. A path that is not a regular file — gone, or a directory called
  # `Foo.md` — carries no frontmatter, which is the same answer.
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    return 1
  fi

  # `|| [ -n "$line" ]` so a last line with no newline after it is still read.
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#$'\xef\xbb\xbf'}"
    line="${line%$'\r'}"

    if [ "$opened" -eq 0 ]; then
      # Line 1 or nothing: §4 puts the block at the top of the file, and a
      # `---` further down is a horizontal rule in somebody's prose.
      [ "$line" = "---" ] || break
      opened=1
      continue
    fi
    if [ "$line" = "---" ]; then
      closed=1
      break
    fi

    case "$line" in
      [![:space:]#-]*)
        # An unindented line that is neither a comment nor the start of a list
        # item: a top-level key, and the end of whatever nested block was open.
        # That boundary is §4's own — `code.X` is read "before the next
        # unindented key" — and it is the only thing separating `generated:`'s
        # `at:` from a `verified:` entry's.
        #
        # A `#` in the first column is a whole-line comment, and a comment is
        # not a key. Ending a block on one would drop every field written below
        # it — a note left above `content_hash:` would take the hash with it,
        # and SPEC.md §8 reads a concept with no stored hash as one it cannot
        # tell has drifted.
        block=""
        pending=0
        by_pending=0
        v_by=""
        v_at=-1
        v_dash=-1
        v_key=-1
        case "$line" in
          "code:"*)
            frontmatter_scalar "${line#"code:"}"
            if [ -z "$OKF_FRONTMATTER_SCALAR" ]; then
              block="code"
            fi
            ;;
          "generated:"*)
            frontmatter_scalar "${line#"generated:"}"
            if [ -z "$OKF_FRONTMATTER_SCALAR" ]; then
              block="generated"
            fi
            ;;
          "verified:"*)
            frontmatter_scalar "${line#"verified:"}"
            if [ -z "$OKF_FRONTMATTER_SCALAR" ]; then
              block="verified"
            fi
            ;;
          # SPEC.md §4 writes this `tags: [routing, cache]`, and so does every
          # writer in this repo; a block sequence under a bare `tags:` is the
          # same document, and both are read. Which one it is decides here: a
          # value after the colon is the flow form, and no value at all opens a
          # block for the `- item` lines the indented branch below collects.
          "tags:"*)
            if [ "$tags_seen" -eq 0 ]; then
              tags_seen=1
              # The sequence is read off the line as written, because
              # frontmatter_scalar would end the value at a `#` inside a quoted
              # item — see yaml_flow_items. Only what is not a sequence falls
              # through to it, and there the `#` is a comment again.
              if yaml_flow_items "${line#"tags:"}"; then
                f_tags=(${OKF_FLOW_ITEMS[@]+"${OKF_FLOW_ITEMS[@]}"})
              else
                frontmatter_scalar "${line#"tags:"}"
                if [ -n "$OKF_FRONTMATTER_SCALAR" ]; then
                  # `tags: routing` — one tag, written without the brackets.
                  # YAML calls that a scalar rather than a list, and a bundle
                  # whose author meant one tag is better served by the tag than
                  # by an empty list and no complaint.
                  f_tags=("$OKF_FRONTMATTER_SCALAR")
                else
                  block="tags"
                fi
              fi
            fi
            ;;
          "type:"*)
            if [ -z "$f_type" ]; then
              frontmatter_scalar "${line#"type:"}"
              f_type="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
          "title:"*)
            if [ -z "$f_title" ]; then
              frontmatter_scalar "${line#"title:"}"
              f_title="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
          "description:"*)
            if [ -z "$f_description" ]; then
              frontmatter_scalar "${line#"description:"}"
              f_description="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
          "resource:"*)
            if [ -z "$f_resource" ]; then
              frontmatter_scalar "${line#"resource:"}"
              f_resource="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
          "status:"*)
            if [ -z "$f_status" ]; then
              frontmatter_scalar "${line#"status:"}"
              f_status="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
          "stale_after:"*)
            if [ -z "$f_stale_after" ]; then
              frontmatter_scalar "${line#"stale_after:"}"
              f_stale_after="$OKF_FRONTMATTER_SCALAR"
            fi
            ;;
        esac
        ;;
      *)
        # Indented, blank, a comment, or a list item written flush left: inside
        # whatever block is open, and inside none at all when the last
        # unindented key was an ordinary scalar. `sources:` lands there, which is what keeps its
        # `resource:` and `title:` out of the top-level fields of the same name.
        #
        # A sequence item is the one construct YAML lets sit at its parent key's
        # own indentation — `verified:` then `- by: human:dcruver` in the first
        # column is the same document as §4's indented example, and is what most
        # YAML writers emit. Reading it as a top-level key would end the
        # `verified:` block on its first entry and quietly leave a concept a
        # human has reviewed with no verified timestamps at all, which SPEC.md
        # §8 then reads as never verified. A mapping's values have no such
        # licence — they must be indented past their key — so this is the whole
        # of the exception.
        case "$block" in
          tags)
            # A block sequence's items, at whatever column the writer put them
            # in: a `-` flush left is the same document as one indented under
            # its key, which is the licence the outer case already grants a
            # `verified:` entry. Nothing nested is read, because a tag is a
            # string — so an item's own indentation carries no meaning here, and
            # none is tracked.
            prefix="${line%%[![:space:]]*}"
            rest="${line#"$prefix"}"
            case "$rest" in
              -*)
                frontmatter_scalar "${rest#-}"
                [ -z "$OKF_FRONTMATTER_SCALAR" ] \
                  || f_tags+=("$OKF_FRONTMATTER_SCALAR")
                ;;
            esac
            ;;
          code)
            case "$line" in
              "  content_hash: "*)
                if [ -z "$f_content_hash" ]; then
                  frontmatter_scalar "${line#"  content_hash:"}"
                  f_content_hash="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              "  tier: "*)
                if [ -z "$f_tier" ]; then
                  frontmatter_scalar "${line#"  tier:"}"
                  f_tier="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              "  symbol: "*)
                if [ -z "$f_symbol" ]; then
                  frontmatter_scalar "${line#"  symbol:"}"
                  f_symbol="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              "  language: "*)
                if [ -z "$f_language" ]; then
                  frontmatter_scalar "${line#"  language:"}"
                  f_language="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              "  commit: "*)
                if [ -z "$f_commit" ]; then
                  frontmatter_scalar "${line#"  commit:"}"
                  f_commit="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              # Two spaces here for the reason `signature` below wants them:
              # §4 gives every `code.members` entry a `lines:` of its own, four
              # spaces in, and the range this field means is the type's.
              "  lines: "*)
                if [ -z "$f_lines" ]; then
                  frontmatter_scalar "${line#"  lines:"}"
                  f_lines="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              # Exactly two spaces, as §4's extraction rule has it, and here
              # that width is the whole of what keeps a member's signature out
              # of the type's: §4 puts `code.members` entries at four spaces,
              # and each one carries a `signature:` of its own.
              "  signature: "*)
                if [ -z "$f_signature" ]; then
                  frontmatter_scalar "${line#"  signature:"}"
                  f_signature="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
            esac
            ;;
          generated)
            case "$line" in
              "  at: "*)
                if [ -z "$f_generated_at" ]; then
                  frontmatter_scalar "${line#"  at:"}"
                  f_generated_at="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
              "  by: "*)
                if [ -z "$f_generated_by" ]; then
                  frontmatter_scalar "${line#"  by:"}"
                  f_generated_by="$OKF_FRONTMATTER_SCALAR"
                fi
                ;;
            esac
            ;;
          verified)
            # No width is written down here: §4 puts an entry's `-` at two
            # spaces and its keys at four, a YAML writer puts them at zero and
            # two, and the two spellings are the same document. What is tracked
            # instead is the relationship — where this entry's `-` sits, and the
            # column its own keys line up in.
            #
            # Both are needed to keep an entry's timestamp its own. A mapping
            # nested inside an entry indents past those keys, so an `at:` under
            # a `context:` is deeper than the entry's key column and is not the
            # entry's `at` — in whichever order the two are written. A sequence
            # nested inside one indents past the entry's `-`, so its items are
            # not new entries. Read without those two tests, a concept whose
            # entry carries anything at all beside `by:` and `at:` comes back
            # with somebody else's instant, or with an entry that was never
            # verified by anyone.
            prefix="${line%%[![:space:]]*}"
            rest="${line#"$prefix"}"
            indent="${#prefix}"
            case "$rest" in
              -*)
                if [ "$v_dash" -lt 0 ] || [ "$indent" -le "$v_dash" ]; then
                  v_dash="$indent"
                  rest="${rest#-}"
                  prefix="${rest%%[![:space:]]*}"
                  rest="${rest#"$prefix"}"
                  if [ -n "$rest" ]; then
                    # `- at: …`, or `- by: …`: the entry's keys start right
                    # here, past the `-` and the space after it.
                    v_key=$((v_dash + 1 + ${#prefix}))
                  else
                    # A `-` with nothing after it puts the entry's first key on
                    # a following line, at a column this cannot predict. Left
                    # unknown, to be taken from that line when it arrives.
                    v_key=-1
                  fi
                  pending=1
                  by_pending=1
                  v_by=""
                  v_at=-1
                  # Counted here and nowhere else: this is the one place a
                  # `verified` entry is known to have begun, and SPEC.md §8's
                  # first question — is there a verified entry at all — is asked
                  # of entries and not of the instants they carry. An entry
                  # written with no `at:` leaves no instant behind, and a
                  # concept whose only entry is that one has still been
                  # verified by somebody.
                  f_verified_count=$((f_verified_count + 1))
                else
                  # Deeper than this entry's own `-`: a list nested inside it.
                  rest=""
                fi
                ;;
              *)
                if [ "$v_dash" -lt 0 ]; then
                  # Something before the first entry — a comment, or a key of a
                  # block written `verified:` with a mapping under it.
                  rest=""
                elif [ "$v_key" -lt 0 ]; then
                  if [ "$indent" -gt "$v_dash" ]; then
                    v_key="$indent"
                  else
                    rest=""
                  fi
                elif [ "$indent" -ne "$v_key" ]; then
                  # Deeper than the entry's keys, so inside something nested in
                  # it; shallower, and it is not part of the entry at all.
                  rest=""
                fi
                ;;
            esac
            case "$rest" in
              "at: "*)
                if [ "$pending" -eq 1 ]; then
                  frontmatter_scalar "${rest#"at:"}"
                  if [ -n "$OKF_FRONTMATTER_SCALAR" ]; then
                    f_verified_at+=("$OKF_FRONTMATTER_SCALAR")
                    # The slot this entry's instant landed in, so a `by:` on a
                    # later line of the same entry knows where to put itself —
                    # and filled now with whatever `by:` came before it, so the
                    # two arrays stay the same length whichever order the entry
                    # writes its keys in.
                    v_at=$((${#f_verified_at[@]} - 1))
                    f_verified_by[v_at]="$v_by"
                  fi
                  # Cleared whether or not the value was usable: this entry has
                  # had its say, and a deeper `at:` nested under it belongs to
                  # something else.
                  pending=0
                fi
                ;;
              "by: "*)
                if [ "$by_pending" -eq 1 ]; then
                  frontmatter_scalar "${rest#"by:"}"
                  if [ "$v_at" -ge 0 ]; then
                    f_verified_by[v_at]="$OKF_FRONTMATTER_SCALAR"
                  else
                    # This entry's instant has not been read yet — `- by:` then
                    # `at:` is SPEC.md §4's own order — so the actor waits for
                    # the slot the `at:` above will make for it.
                    v_by="$OKF_FRONTMATTER_SCALAR"
                  fi
                  by_pending=0
                fi
                ;;
            esac
            ;;
        esac
        ;;
    esac
  # stderr redirected before the input, and not after it: the order is the order
  # they are opened in, so a `2> /dev/null` written second is set up too late to
  # catch the shell's own complaint about the first.
  done 2> /dev/null < "$path"

  # Both ends of the block, exactly as has_frontmatter asks for them. A file
  # that opens one and never closes it is the half-written concept — an
  # interrupted /okf-generate — and the fields read out of it are whatever had
  # been written by the time it stopped. Reporting that as a concept read
  # cleanly is how a truncated `content_hash` becomes a drift report nobody can
  # explain.
  if [ "$opened" -eq 0 ] || [ "$closed" -eq 0 ]; then
    return 1
  fi

  OKF_FM_TYPE="$f_type"
  OKF_FM_TITLE="$f_title"
  OKF_FM_DESCRIPTION="$f_description"
  OKF_FM_RESOURCE="$f_resource"
  OKF_FM_STATUS="$f_status"
  OKF_FM_STALE_AFTER="$f_stale_after"
  OKF_FM_GENERATED_AT="$f_generated_at"
  OKF_FM_GENERATED_BY="$f_generated_by"
  OKF_FM_CODE_CONTENT_HASH="$f_content_hash"
  OKF_FM_CODE_TIER="$f_tier"
  OKF_FM_CODE_SYMBOL="$f_symbol"
  OKF_FM_CODE_LANGUAGE="$f_language"
  OKF_FM_CODE_SIGNATURE="$f_signature"
  OKF_FM_TAGS=(${f_tags[@]+"${f_tags[@]}"})
  OKF_FM_CODE_LINES="$f_lines"
  OKF_FM_CODE_COMMIT="$f_commit"
  OKF_FM_VERIFIED_AT=(${f_verified_at[@]+"${f_verified_at[@]}"})
  OKF_FM_VERIFIED_BY=(${f_verified_by[@]+"${f_verified_by[@]}"})
  OKF_FM_VERIFIED_COUNT="$f_verified_count"
  return 0
}

# Whether one half of a dotted frontmatter field name is a name at all.
#
# Both halves are built into `case` patterns below and into the line that is
# written, so neither can be taken on trust: a name carrying a `*` or a `[`
# would match lines it does not name, and one carrying a `:`, a space or a
# newline would write a line that is not the field it was asked for. The set
# allowed here is the set OKF's own field names are drawn from.
valid_frontmatter_key() { # $1 = one half of a field name
  case "$1" in
    "" | *[!A-Za-z0-9_-]*) return 1 ;;
    # A leading digit or `-` is a name no YAML writer produces and a name this
    # would have to quote to write; refusing is the shorter answer.
    [A-Za-z_]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Why a value read back out of a concept is not always the value that was
# written into it, and what this does about that.
#
# SPEC.md §4's formatting contract is a promise made to `awk` — and through it
# to read_frontmatter above — but a concept is also YAML, which OKF's own
# readers parse properly. A writer that satisfied only the first of those two
# would produce files okf agrees with and nothing else does. So a value is
# written bare only when it is a plain scalar to a real parser as well: no
# whitespace anywhere in it (which is what rules out both a `: ` inside it and
# a trailing ` #` that would start a comment), nothing that opens a flow
# collection, an anchor, a tag or a block scalar, and none of the words a
# YAML 1.1 reader turns into a boolean or a null. `status: no` written bare
# comes back from such a reader as `false`.
#
# Everything else is single-quoted, and double-quoted only when the value
# contains a `'`. That order is the opposite of SPEC.md §4's example, which
# quotes its hashes with `"`, and the difference is deliberate: YAML processes
# escape sequences inside double quotes and none at all inside single quotes,
# while frontmatter_scalar above processes neither. A Windows path or a regex
# written into a double-quoted scalar is one value to okf and another to every
# real parser; single-quoted, the two agree. §4's own spelling is still read
# correctly — this is about what okf emits, not about what it accepts.
#
# A value carrying both kinds of quote is refused rather than escaped, because
# escaping it means `\"` or `''` and neither is something frontmatter_scalar
# undoes: writing one would be okf producing a file okf itself misreads.
#
# The answer is left in OKF_FRONTMATTER_RENDERED rather than printed, as
# frontmatter_scalar leaves its own: a `$(...)` here is a fork per field
# written.
OKF_FRONTMATTER_RENDERED=""
render_frontmatter_scalar() { # $1 = the value to write
  local value="$1" safe=1

  # Empty is refused, and not on a technicality. `key:` with nothing after it
  # is a bare block header — the very line read_frontmatter reads as "a block
  # opens here" — so writing an empty value would not write an empty field, it
  # would write a structure. Clearing a field means removing its line, which is
  # a different operation with a different name and one nothing asks for.
  if [ -z "$value" ]; then
    OKF_FRONTMATTER_ERROR="an empty value would write a block header, not a field"
    return 1
  fi
  case "$value" in
    *$'\n'* | *$'\r'*)
      # §4: no multi-line or folded scalars in any field the shell reads.
      OKF_FRONTMATTER_ERROR="a value spanning more than one line cannot be written"
      return 1
      ;;
    *$'\t'*)
      # §4: no tabs anywhere. YAML forbids them as indentation, and a writer
      # emitting one would be putting a character into the file that its own
      # contract says is not in there.
      OKF_FRONTMATTER_ERROR="a value containing a tab cannot be written"
      return 1
      ;;
  esac

  # One `case`, every disqualification in it, because they all have the same
  # consequence. In order: a character outside the plain-scalar set; one of the
  # few characters in that set that means something else in first position; a
  # trailing `:`, which is where a plain scalar turns into a mapping key; and
  # YAML 1.1's booleans and nulls, spelled out because `${value,,}` needs
  # bash 4 and macOS still ships 3.2.
  case "$value" in
    *[!A-Za-z0-9_.:+@=/-]* | [-.:+=@]* | *: \
      | [Tt][Rr][Uu][Ee] | [Ff][Aa][Ll][Ss][Ee] | [Yy][Ee][Ss] | [Nn][Oo] \
      | [Oo][Nn] | [Oo][Ff][Ff] | [Nn][Uu][Ll][Ll] | [Nn][Oo][Nn][Ee] \
      | [Nn][Aa][Nn] | [Ii][Nn][Ff] | [YyNn])
      safe=0
      ;;
  esac

  if [ "$safe" -eq 1 ]; then
    OKF_FRONTMATTER_RENDERED="$value"
  else
    case "$value" in
      *"'"*)
        case "$value" in
          *'"'* | *'\'*)
            OKF_FRONTMATTER_ERROR="a value carrying both kinds of quote cannot be written"
            return 1
            ;;
        esac
        OKF_FRONTMATTER_RENDERED="\"$value\""
        ;;
      *) OKF_FRONTMATTER_RENDERED="'$value'" ;;
    esac
  fi

  # Read back with this file's own reader before it goes anywhere near the
  # concept. Everything above is a rule about YAML; this is the one check that
  # the two readings agree, and it is the difference between a writer that is
  # correct and one that is correct as far as anybody has thought about it.
  # A value okf could not read back is refused rather than written, because the
  # field it would land in is `content_hash` — and a hash that reads back as
  # something else is a concept reported drifted for ever.
  frontmatter_scalar " $OKF_FRONTMATTER_RENDERED"
  if [ "$OKF_FRONTMATTER_SCALAR" != "$value" ]; then
    OKF_FRONTMATTER_ERROR="the value cannot be written as a scalar okf can read back"
    return 1
  fi
  return 0
}

# Sets one field of one concept's SPEC.md §4 frontmatter, in place, leaving
# every other byte of the file exactly as it was.
#
#   write_frontmatter_field <concept> <field> <value>
#
# `<field>` is §4's own dotted spelling — `status`, `stale_after`,
# `code.content_hash`, `generated.at` — and the field is written where §4's
# extraction rule looks for it: a top-level key unindented, a `code.X` or
# `generated.X` at exactly two spaces inside that block. An existing field is
# rewritten in place, an absent one inserted, and an absent `code:` block
# created. Returns 0 on success and 1 otherwise, with the reason left in
# OKF_FRONTMATTER_ERROR for the caller to report: nothing is printed here,
# because what a subcommand needs to say about a failed `check --stamp` is not
# what it needs to say about a failed `verify`.
#
# **Byte for byte is the requirement, not a nicety.** A concept is mostly
# fields this script has no opinion about — §4's `title`, `tags`, `sources`,
# `code.members`, whatever OKF adds next — around a body somebody wrote.
# SPEC.md §1 puts all of that on Claude's side of the division of labour, so a
# writer that reformatted, reordered or dropped an unrecognised key would be
# the shell overwriting work it cannot reproduce. Every line but the one being
# set is therefore copied out exactly as it came in, keeping its CRLF, a UTF-8
# BOM, a trailing comment, and the absence of a final newline. tests/toolkit.sh
# holds it to that with an unknown top-level key and an unknown key inside the
# `code:` block.
#
# The one line that does change is replaced whole, so a `# regenerate after the
# refactor` somebody left beside the old value goes with it. That is the
# honest outcome: the note was about a value that is no longer there, and
# read_frontmatter has been discarding it as a comment all along — carrying it
# over would attach it to a value it was never written about.
#
# Which line *is* the field is decided by read_frontmatter's rules, because the
# two have to agree: a value written where the reader does not look is a write
# that silently did nothing.
#
#   * A top-level key is unindented and is neither a comment nor a list item;
#     it ends whatever nested block was open.
#   * `code.X` is the first `^  X:` after the bare `code:` header and before
#     that boundary, which is §4's extraction rule. Exactly two spaces — a
#     `symbol:` inside a `code.members` entry is at four, and belongs to a
#     member rather than to the type.
#   * The first line naming the field wins, which is §4's rule for `code.X` and
#     the one read_frontmatter applies to every field. So the line rewritten is
#     the line the reader was reading, and a malformed duplicate below it is
#     left alone — it was already being ignored.
#
# An absent field is inserted rather than appended: a new `code.X` goes
# immediately below its block header and a new top-level key immediately above
# the closing `---`. Both positions make the written line the first of its
# name, so a malformed duplicate further down cannot shadow it — writing a
# field that another line then wins over is the same silent no-op as writing it
# where the reader never looks.
#
# What it refuses, and why each is a refusal rather than a best effort:
#
#   * A file with no frontmatter, one that opens a block and never closes it,
#     or no file at all. That is read_frontmatter's own definition of "not a
#     concept", and the answer to a half-written concept is to finish writing
#     it rather than to edit it.
#   * A field whose existing line is a bare block header — `code`, or a
#     `verified` written as a list. Overwriting `code:` with `code: value`
#     strands every line indented under it. A key written with nothing after
#     its colon and nothing indented under it is not that: it is a field whose
#     value is null, and it is given one.
#   * A field inside a block whose entries are a sequence, which is the same
#     objection from the other end: `verified:` holds `- ` items, and an
#     `  at:` inserted under it turns a list into a mapping. Appending a
#     verified entry is SPEC.md §7's `okf verify`, a list operation and not
#     this one.
#   * A `code.X` where `code:` is a scalar. There is no block to put it in, and
#     opening a second `code:` would leave the concept with two.
#
# The write truncates the concept and rewrites it, which is the trade
# init_write makes and for the same reason: SPEC.md §3's tool list has no
# `mktemp` and no `mv`, and a preflight promising to name exactly what is
# missing cannot quietly depend on tools it never checks. The window that opens
# is between the truncation and the last line going out, and it is kept as
# narrow as it can be — the whole file is read and the replacement built before
# the concept is opened for writing at all, so nothing between those two points
# can fail on anything except the write itself.
OKF_FRONTMATTER_ERROR=""
write_frontmatter_field() { # $1 = concept path, $2 = field name, $3 = value
  local path="$1" field="$2" value="$3"
  local block="" key=""
  OKF_FRONTMATTER_ERROR=""

  case "$field" in
    *.*.*)
      OKF_FRONTMATTER_ERROR="$field names a field nested deeper than SPEC.md §4 goes"
      return 1
      ;;
    *.*)
      block="${field%%.*}"
      key="${field#*.}"
      ;;
    *) key="$field" ;;
  esac
  if ! valid_frontmatter_key "$key" \
    || { [ -n "$block" ] && ! valid_frontmatter_key "$block"; }; then
    OKF_FRONTMATTER_ERROR="$field is not a frontmatter field name"
    return 1
  fi

  # Before the file is opened: a value that cannot be written is not a reason
  # to have read the concept, let alone to have truncated it.
  render_frontmatter_scalar "$value" || return 1
  local rendered="$OKF_FRONTMATTER_RENDERED"

  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    OKF_FRONTMATTER_ERROR="$(display_path "$path") is not a readable file"
    return 1
  fi

  # The whole file, in order, before anything is decided about it. The scan
  # below has to know where the closing `---` is before it can insert a line
  # above it, and the write has to have the file in memory because opening it
  # for writing is what destroys it.
  local -a lines=()
  local line final_nl=1
  while true; do
    if IFS= read -r line; then
      lines+=("$line")
    else
      if [ -n "$line" ]; then
        lines+=("$line")
        # A last line with no newline after it, written back the same way: the
        # byte a file does not end with is as much a part of it as the bytes it
        # does.
        final_nl=0
      fi
      break
    fi
  # stderr redirected before the input and not after it — see read_frontmatter.
  done 2> /dev/null < "$path"

  local total="${#lines[@]}"
  if [ "$total" -eq 0 ]; then
    OKF_FRONTMATTER_ERROR="$(display_path "$path") carries no frontmatter block"
    return 1
  fi

  local i probe bare
  local close=-1 hit=-1 hit_bare=0 in_block=0 block_hdr=-1
  local block_scalar=0 block_seq=0 block_first=0
  local hit_indent=0 hit_pending=0 hit_block=0
  for ((i = 0; i < total; i++)); do
    probe="${lines[i]}"
    # A BOM belongs to the first line only, a CR to any of them. Both are
    # stripped for the comparison and neither from what is written back.
    if [ "$i" -eq 0 ]; then
      probe="${probe#$'\xef\xbb\xbf'}"
    fi
    probe="${probe%$'\r'}"

    if [ "$i" -eq 0 ]; then
      if [ "$probe" != "---" ]; then
        OKF_FRONTMATTER_ERROR="$(display_path "$path") carries no frontmatter block"
        return 1
      fi
      continue
    fi
    if [ "$probe" = "---" ]; then
      close="$i"
      break
    fi

    # The line after a field written with nothing after its colon, which is the
    # one thing that says what such a line meant. `status:` followed by another
    # key is a field with a null value and can be given one; `code:` followed by
    # an indented line is a block header, and giving *that* a value would strand
    # every line under it. A sequence item counts as under it whatever its
    # indentation — YAML lets a list sit at its parent key's own column, and
    # SPEC.md §4's `verified:` is usually written that way.
    #
    # Blank lines and whole-line comments are skipped rather than answering the
    # question, for the reason read_frontmatter does not let them end a block:
    # neither says anything about what shape the value is.
    if [ "$hit_pending" -eq 1 ]; then
      bare="${probe#"${probe%%[![:space:]]*}"}"
      case "$bare" in
        "" | "#"*) ;;
        -*)
          hit_block=1
          hit_pending=0
          ;;
        *)
          [ "$((${#probe} - ${#bare}))" -le "$hit_indent" ] || hit_block=1
          hit_pending=0
          ;;
      esac
    fi

    case "$probe" in
      [![:space:]#-]*)
        # A top-level key: the end of whatever nested block was open, which is
        # §4's own boundary for `code.X`.
        in_block=0
        if [ -z "$block" ] && [ "$hit" -lt 0 ]; then
          case "$probe" in
            "$key:"*)
              hit="$i"
              frontmatter_scalar "${probe#"$key:"}"
              if [ -z "$OKF_FRONTMATTER_SCALAR" ]; then
                hit_bare=1
                hit_indent=0
                hit_pending=1
              fi
              ;;
          esac
        fi
        if [ -n "$block" ] && [ "$block_hdr" -lt 0 ] && [ "$block_scalar" -eq 0 ]; then
          case "$probe" in
            "$block:"*)
              frontmatter_scalar "${probe#"$block:"}"
              if [ -n "$OKF_FRONTMATTER_SCALAR" ]; then
                # `code: java` opens no block. The first key of that name is
                # the one the reader takes, so a bare `code:` further down is
                # not a second chance — this is the answer for the file.
                block_scalar=1
              else
                block_hdr="$i"
                in_block=1
              fi
              ;;
          esac
        fi
        ;;
      *)
        if [ "$in_block" -eq 1 ]; then
          if [ "$block_first" -eq 0 ] && [ -n "$probe" ]; then
            bare="${probe#"${probe%%[![:space:]]*}"}"
            case "$bare" in
              # Blank, and a whole-line comment, say nothing about what shape
              # the block is.
              "" | "#"*) ;;
              -*)
                block_seq=1
                block_first=1
                ;;
              *) block_first=1 ;;
            esac
          fi
          if [ "$hit" -lt 0 ]; then
            case "$probe" in
              "  $key:"*)
                hit="$i"
                frontmatter_scalar "${probe#"  $key:"}"
                if [ -z "$OKF_FRONTMATTER_SCALAR" ]; then
                  hit_bare=1
                  hit_indent=2
                  hit_pending=1
                fi
                ;;
            esac
          fi
        fi
        ;;
    esac
  done

  if [ "$close" -lt 0 ]; then
    OKF_FRONTMATTER_ERROR="$(display_path "$path") opens a frontmatter block it never closes"
    return 1
  fi
  if [ "$hit" -ge 0 ]; then
    if [ "$hit_bare" -eq 1 ] && [ "$hit_block" -eq 1 ]; then
      OKF_FRONTMATTER_ERROR="$field opens a block in $(display_path "$path") and is not a field"
      return 1
    fi
  elif [ -n "$block" ]; then
    if [ "$block_scalar" -eq 1 ]; then
      OKF_FRONTMATTER_ERROR="$block: is not a block in $(display_path "$path")"
      return 1
    fi
    if [ "$block_seq" -eq 1 ]; then
      OKF_FRONTMATTER_ERROR="$block: is a list in $(display_path "$path"), not a block of fields"
      return 1
    fi
  fi

  # Where the line goes, and which existing line it takes its ending from.
  # Replacing copies the ending of the line replaced; inserting copies it from
  # the line it goes in beside, so a concept written on Windows stays that way
  # and one that is not does not acquire a stray CR.
  local at anchor insert=0 open_block=0 indent=""
  if [ "$hit" -ge 0 ]; then
    at="$hit"
    anchor="$hit"
    [ -z "$block" ] || indent="  "
  elif [ -z "$block" ]; then
    at="$close"
    anchor="$close"
    insert=1
  elif [ "$block_hdr" -ge 0 ]; then
    at=$((block_hdr + 1))
    anchor="$block_hdr"
    insert=1
    indent="  "
  else
    at="$close"
    anchor="$close"
    insert=1
    open_block=1
    indent="  "
  fi

  local eol=""
  case "${lines[anchor]}" in
    *$'\r') eol=$'\r' ;;
  esac
  local written="$indent$key: $rendered$eol"

  # Built whole before the concept is opened, so that the only thing left to go
  # wrong after the truncation is the write.
  local -a out=()
  for ((i = 0; i < total; i++)); do
    if [ "$i" -eq "$at" ]; then
      if [ "$insert" -eq 1 ]; then
        [ "$open_block" -eq 0 ] || out+=("$block:$eol")
        out+=("$written")
      else
        out+=("$written")
        continue
      fi
    fi
    out+=("${lines[i]}")
  done

  # Asked before the truncation rather than left to it, for the reason
  # read_frontmatter asks before its redirection: a redirection that fails is a
  # failure of the compound command itself, and under `set -e` that ends the
  # script instead of returning the 1 every caller here is written to handle.
  if [ ! -w "$path" ]; then
    OKF_FRONTMATTER_ERROR="$(display_path "$path") is not writable"
    return 1
  fi

  local n="${#out[@]}" last
  last=$((n - 1))
  {
    for ((i = 0; i < n; i++)); do
      if [ "$i" -eq "$last" ] && [ "$final_nl" -eq 0 ]; then
        printf '%s' "${out[i]}"
      else
        printf '%s\n' "${out[i]}"
      fi
    done
  } 2> /dev/null > "$path" || {
    # The one failure here that is not a refusal. Every other reason this
    # function returns 1 is decided before the concept is opened and leaves it
    # exactly as it was; this one is the truncation having already happened —
    # see the note above about SPEC.md §3's tool list having no `mktemp` and no
    # `mv` to rename over it. A caller told only "cannot write" would read that
    # as "so nothing was written", which is true of every other refusal and is
    # the one thing that is not true here.
    OKF_FRONTMATTER_ERROR="cannot write $(display_path "$path"): it was opened for writing, so it may now be half-written"
    return 1
  }
  return 0
}

# Appends one SPEC.md §4 `verified` entry to a concept, in place, leaving every
# other byte of the file exactly as it was.
#
#   append_verified_entry <concept> <actor> <instant>
#
# The list operation write_frontmatter_field refuses, and refuses by name: an
# `  at:` inserted under a `verified:` whose entries are `- ` items turns a list
# into a mapping. This is the other half — SPEC.md §7's `okf verify` — and it is
# separate for the reason that refusal gives rather than because two writers
# were wanted.
#
# The entry is two lines, `by` then `at`, which is the order SPEC.md §4's own
# example writes them in:
#
#   verified:
#     - by: human:dcruver
#       at: 2026-08-26T16:40:00Z
#
# **Appended, never merged.** SPEC.md §8: "verified entries are never stripped.
# They are historical facts." So an actor who has verified this concept before
# gets a second entry rather than the first one's instant moved forward — the
# two reviews happened, at two instants, and a writer that collapsed them would
# be deleting the older of the two facts. Nothing else in the block is read,
# reordered or rewritten.
#
# Byte for byte for everything else, for write_frontmatter_field's reason and
# by the same means: the whole file is read, the replacement built, and only
# then is the concept opened for writing. Every line but the two inserted keeps
# its CRLF, its BOM, its trailing comment and the absence of a final newline.
# SPEC.md §1 puts a concept's unknown keys and its prose on Claude's side of the
# division of labour, so a writer that reflowed either would be the shell
# overwriting work it cannot reproduce.
#
# **The entry is written in the style it finds.** SPEC.md §4's example puts an
# entry's `-` at two spaces and its keys at four; most YAML writers put them at
# zero and two, and the two spellings are the same document — read_frontmatter
# reads both. So the indentation of the existing entries is measured and
# matched, and §4's own shape is used only when there is nothing to measure. A
# writer that imposed one spelling would reindent a block somebody else's tool
# wrote, which is a diff on every line of it for no change in meaning.
#
# Where the entry goes: after the last line of the first `verified:` block, so
# the entries stay in the order they were made — SPEC.md §8 compares a
# `verified[].at` against `generated.at`, and a history is only a history in
# order. The *first* block, because that is the one read_frontmatter reads
# fields out of; a second `verified:` key is a malformed document either way,
# and appending to the one nothing reads would be a write that silently did
# nothing.
#
# An absent `verified:` opens one immediately above the closing `---`, which is
# write_frontmatter_field's position for a new top-level key and makes the
# written block the first of its name.
#
# What it refuses, and why each is a refusal rather than a best effort:
#
#   * A file with no frontmatter, one that opens a block it never closes, or no
#     file at all — read_frontmatter's own definition of "not a concept". The
#     answer to a half-written concept is to finish writing it.
#   * A `verified:` that is a scalar, or a block of fields rather than a list.
#     Appending a `- ` item to either produces a document no YAML reader will
#     take, and okf guessing which one was meant would be okf editing a
#     structure it did not write.
#   * A symbolic link. stamp_concept's refusal for stamp_concept's reason: a
#     redirection writes *through* a link, so the entry would land in a file
#     outside the work tree and `git status` would have nothing to say about it.
#     There is no reading of `okf verify` under which that is what was asked
#     for.
#
# The reason for a refusal is left in OKF_VERIFY_ERROR rather than printed, as
# write_frontmatter_field leaves its own: what the subcommand needs to say about
# it is the subcommand's to decide.
OKF_VERIFY_ERROR=""
append_verified_entry() { # $1 = concept path, $2 = actor, $3 = instant
  local path="$1" actor="$2" instant="$3"
  OKF_VERIFY_ERROR=""

  # Both values rendered before the file is opened — before it is even read —
  # for render_frontmatter_scalar's reason: a value that cannot be written is
  # not a reason to have touched the concept at all.
  if ! render_frontmatter_scalar "$actor"; then
    OKF_VERIFY_ERROR="$OKF_FRONTMATTER_ERROR"
    return 1
  fi
  local by_value="$OKF_FRONTMATTER_RENDERED"
  if ! render_frontmatter_scalar "$instant"; then
    OKF_VERIFY_ERROR="$OKF_FRONTMATTER_ERROR"
    return 1
  fi
  local at_value="$OKF_FRONTMATTER_RENDERED"

  if [ -L "$path" ]; then
    OKF_VERIFY_ERROR="$(display_path "$path") is a symbolic link, and the entry would be written through it into whatever it points at"
    return 1
  fi
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    OKF_VERIFY_ERROR="$(display_path "$path") is not a readable file"
    return 1
  fi

  # The whole file, in order, before anything is decided about it — see
  # write_frontmatter_field.
  local -a lines=()
  local line final_nl=1
  while true; do
    if IFS= read -r line; then
      lines+=("$line")
    else
      if [ -n "$line" ]; then
        lines+=("$line")
        final_nl=0
      fi
      break
    fi
  # stderr redirected before the input and not after it — see read_frontmatter.
  done 2> /dev/null < "$path"

  local total="${#lines[@]}"
  if [ "$total" -eq 0 ]; then
    OKF_VERIFY_ERROR="$(display_path "$path") carries no frontmatter block"
    return 1
  fi

  # Where the block is, read by read_frontmatter's rules because the two have to
  # agree: an entry appended where the reader does not look is a write that
  # silently did nothing.
  local i probe bare rest pad indent
  local close=-1 hdr=-1 scalar=0 block_end=-1
  for ((i = 0; i < total; i++)); do
    probe="${lines[i]}"
    # A BOM belongs to the first line only, a CR to any of them. Both are
    # stripped for the comparison and neither from what is written back.
    if [ "$i" -eq 0 ]; then
      probe="${probe#$'\xef\xbb\xbf'}"
    fi
    probe="${probe%$'\r'}"

    if [ "$i" -eq 0 ]; then
      if [ "$probe" != "---" ]; then
        OKF_VERIFY_ERROR="$(display_path "$path") carries no frontmatter block"
        return 1
      fi
      continue
    fi
    if [ "$probe" = "---" ]; then
      close="$i"
      break
    fi

    case "$probe" in
      [![:space:]#-]*)
        # An unindented line that is neither a comment nor a list item: a
        # top-level key, and the end of whatever block was open. That boundary
        # is read_frontmatter's, and a flush-left `- ` is deliberately not one
        # — YAML lets a sequence sit at its parent key's own column, and that
        # is how most writers spell §4's `verified:`.
        if [ "$hdr" -ge 0 ] && [ "$block_end" -lt 0 ]; then
          block_end="$i"
        fi
        if [ "$hdr" -lt 0 ] && [ "$scalar" -eq 0 ]; then
          case "$probe" in
            "verified:"*)
              frontmatter_scalar "${probe#"verified:"}"
              if [ -n "$OKF_FRONTMATTER_SCALAR" ]; then
                # `verified: yes` opens no block, and the first key of that
                # name is the one the reader takes — so a bare `verified:`
                # further down is not a second chance. This is the answer for
                # the file.
                scalar=1
              else
                hdr="$i"
              fi
              ;;
          esac
        fi
        ;;
    esac
  done

  if [ "$close" -lt 0 ]; then
    OKF_VERIFY_ERROR="$(display_path "$path") opens a frontmatter block it never closes"
    return 1
  fi
  if [ "$scalar" -eq 1 ]; then
    OKF_VERIFY_ERROR="verified: carries a value in $(display_path "$path") and is not the list SPEC.md §4 makes it"
    return 1
  fi
  if [ "$hdr" -ge 0 ] && [ "$block_end" -lt 0 ]; then
    # Nothing after the block but the closing `---`.
    block_end="$close"
  fi

  # SPEC.md §4's own shape, used when there is no existing entry to measure.
  local dash=2 keycol=4
  local insert_at anchor open_new=0
  if [ "$hdr" -lt 0 ]; then
    insert_at="$close"
    anchor="$close"
    open_new=1
  else
    # The block's own layout, measured from its first entry: where the `-`
    # sits, and the column the entry's keys line up in.
    local first_dash=-1 first_key=-1 last=-1
    for ((i = hdr + 1; i < block_end; i++)); do
      probe="${lines[i]}"
      probe="${probe%$'\r'}"
      bare="${probe#"${probe%%[![:space:]]*}"}"
      # A blank line is not the end of the block and not a line to append
      # after: a concept whose block ends in one keeps it as the separator it
      # was written as.
      [ -n "$bare" ] || continue
      last="$i"
      case "$bare" in
        # A whole-line comment says nothing about what shape the block is, and
        # is not an entry to measure — but it is a line, so an entry appended
        # after it goes after it.
        "#"*) continue ;;
      esac

      if [ "$first_dash" -lt 0 ]; then
        case "$bare" in
          -*)
            first_dash=$((${#probe} - ${#bare}))
            rest="${bare#-}"
            pad="${rest%%[![:space:]]*}"
            rest="${rest#"$pad"}"
            if [ -n "$rest" ]; then
              # `- by: …`: the entry's keys start right there, past the `-`
              # and the space after it.
              first_key=$((first_dash + 1 + ${#pad}))
            fi
            ;;
          *)
            # `verified:` with a mapping under it. A `- ` appended there would
            # turn a mapping into a list, which is the objection
            # write_frontmatter_field makes from the other end.
            OKF_VERIFY_ERROR="verified: holds a block of fields in $(display_path "$path") and is not the list SPEC.md §4 makes it"
            return 1
            ;;
        esac
      elif [ "$first_key" -lt 0 ]; then
        # A `-` with nothing after it put the entry's first key on a following
        # line, at a column the `-` could not predict; this is that line.
        indent=$((${#probe} - ${#bare}))
        if [ "$indent" -gt "$first_dash" ]; then
          first_key="$indent"
        fi
      fi
    done

    if [ "$first_dash" -ge 0 ]; then
      dash="$first_dash"
      if [ "$first_key" -ge 0 ]; then
        keycol="$first_key"
      else
        # An entry whose keys were never found — a `-` alone, or a block whose
        # only entry is empty. One space past the dash is what §4's example and
        # every YAML writer produce.
        keycol=$((dash + 2))
      fi
    fi

    if [ "$last" -ge 0 ]; then
      insert_at=$((last + 1))
      anchor="$last"
    else
      # A bare `verified:` with nothing under it at all.
      insert_at=$((hdr + 1))
      anchor="$hdr"
    fi
  fi

  # The line ending is copied from the line the entry goes in beside, so a
  # concept written on Windows stays that way and one that is not does not
  # acquire a stray CR.
  local eol=""
  case "${lines[anchor]}" in
    *$'\r') eol=$'\r' ;;
  esac

  local gap=$((keycol - dash - 1))
  # Every path above leaves the key column past the dash, so this is a floor
  # and not a correction: a `-` with no space after it is not a list item.
  [ "$gap" -ge 1 ] || gap=1
  local dash_pad="" gap_pad="" key_pad=""
  printf -v dash_pad '%*s' "$dash" ''
  printf -v gap_pad '%*s' "$gap" ''
  printf -v key_pad '%*s' "$keycol" ''

  local by_line="$dash_pad-${gap_pad}by: $by_value$eol"
  local at_line="${key_pad}at: $at_value$eol"

  # Built whole before the concept is opened, so that the only thing left to go
  # wrong after the truncation is the write.
  local -a out=()
  for ((i = 0; i < total; i++)); do
    if [ "$i" -eq "$insert_at" ]; then
      if [ "$open_new" -eq 1 ]; then
        out+=("verified:$eol")
      fi
      out+=("$by_line")
      out+=("$at_line")
    fi
    out+=("${lines[i]}")
  done

  # Asked before the truncation rather than left to it — see
  # write_frontmatter_field.
  if [ ! -w "$path" ]; then
    OKF_VERIFY_ERROR="$(display_path "$path") is not writable"
    return 1
  fi

  local n="${#out[@]}" last_out
  last_out=$((n - 1))
  {
    for ((i = 0; i < n; i++)); do
      if [ "$i" -eq "$last_out" ] && [ "$final_nl" -eq 0 ]; then
        printf '%s' "${out[i]}"
      else
        printf '%s\n' "${out[i]}"
      fi
    done
  } 2> /dev/null > "$path" || {
    # The one failure here that is not a refusal: every other reason this
    # returns 1 is decided before the concept is opened and leaves it exactly
    # as it was. See write_frontmatter_field's note on SPEC.md §3's tool list
    # having no `mktemp` and no `mv` to rename over it.
    OKF_VERIFY_ERROR="cannot write $(display_path "$path"): it was opened for writing, so it may now be half-written"
    return 1
  }
  return 0
}

# Fills OKF_CONCEPTS with the repo's concept files, in the order `load_in_scope`
# lists its sources: every tracked `.md` that carries SPEC.md §4 frontmatter and
# is not one of §4's reserved names.
#
# Neither `include` nor `exclude` is applied here, deliberately. Both are
# written about sources — `src/**`, `**/node_modules/**`, and nothing stops one
# being written `src/**/*.py` or `**/*.md` — and a glob that names a source
# extension matches no concept anywhere in the repository. Asked of a concept's
# own path it would empty the orphan listing and exit 0, which is a bundle full
# of leftovers reported as having none. cmd_list asks both of the `resource`
# instead, where they are being asked about the thing they describe; SPEC.md
# §5's co-location makes that the same directory either way.
#
# The cost of leaving them out is that a vendored tree's markdown is opened to
# be looked at rather than skipped on its path. That is one read of one line
# each, against the risk above.
#
# Tracked files only, where has_concept asks the filesystem. The asymmetry is
# the point of each: has_concept answers "has this source been documented yet?",
# and a concept /okf-generate wrote a second ago counts. This answers "what is
# in the bundle?", and the bundle is what the repo has put under version
# control — the same `git ls-files` reading that makes gitignored files invisible
# to `okf list`. An orphan is made by *deleting a source*, and by then its
# concept has been committed for as long as the source was.
#
# SPEC.md §4's reserved names are skipped: `index.md` is the directory's own
# document and `log.md` belongs to OKF, so neither is any source's concept and
# neither can be orphaned by one going away.
load_concepts() {
  require_git_repo
  load_tracked_paths

  OKF_CONCEPTS=()
  local path dir reserved skip
  for path in ${OKF_TRACKED[@]+"${OKF_TRACKED[@]}"}; do
    case "$path" in
      *.md) ;;
      *) continue ;;
    esac
    # `git ls-files` answers from the index, which still holds a concept deleted
    # from the working tree and not yet staged as removed. A file that is not
    # there documents nothing and cannot be read to find out what it once did.
    # has_frontmatter below reaches the same verdict by failing to open it; this
    # is the cheap answer, and the one that says so in words.
    [ -f "$path" ] || continue

    case "$path" in
      */*) dir="${path%/*}/" ;;
      *) dir="" ;;
    esac
    # `-ef` rather than a name comparison, for the reason has_concept gives:
    # on a case-insensitive filesystem `Index.md` and `index.md` are one file
    # that a string compare reads as two.
    skip=0
    for reserved in "${OKF_RESERVED_CONCEPT_NAMES[@]}"; do
      [ ! "$path" -ef "$dir$reserved" ] || skip=1
    done
    [ "$skip" -eq 0 ] || continue

    # Frontmatter last, because it is the only one of these that opens a file.
    # A markdown file without it is prose — a README, a design note — and
    # counting it would put every one of them on a listing of things to delete.
    has_frontmatter "$path" || continue
    OKF_CONCEPTS+=("$path")
  done
}

# ---------------------------------------------------------------------------
# The clock
# ---------------------------------------------------------------------------

# SPEC.md §3's tool list has no clock in it — no `date` — and that is a real
# constraint rather than an oversight: the preflight's promise is to name
# *exactly* what is missing, and it can only keep that promise about the tools
# it knows to look for. root_index_document is written around the constraint by
# stamping nothing at all. The two subcommands SPEC.md §7 gives a timestamp to
# — `check --stamp` and `verify` — cannot do that, so they own the problem, and
# this is where it is solved for both.
#
# Solved the way http_preflight solves curl's: the tool is demanded of the runs
# that reach for it and of no others, with a line saying why this run wants
# something `okf list` never mentions. `okf check` on a machine without `date`
# is a perfectly good `okf check`; only `--stamp` is not.
#
# `date` and not bash's own `printf '%(...)T'`, which would need no tool at all.
# That format needs bash 4.2 and macOS still ships 3.2 — this script is written
# for 3.2 throughout, and a stamp that silently stopped working on the oldest
# supported shell is worse than one dependency named out loud. It would also
# have to be coaxed into UTC through TZ, where `date -u` simply is UTC.
OKF_CLOCK_TOOLS=(date)

# Exits 1 naming `date` when it is not installed, saying which run wanted it.
require_clock() { # $1 = what needs the time, e.g. `check --stamp`
  require_tools " (needed only by $1, which records the instant it ran)" \
    "${OKF_CLOCK_TOOLS[@]}"
}

# The shape okf writes an instant in, and the only shape it will read one of its
# own back out of: SPEC.md §4's `stale_after: 2026-11-24T00:00:00Z` — ISO 8601,
# UTC, seconds, `Z`, and nothing optional about any of it.
#
# Fixed width with every varying field zero-padded is what makes two of these
# comparable as strings, which is the whole reason the shape is pinned rather
# than merely produced. Nothing here parses a date — SPEC.md §3 has no tool that
# could, and `date -d` is a GNU extension the preflight never promised — so
# "later than" is `[ "$a" \> "$b" ]` over two values this has vouched for, and a
# value of any other shape is one no comparison can be made against.
is_stamp_instant() { # $1 = a candidate timestamp
  case "$1" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z)
      return 0
      ;;
    *) return 1 ;;
  esac
}

# Now, as SPEC.md §4 spells an instant. Left in OKF_STAMP_INSTANT rather than
# printed, as file_digest leaves its digest: a caller stamping a hundred
# concepts takes the time once, and a `$(...)` per concept would be both a fork
# and a hundred slightly different answers to one question.
#
# `-u` so the answer is UTC whatever TZ says, because a `stale_after` is
# compared against instants written by other people on other machines and a
# local-time one is an hour wrong somewhere and thirteen hours wrong elsewhere.
#
# Checked rather than trusted, for file_digest's reason: what comes back is
# written into a concept and compared as a string for ever after. A `date` that
# printed a warning, or a format string that reached a `date` which does not
# understand it, would otherwise land in `stale_after` as a value no reader —
# okf's or OKF's — can do anything with.
OKF_STAMP_INSTANT=""
OKF_STAMP_ERROR=""
stamp_instant() {
  local now=""
  OKF_STAMP_INSTANT=""
  OKF_STAMP_ERROR=""

  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2> /dev/null)" || now=""
  if ! is_stamp_instant "$now"; then
    # Quoted back so the caller can see what it got instead — but only the
    # first line of it. warn() promises one `okf: `-prefixed line per message,
    # and a `date` that answered with a usage screen would otherwise put the
    # rest of that screen on stderr unprefixed, in among the findings, looking
    # like output from okf itself. The first line is the informative one in
    # every version of this that is worth reading.
    OKF_STAMP_ERROR="date -u did not print an ISO 8601 UTC instant: ${now%%$'\n'*}"
    return 1
  fi
  OKF_STAMP_INSTANT="$now"
  return 0
}

# ---------------------------------------------------------------------------
# The actor (SPEC.md §4)
# ---------------------------------------------------------------------------

# SPEC.md §4's actor vocabulary: `claude-code/<model>`, `ralph/<model>`,
# `human:<id>`, `process:<id>`. Whether a string is one of them, asked as a
# shape and not as a lookup — the identifier half is a model name, a username
# or a process name and okf has no register of any of those.
#
# It matters more than a spelling check. SPEC.md §8's trust rule turns entirely
# on the `human:` prefix — an entry by any other kind of actor leaves a concept
# Machine-confirmed — so `--by human/dcruver` is not a cosmetic slip: it is a
# review that silently does not count. Warned about rather than refused, because
# §4's list is OKF's vocabulary and a caller who has good reason to write
# something outside it is not making a mistake okf should be overruling.
is_actor_string() { # $1 = a candidate actor
  case "$1" in
    "human:"?* | "process:"?* | "claude-code/"?* | "ralph/"?*) return 0 ;;
    *) return 1 ;;
  esac
}

# The tool the default actor falls back to, on the runs that need it and no
# others — see require_clock for why that is how a tool outside SPEC.md §3's
# list is asked for at all. `id -un` and not `whoami`, which is the same answer
# from a command POSIX marks obsolete, and not `logname`, which answers for the
# login session and so comes back empty under cron, in a container and over
# anything that is not a terminal.
OKF_ACTOR_TOOLS=(id)

# Who okf records as having verified a concept when `--by` was not given:
# SPEC.md §4's `human:<id>`, with the id taken from the environment first and
# from `id -un` only when the environment says nothing.
#
# The environment first, deliberately. `$USER` is what the person running okf
# calls themselves and what every other tool reads — it is also the one an
# automated caller can set, which `id -un` is not — while `id -un` is the
# account the process happens to be running as. For a `human:` entry, which is
# a claim about *who reviewed this*, the first is the better answer and the
# second is the fallback for an environment that carries neither variable. A
# caller for whom neither is right has `--by`, which is what it is for.
#
# `${USER:-}` and not `$USER`: under `set -u` an unset variable is not an empty
# one, it is the end of the run.
OKF_ACTOR=""
OKF_ACTOR_ERROR=""
default_actor() {
  local name=""
  OKF_ACTOR=""
  OKF_ACTOR_ERROR=""

  name="${USER:-}"
  [ -n "$name" ] || name="${LOGNAME:-}"
  if [ -z "$name" ] && have_tool id; then
    # The first line of it, for stamp_instant's reason: an `id` that answered
    # with something other than a name would otherwise put the rest of that
    # answer into the concept.
    name="$(id -un 2> /dev/null)" || name=""
    name="${name%%$'\n'*}"
  fi
  # Whitespace off both ends, because an id with a space around it is the same
  # id and a value that needs quoting for it is one no reader compares equal.
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"

  if [ -z "$name" ]; then
    OKF_ACTOR_ERROR="there is no username to record: USER and LOGNAME are both unset"
    if ! have_tool id; then
      OKF_ACTOR_ERROR="$OKF_ACTOR_ERROR, and id is not installed"
    fi
    return 1
  fi

  OKF_ACTOR="human:$name"
  return 0
}

# ---------------------------------------------------------------------------
# Subcommands
#
# One function per SPEC.md §7 subcommand, each replaced by its real
# implementation as the PLAN.md checklist reaches it. The usage line above each
# stub is the contract that implementation owes.
# ---------------------------------------------------------------------------

# The document `okf init` writes, transcribed from SPEC.md §6 rather than
# assembled out of parts: every value in it is a decision made there, and one
# built up from variables here would let a default be changed without §6 moving
# with it. tests/toolkit.sh reads §6's own JSON block back out of SPEC.md and
# compares it against what init writes, so the two cannot drift apart unnoticed.
#
# §6's `index` block is the one thing deliberately left out, and leaving it out
# is what "opt-in" means. SPEC.md §1 calls Tier B opt-in, and §6 defines what
# happens without that block — Tier B subcommands exit 2 naming the missing
# keys — which is reachable only if a freshly initialised repo has not got one.
# Writing it here would instead point every new repo at a Qdrant on localhost
# nobody asked for, and leave nothing to opt into; §6 documents the block's
# defaults for whoever does.
OKF_DEFAULT_CONFIG='{
  "okf_version": "0.2",
  "bundle": {
    "root": ".",
    "include": ["src/**", "lib/**"],
    "exclude": ["**/target/**", "**/build/**", "**/node_modules/**", "**/dist/**"],
    "extensions": ["java", "ts", "tsx", "py", "rs", "go", "js", "mjs"]
  },
  "tiers": {
    "tier0_max_members": 2,
    "tier0_max_loc": 15,
    "tier2_min_fan_in": 8,
    "tier2_min_loc": 200
  }
}'

# One value, spelled as a YAML double-quoted scalar, left in OKF_YAML_QUOTED
# rather than printed so that building a document costs no subprocess per line.
#
# Quoting is not decoration here. Every value these documents carry is a
# directory basename or a path built out of one, and so is whatever the
# filesystem allowed: a `#`, a `:` or a leading `%` in it turns an unquoted
# YAML scalar into a comment, a mapping or a parse error. A double-quoted
# scalar is valid YAML for every one of those, and is how SPEC.md §4's own
# example spells `signature`.
#
# A backslash first and then the quote, in that order: escaping the quotes
# first would leave the backslashes this pass adds to be escaped a second time
# by the next one.
#
# Control characters last, and as YAML's own `\xNN`. A tab in a name would
# otherwise put a tab in the document, which SPEC.md §4's formatting contract
# rules out anywhere at all — the shell reads frontmatter with awk — and a
# newline would end the `title:` line halfway through and turn the rest of the
# name into a key of its own. Both are rare and neither is impossible: a name is
# whatever the filesystem allowed.
#
# Walked a character at a time only when there is a control character to find,
# which on every ordinary name is never: the scan below is one `case` against
# the whole value, and the loop is the slow path nothing normally takes.
OKF_YAML_QUOTED=""
yaml_quoted() { # $1 = the value to spell
  local value="${1//\\/\\\\}"
  value="${value//\"/\\\"}"

  case "$value" in
    *[[:cntrl:]]*) ;;
    *)
      OKF_YAML_QUOTED="$value"
      return 0
      ;;
  esac

  local out="" at ch
  for ((at = 0; at < ${#value}; at++)); do
    ch="${value:at:1}"
    case "$ch" in
      [[:cntrl:]]) out="$out\\x$(printf '%02x' "'$ch")" ;;
      *) out="$out$ch" ;;
    esac
  done
  OKF_YAML_QUOTED="$out"
}

# The bundle-root index.md `okf init` writes, per SPEC.md §4: the repo-root
# index.md is the bundle root, it is `type: Codebase`, and it is the **only**
# file in a bundle where `okf_version` is legal. Both facts are the reason this
# document exists at all — without it there is nowhere for the bundle to
# declare which OKF version it is written to.
#
# Written to the §4 formatting contract, which is load-bearing rather than
# cosmetic: `---` on line 1, a closing `---`, top-level keys unindented, no
# tabs and no folded scalars, because the shell reads frontmatter with awk.
#
# There is deliberately no `generated:` stamp. SPEC.md §3's tool list has no
# clock in it — no `date` — and the preflight's promise to name exactly what is
# missing only stays true of init if init uses nothing outside that list.
# `printf '%(...)T'` would need bash 4.2, and macOS still ships 3.2. A file with
# no timestamp is worth more than one with a wrong or unportable one; the
# subcommands that must stamp a time (`check --stamp`, `verify`) own that
# problem, and this file is not where it has to be solved.
root_index_document() { # $1 = the bundle's name, $2 = the okf_version it declares
  local name="$1" version="$2" quoted

  # Quoted, and escaped for quoting — see yaml_quoted for why the name cannot
  # be written bare.
  #
  # `okf_version` is quoted for the same reason SPEC.md §6 makes it a JSON
  # string: unquoted, YAML reads 0.2 as a float, and the next version but one
  # — 0.10 — is read as 0.1 and stops matching the okf.json it was copied from.
  # `type` and `status` are left bare: both are words out of a §4 vocabulary,
  # and nothing in either can be mistaken for a number.
  yaml_quoted "$name"
  quoted="$OKF_YAML_QUOTED"

  printf '%s\n' \
    '---' \
    'type: Codebase' \
    "title: \"$quoted\"" \
    "description: \"OKF bundle root for $quoted.\"" \
    "okf_version: \"$version\"" \
    'status: draft' \
    '---' \
    '' \
    "# $name" \
    '' \
    'The OKF bundle root for this repository. Every concept lives beside the source' \
    'it describes — `Greeter.py` is documented by `Greeter.md` in the same directory' \
    "— and each directory's own \`index.md\` lists what that directory holds." \
    '' \
    '- `okf list --missing` — in-scope sources with no concept yet' \
    '- `okf check` — concepts whose source has changed underneath them' \
    '- `okf index` — regenerate the per-directory `index.md` files'
}

# Decides, for every file `okf init` is about to write, whether writing it is
# allowed — before any of them is written.
#
# All-or-nothing on purpose. init writes two files, and a run that wrote the
# one that was missing and refused the one that was there would leave a
# half-initialised bundle behind an exit status that means both. Worse, the
# obvious way out of such a refusal is --force, and --force is what destroys
# the hand-written index.md that caused it. Refusing before anything is written
# leaves every file exactly as it was, so the caller can move theirs aside or
# merge it by hand and re-run.
#
# Every refusal init can foresee is decided here, over all of the targets and
# before any of them is written, so that none can be the thing that fails after
# another has already gone in. Only the plain "already exists" refusal
# aggregates its offenders: that list is precisely what --force would
# overwrite, and a caller deciding whether to type it needs to see all of it.
# The others each stop at the first — a symlink and a directory in the way have
# nothing to do with each other, and neither is answered by the other's remedy.
#
# What is left after this function returns is the write itself: a full disk, a
# read-only mount, an I/O error partway through. Those can still leave the
# first file written and the second not, which no check ahead of the write can
# foresee and no shell can undo without the temp-file-and-rename that SPEC.md
# §3's tool list rules out. The line printed then names the file that did not
# get written, which is the one a caller has to do something about.
#
# Existence is what the refusal turns on, not content: an okf.json somebody
# tuned by hand and one okf wrote itself a minute ago are the same file from
# here, and guessing wrong destroys the tuning. --force is the caller saying
# which of the two it is.
init_guard() { # $1 = 1 if --force was given, $2.. = absolute paths
  local force="$1" path
  shift

  # Symbolic links first, and refused whichever way --force went, because
  # neither thing --force could mean here is what the caller asked for. A
  # redirection writes *through* the link, so `okf init --force` would replace
  # a file somewhere else entirely — outside the repo, if that is where the
  # link points. Replacing the link instead would silently detach whoever put
  # it there on purpose. Saying so and stopping leaves the choice with the one
  # person who knows which they meant. Ahead of the existence check as well as
  # ahead of --force, so a linked file is diagnosed as a link rather than
  # buried in a list of things that are merely in the way.
  for path in "$@"; do
    if [ -L "$path" ]; then
      die "$(display_path "$path") is a symbolic link" \
        "okf init writes this repo's own file, not whatever the link points at" \
        "remove the link and re-run"
    fi
  done

  # Two names for one file, which the string comparison in cmd_init cannot see:
  # a hard link makes okf.json and index.md one inode, and init would then
  # write its two documents one on top of the other and report both as written.
  # After the symlink loop, so a link is still diagnosed as a link — `-ef`
  # follows one and would otherwise answer for its target.
  local -a rest=("$@")
  local other
  while [ "${#rest[@]}" -gt 1 ]; do
    path="${rest[0]}"
    rest=("${rest[@]:1}")
    for other in "${rest[@]}"; do
      # `-ef` is false unless both paths stat, so a file that is not there yet
      # needs no separate check.
      if [ "$path" -ef "$other" ]; then
        die "$(display_path "$path") and $(display_path "$other") are the same file" \
          "okf init writes a different document to each, and one file cannot hold both" \
          "they are two names for one inode — remove one and re-run"
      fi
    done
  done

  # A target that is not a regular file, refused whichever way --force went and
  # before anything is written. --force means "replace the file that is there",
  # and a directory, a fifo or a device is not a file a redirection can
  # replace: writing to it fails however many times it is tried. Caught here
  # rather than left to the redirection because that failure would arrive after
  # the *other* file had already been written, which is exactly the
  # half-initialised bundle this function exists to prevent. One line, because
  # naming the path and what is wrong with it is the whole of what a caller
  # needs to act.
  for path in "$@"; do
    if [ -e "$path" ] && [ ! -f "$path" ]; then
      die "$(display_path "$path") is not a regular file"
    fi
  done

  # Plain existence, which is the one refusal --force is allowed to overrule.
  # Aggregated rather than reported one at a time, because this list is exactly
  # what --force would overwrite, and a caller deciding whether to type it
  # needs to see all of it.
  if [ "$force" -eq 0 ]; then
    local -a existing=()
    for path in "$@"; do
      if [ -e "$path" ]; then
        existing+=("$(display_path "$path") already exists")
      fi
    done
    if [ "${#existing[@]}" -gt 0 ]; then
      if [ "${#existing[@]}" -eq 1 ]; then
        existing+=("re-run with --force to overwrite it")
      else
        # Said explicitly, because --force is one flag over both files and the
        # caller in front of this message usually wants only one of them: a
        # second config for CI, say, in a bundle whose index.md they wrote by
        # hand. Answering that with a bare "--force" would trade their index.md
        # for an okf.ci.json without ever having said so.
        existing+=("re-run with --force to overwrite them" \
          "--force overwrites every file okf init writes, so move aside any you mean to keep")
      fi
      die "${existing[@]}"
    fi
  fi

  # Permission, last, because it is the only one of these questions that is
  # worth asking about a file init has already decided it is going to write.
  # A read-only index.md is refused *here* and not by the redirection that
  # would hit it, which would only fail after okf.json had gone in — the
  # half-initialised bundle again, and this time from a cause that can be seen
  # in advance.
  #
  # `-w` is a question about this process, so it answers for the ordinary cases
  # — a read-only file, a directory nobody may write in — and not for a
  # read-only mount or an ACL that only the write itself will discover. Those
  # are why init_write still reports its own failures; this is why it rarely
  # has to.
  local dir
  for path in "$@"; do
    if [ -e "$path" ]; then
      [ -w "$path" ] || die "$(display_path "$path") is not writable"
      continue
    fi
    dir="${path%/*}"
    [ -n "$dir" ] || dir="/"
    [ -d "$dir" ] || die "cannot create $(display_path "$path"): no such directory: $dir"
    [ -w "$dir" ] || die "cannot create $(display_path "$path"): $dir is not writable"
  done
}

# Writes one of the files `okf init` is responsible for, init_guard having
# already decided that writing it is allowed.
#
# Nothing outside SPEC.md §3's tool list is used to do it — no mktemp, no mv —
# so that the preflight's promise to name exactly what is missing stays true of
# init as well. That rules out the write-elsewhere-then-rename trick, and the
# `set -C` below is what is left: it makes "is it already there?" and the
# creation a single step the filesystem takes, so a file that appeared between
# init_guard's look and this write cannot be silently clobbered by it.
init_write() { # $1 = absolute path, $2 = 1 if --force was given, $3 = content
  local path="$1" force="$2" content="$3" dir

  # ${path%/*} rather than dirname, for the reason above. An absolute path with
  # a single component — /okf.json — leaves this empty, and its directory is /.
  dir="${path%/*}"
  [ -n "$dir" ] || dir="/"
  [ -d "$dir" ] || die "cannot write $(display_path "$path"): no such directory: $dir"

  if [ "$force" -eq 1 ] && [ -e "$path" ]; then
    # This truncates at open, so a write that then fails — a full disk, a
    # quota — leaves neither the old file nor the new one. Accepted rather
    # than fixed: closing it needs the write-elsewhere-then-rename the
    # paragraph above rules out, and what is lost is a file --force was about
    # to replace anyway. The create path below has no such window, because
    # there is nothing there to truncate.
    #
    # stderr silenced for the same reason -C's cd is: what bash prints here
    # names a line number inside bin/okf, and it arrives ahead of the line
    # below that actually says which file the caller has to do something about.
    printf '%s\n' "$content" 2> /dev/null > "$path" \
      || die "cannot write $(display_path "$path")"
    return 0
  fi

  # Not `[ -e ] || create`: see above. A failure here is either that race or an
  # unwritable directory, and the message says the one thing true of both.
  (set -C && printf '%s\n' "$content" > "$path") 2> /dev/null \
    || die "cannot create $(display_path "$path")"
}

# okf init [--force] — write okf.json + the bundle-root index.md
cmd_init() {
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      # Twice is not an error: --force says overwrite, and saying it again says
      # the same thing.
      --force) force=1 ;;
      # The subcommand's own end-of-flags marker — parse_globals passes this
      # one through — after which init still takes no operands, so whatever
      # follows falls to the check below and is named there.
      --)
        shift
        break
        ;;
      -*) die "init: unknown flag: $1" "usage: okf init [--force]" ;;
      *) break ;;
    esac
    shift
  done

  # Checked before anything is written, so a mistyped line is answered rather
  # than acted on: `okf init --fore` is not an init that quietly skipped the
  # --force it was asked for.
  [ $# -eq 0 ] || die "init takes no arguments, but was given: $1" \
    "usage: okf init [--force]"

  # A self-check on the literal above, and the only reason it is worth a jq
  # invocation: an okf.json that does not parse is a repo where every later
  # subcommand fails at once, somewhere well away from the edit that caused it.
  printf '%s\n' "$OKF_DEFAULT_CONFIG" | jq empty > /dev/null 2>&1 \
    || die "the built-in default okf.json is not valid JSON — this is a bug in bin/okf"

  # Read back out of the default config rather than written twice: SPEC.md §6
  # settles the version in okf.json and §4 makes the bundle-root index.md the
  # only other file allowed to name one. Two literals could disagree, and a
  # bundle whose index.md and okf.json claim different OKF versions is a
  # question with no answer.
  local version
  version="$(printf '%s\n' "$OKF_DEFAULT_CONFIG" | jq -r '.okf_version // empty')"
  [ -n "$version" ] \
    || die "the built-in default okf.json declares no okf_version — this is a bug in bin/okf"

  # The bundle root is the repo root, which is what -C moves and --config does
  # not: --config says where the *settings* live — CI's okf.ci.json is still
  # this repo's settings — while SPEC.md §4 puts the bundle root index.md at
  # the root of the bundle itself and nowhere else.
  local index_path="$OKF_ROOT/index.md"

  # The bundle is named for the directory it is in. Empty only when the root is
  # `/`, which is then also its own best name.
  local name="${OKF_ROOT##*/}"
  [ -n "$name" ] || name="$OKF_ROOT"

  # --config can be pointed at the bundle root's own index.md, and then the two
  # documents init writes are two documents for one file: the second overwrites
  # the first, and the repo ends up with an index.md and no settings at all.
  # Caught before either is written, because with --force there is nothing
  # about the result to notice — both writes succeed, and `wrote index.md`
  # prints twice.
  if [ "$(canonical_path "$OKF_CONFIG")" = "$(canonical_path "$index_path")" ]; then
    die "--config names the bundle-root index.md: $(display_path "$index_path")" \
      "okf init writes both, and one file cannot be both"
  fi

  # $OKF_CONFIG, not the string okf.json: SPEC.md §7 gives every subcommand
  # --config PATH, and an init that wrote to a hard-coded name would be the one
  # subcommand that ignored where it was told the settings live. -C is honoured
  # for free, having already moved both the root and this path with it.
  init_guard "$force" "$OKF_CONFIG" "$index_path"

  # Each write reported as it happens, so that a second write failing on what
  # no check could foresee — a full disk, a read-only mount, an ACL — still
  # leaves the caller knowing the first file is there. Told only about the
  # failure, their obvious next move is to re-run, and the re-run refuses
  # because of the okf.json this one wrote; the way out of that looks like
  # --force, which is a much bigger hammer than the situation calls for.
  #
  # The refusals okf *can* foresee are all decided in init_guard above, before
  # any of this runs, so nothing routine prints a `wrote` line ahead of an
  # error.
  init_write "$OKF_CONFIG" "$force" "$OKF_DEFAULT_CONFIG"
  printf 'wrote %s\n' "$(display_path "$OKF_CONFIG")"

  init_write "$index_path" "$force" "$(root_index_document "$name" "$version")"
  printf 'wrote %s\n' "$(display_path "$index_path")"
  # Said here because this is the run that decided it: the config just written
  # has no `index` block, so Tier B is off until someone adds one. Left unsaid,
  # the first `okf search` looks like a broken install rather than a feature
  # that was never turned on.
  printf 'Tier B (chunk, embed, search) is opt-in: add an "index" block to %s to enable it.\n' \
    "$(display_path "$OKF_CONFIG")"
}

# okf list [--missing] [--orphans] — in-scope source files
cmd_list() {
  local missing=0 orphans=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --missing) missing=1 ;;
      --orphans) orphans=1 ;;
      --)
        shift
        break
        ;;
      -*)
        die "list: unknown flag: $1" "usage: okf list [--missing] [--orphans]"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -eq 0 ] || die "list takes no arguments, but was given: $1" \
    "usage: okf list [--missing] [--orphans]"

  # --missing narrows the source listing; --orphans replaces it with a listing
  # of concept files. Neither is a filter on the other, so there is no listing
  # that answers both — and picking one silently would hand back paths of the
  # wrong kind to a caller who cannot see which flag got dropped. Refused, with
  # both flags named, rather than ranked.
  if [ "$missing" -eq 1 ] && [ "$orphans" -eq 1 ]; then
    die "list: --missing and --orphans name different listings — sources, and concepts" \
      "give one or the other" \
      "usage: okf list [--missing] [--orphans]"
  fi

  local path
  if [ "$orphans" -eq 1 ]; then
    # SPEC.md §5's co-location read the other way round from --missing: not a
    # source with no concept beside it, but a concept whose source has gone.
    #
    # The concept's own `resource` decides it, not the sibling `<stem>.<ext>`
    # that has_concept looks for. §5 gives a file's *additional* top-level types
    # the spelling `<stem>.<TypeName>.md`, and no source is ever named
    # `RouteRegistry.Inner.<ext>` — so a listing built from the co-located name
    # would call every one of those an orphan while its source sat right beside
    # it. `resource` is where the concept says what it documents, and it is the
    # only thing here that survives §5's naming rules.
    #
    # A concept that declares no `resource` is left off, and so is one whose
    # `resource` this bundle does not answer for — see concept_resource, which
    # holds the whole of that reasoning because `okf check` asks the same
    # question of the same files. This listing is one a caller acts on by
    # deleting files: a wrong name on it costs a concept somebody wrote, where a
    # missing one costs a stale file that stays until `resource` is filled in.
    local resource
    load_concepts
    load_bundle_globs
    for path in ${OKF_CONCEPTS[@]+"${OKF_CONCEPTS[@]}"}; do
      # A concept that cannot be read at all is left off for the same reason:
      # load_concepts only put files carrying a closed frontmatter block on this
      # list, so a read that fails here is one the file stopped being readable
      # between the two — not a fact about what it documents.
      read_frontmatter "$path" || continue
      concept_resource "$path" "$OKF_FM_RESOURCE" || continue
      resource="$OKF_CONCEPT_RESOURCE"

      # `-e` and not `-f`: what is asked is whether anything is there under that
      # name, not whether it is something okf could go on to hash. A resource
      # replaced by a directory is a concept pointing at something broken, which
      # is a different complaint from the one this listing makes — and this is
      # the listing acted on by deleting files.
      [ ! -e "$resource" ] || continue
      printf '%s\n' "$path"
    done
    return 0
  fi

  load_in_scope

  # --missing narrows the same listing rather than producing another one, so the
  # order and the paths are the ones plain `okf list` prints. That is what makes
  # it the input /okf-generate walks: the sources with no concept beside them,
  # in the order the bundle holds them.
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    if [ "$missing" -eq 1 ] && has_concept "$path"; then
      continue
    fi
    printf '%s\n' "$path"
  done
}

# One file's `sha256:…` digest, left in OKF_FILE_DIGEST, returning 1 with the
# reason in OKF_FILE_DIGEST_ERROR when there is no digest to be had.
#
# Its own function rather than the body of cmd_hash because SPEC.md §8's drift
# rule is a comparison between two of these, and `okf check` computes one per
# concept in the bundle: a second transcription of the same three lines is a
# second chance to get the prefix or the validation subtly different, and the
# two would then disagree about whether a file had drifted — with `okf hash`
# printing the value a slash command goes on to store.
#
# The reason comes back in a variable rather than being printed, because the
# two callers do different things with it. `okf hash` was asked about one file
# and dies naming it; `okf check` was asked about a bundle, cannot answer for
# this one concept, and must still answer for the rest — SPEC.md §8 has plain
# `okf check` always exiting 0, so it warns and carries on.
OKF_FILE_DIGEST=""
OKF_FILE_DIGEST_ERROR=""
file_digest() { # $1 = a path to a regular, readable file
  local path="$1" digest
  OKF_FILE_DIGEST=""
  OKF_FILE_DIGEST_ERROR=""

  # Fed on stdin rather than named as an argument. sha256sum echoes the name it
  # was given beside the digest, and escapes one containing a backslash or a
  # newline by prefixing the whole line with `\` — so the digest is not reliably
  # where the first field is — while a name beginning with a dash would be read
  # as an option before the file was ever opened. Redirected in, there is no
  # name in the output to work around and none on the command line to be
  # misread, and the shell has already opened the file by the time sha256sum
  # runs.
  if ! digest="$(sha256sum < "$path")"; then
    OKF_FILE_DIGEST_ERROR="could not hash: $path"
    return 1
  fi
  digest="${digest%% *}"

  # Checked rather than trusted, because everything downstream of this compares
  # the string and never reads it: a truncated or decorated digest stored as a
  # `content_hash` would not look wrong in frontmatter, and would report drift
  # on every `okf check` from then on — against a file nobody had touched.
  case "$digest" in
    "" | *[!0-9a-f]*)
      OKF_FILE_DIGEST_ERROR="sha256sum did not print a digest for $path: $digest"
      return 1
      ;;
  esac
  if [ "${#digest}" -ne 64 ]; then
    OKF_FILE_DIGEST_ERROR="sha256sum printed ${#digest} hex characters for $path, not a sha256's 64: $digest"
    return 1
  fi

  # The `sha256:` prefix is part of the value and not a label on it — see
  # cmd_hash below — so it goes on here, where the digest is made, rather than
  # at each place one is printed or compared.
  OKF_FILE_DIGEST="sha256:$digest"
  return 0
}

# The shape SPEC.md §4 writes a `code.content_hash` in, and the shape
# file_digest produces: `sha256:` and 64 lowercase hex characters. Asked of a
# *stored* value, which okf did not write and cannot vouch for.
#
# A stored value of any other shape is not a digest this can compare against.
# Reporting it drifted would be a file named for editing that nobody had
# touched; ignoring it would leave a concept that can never be checked looking
# checked. Its callers say so instead, which is why this only answers the
# question and does not decide what to do about it.
#
# Lower case only, deliberately, and the reason is what the callers say rather
# than what they check: sha256sum prints lower case, `okf hash` prints what
# sha256sum printed, and SPEC.md §4's example is lower case — so the only value
# okf has ever written into this field is one this accepts. An upper-case digest
# is the same number spelled differently and is refused all the same, because
# case-folding it here would be okf inventing a second spelling of its own
# output. What it gets instead is the warning naming the spelling to restore,
# which is a line somebody can act on with `okf hash`.
is_content_hash() { # $1 = a stored code.content_hash value
  local hex="${1#sha256:}"
  [ "$hex" != "$1" ] || return 1
  [ "${#hex}" -eq 64 ] || return 1
  case "$hex" in
    *[!0-9a-f]*) return 1 ;;
  esac
  return 0
}

# okf hash <file> — sha256:… of one file
#
# The measuring half of SPEC.md §8's drift rule: a concept's `code.content_hash`
# is the sha256 of its `resource` as that file stood when the prose was written,
# and drift is that stored string differing from what this prints today. What
# comes out here is therefore a value that gets *stored* — written into
# frontmatter by a slash command, read back months later by an `okf check` that
# has nothing to go on but the two strings.
#
# Which is why the `sha256:` prefix is part of the answer and not a label on it.
# SPEC.md §4 writes the field as "sha256:9f2a…", so a bare hex digest written
# into it would be a stored value naming no algorithm at all, and the day okf
# grows a second one there would be no telling which had produced it.
#
# Nothing here reads okf.json, and nothing here reads git. A digest is a fact
# about one file's bytes rather than about the bundle, and every caller that has
# one to hash has already decided it is theirs to hash: `okf check` asks about a
# resource a concept named, and a scope test it had to pass first would refuse
# exactly the concept whose source has just moved out of `include` — the one
# where knowing whether it drifted matters most.
cmd_hash() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # End of flags. Past it a word beginning with a dash is the filename,
        # which is how a caller hashes a file that really is named `-weird.py`.
        shift
        break
        ;;
      -*)
        # The same hint parse_globals gives for a --config whose path begins
        # with a dash, because it is the same slip: a file can be named
        # anything, and nothing else here could tell the two apart.
        die "hash: unknown flag: $1" \
            "spell it ./$1, or put it after --, if that really is the file" \
            "usage: okf hash <file>"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -gt 0 ] || die "hash needs a file to hash" "usage: okf hash <file>"

  # One file and not a list. The output is a bare digest with nothing in it
  # naming what it is of, so a second path could only come back as a second
  # unlabelled line for the caller to match up by position — or be dropped in
  # silence, leaving them holding the first file's digest for the second file's
  # concept, which is a `content_hash` that is wrong rather than missing.
  [ $# -eq 1 ] || die "hash takes one file, but was given $#: $*" \
    "usage: okf hash <file>"

  local path="$1"

  if [ ! -e "$path" ]; then
    # SPEC.md §4 spells path-valued fields bundle-absolute — a leading `/` that
    # means the bundle root and not the filesystem's — so a `resource` read out
    # of a concept and handed straight to `okf hash` names a file that is almost
    # never there. The argument is read as a filesystem path all the same:
    # guessing between the two spellings would give `okf hash /etc/hosts` two
    # possible answers and no way for the caller to say which they meant. What
    # the guess is spent on instead is this line, which names the other
    # spelling without hashing anything.
    local rooted="${path#/}"
    if [ "$rooted" != "$path" ] && [ -e "$rooted" ]; then
      die "no such file: $path" \
        "paths are read as the filesystem's, not as SPEC.md §4's bundle-absolute form" \
        "did you mean $rooted ?"
    fi
    die "no such file: $path"
  fi

  # A directory is named as one rather than left to the regular-file line below,
  # because it is the answer to a plausible question — `okf hash src/util` from
  # someone expecting a digest of the tree — and "not a regular file" would read
  # as okf having failed to open something it could see.
  [ ! -d "$path" ] || die "hash takes a file, but $path is a directory"

  # -f and not -e for everything else: a fifo would hang here waiting on a
  # writer that is never coming, and a device would hand back bytes that are
  # nobody's file contents. A symlink to a regular file passes and hashes what
  # it points at, which is the file the caller named.
  [ -f "$path" ] || die "hash takes a regular file, but $path is not one"
  [ -r "$path" ] || die "cannot read: $path"

  # The digest, its validation and its `sha256:` prefix all live in file_digest,
  # which `okf check` uses to compute the other half of SPEC.md §8's comparison.
  # What is left here is the part that is this subcommand's own: a file okf was
  # asked about and could not hash is a failure, so the reason is printed and
  # okf exits 1 rather than printing a digest of nothing.
  file_digest "$path" || die "$OKF_FILE_DIGEST_ERROR"

  printf '%s\n' "$OKF_FILE_DIGEST"
}

# okf fanin <Name> — whole-word reference count across in-scope files
#
# SPEC.md §5's fan-in, and its caveat is part of the definition rather than a
# footnote on it: this is a ripgrep count of a *name*, so it counts the word in
# a comment, in a string literal and in an unrelated type that happens to share
# the name, and it misses every reference written through an alias or an import
# rename. §5 settles what that makes it — "a ranking signal for where
# documentation effort goes, never a correctness claim" — and settles the one
# repair anybody would reach for: a parser resolves references by name too, so
# adding one buys the same number with a compiler in front of it. Do not.
#
# What it is good for is the comparison. A name at 40 and a name at 1 differ by
# more than any of the above can explain, and SPEC.md §5's tier rules ask
# exactly that kind of question — `fan_in >= tier2_min_fan_in`, `exported with
# fan_in >= 4`. Between two names a few apart, the number is not evidence.
#
# Matches and not matching lines: two references on one line are two references,
# and a `Map<RouteKey, RouteKey>` counting once would make a line's layout part
# of the answer. `rg --count-matches` is the flag for it; plain `--count` is the
# line count and is the one thing here easy to reach for by mistake.
#
# One name per invocation, and so one `git ls-files` and one @Generated scan per
# name — which is what a caller asking about every type in the repo pays twice
# over. That is SPEC.md §7's surface and §7 is read-only, so it is not something
# to route around here: the fix is not a cache under `.okf/`, whose invalidation
# would be a second drift rule to get wrong, but a caller that asks once per
# type and reads the numbers it gets back. Said here so the cost is a known one.

# How many paths go to ripgrep at once, for the same reason as the generated
# scan's own batch: the argument list stays well inside any ARG_MAX, and a
# repository of ordinary size is still one invocation. Its own constant rather
# than a shared one, because the two scans are bounded by different things —
# that one by the per-batch membership test it does afterwards, this one by
# nothing but the argument list.
OKF_FANIN_BATCH=400

# Running total for count_batch_references, which cannot hand a number back
# through a command substitution: `die` inside one exits the subshell, and the
# caller reads a failed scan as an empty count and adds nothing to it.
OKF_FANIN_TOTAL=0

# Adds one batch's whole-word match count to OKF_FANIN_TOTAL.
count_batch_references() { # $1 = the name, $2.. = one batch of in-scope paths
  local name="$1"
  shift

  local -a records=()
  local record
  while IFS= read -r record; do
    records+=("$record")
  done < <(
    # ripgrep's status carried out in the stream, as the generated scan carries
    # its own: a process substitution's exit status is invisible to the shell
    # reading it, and a ripgrep that failed outright prints no counts at all —
    # which is indistinguishable from a batch nothing matched, and would report
    # a fan-in of 0 for a name referenced everywhere. `set +e` so the inherited
    # errexit does not act on the 1 that means "matched nothing", which is the
    # ordinary answer for most names in most batches.
    #
    # --no-filename is what makes this stream safe to read as lines: every
    # record is then a bare count, so no path — with a newline, a colon or a
    # backslash in it — is ever parsed back out of ripgrep's output.
    #
    # --case-sensitive and --fixed-strings are both spelled out. ripgrep already
    # defaults to the first, but the default is smart-case in some builds'
    # configuration files, and `RouteKey` matching `routekey` would silently
    # inflate every count; the second is what keeps a name from being read as a
    # pattern, so a `.` in a qualified name matches a dot and not any character.
    # --no-config turns off the file that could have changed either.
    #
    # --text because a source file with a stray NUL in it is still a file whose
    # references count, and binary detection would drop it from the total with
    # nothing said on stdout to show a file had been skipped.
    set +e
    rg --no-config --no-ignore --case-sensitive --fixed-strings --word-regexp \
      --text --count-matches --no-filename -e "$name" -- "$@"
    printf 'status:%s\n' "$?"
  )

  local count="${#records[@]}"
  [ "$count" -gt 0 ] \
    || die "the fan-in scan wrote nothing at all, not even its exit status"
  local status="${records[$((count - 1))]}"
  unset "records[$((count - 1))]"
  case "$status" in
    # Matched, or matched nothing. Anything else is a scan that did not happen,
    # and a scan that did not happen looks exactly like a name nobody
    # references — so it is said rather than added up. ripgrep's own message,
    # naming the file it could not read, has already gone to stderr.
    status:0 | status:1) ;;
    *)
      die "ripgrep could not count references to $name — see its message above" \
        "okf will not print a fan-in it could not finish counting"
      ;;
  esac

  for record in ${records[@]+"${records[@]}"}; do
    # Every record should be a bare count, so one that is not means ripgrep
    # printed something into this stream that --no-filename was supposed to keep
    # out. Adding it as 0 would leave a total that is quietly short.
    case "$record" in
      "" | *[!0-9]*)
        die "ripgrep printed something other than a count while counting $name: $record"
        ;;
    esac
    OKF_FANIN_TOTAL=$((OKF_FANIN_TOTAL + record))
  done
}

cmd_fanin() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # End of flags, as for `okf hash`. Past it a word beginning with a dash
        # is the name — which no type is called, but the escape hatch costs a
        # line and its absence would be a name okf could not be asked about.
        shift
        break
        ;;
      -*)
        die "fanin: unknown flag: $1" \
            "put it after --, if that really is the name" \
            "usage: okf fanin <Name>"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -gt 0 ] || die "fanin needs a name to count references to" \
    "usage: okf fanin <Name>"

  # One name and not a list, for the reason `okf hash` takes one file: the
  # output is a bare number with nothing in it naming what it counted, so a
  # second name could only come back as a second unlabelled line to be matched
  # up by position — or be dropped in silence, leaving the caller storing the
  # first name's fan-in on the second name's concept.
  [ $# -eq 1 ] || die "fanin takes one name, but was given $#: $*" \
    "usage: okf fanin <Name>"

  local name="$1"

  # An empty name is refused rather than counted. ripgrep reads the empty
  # pattern as a match at every position, so this would come back as a number
  # roughly the size of the repository — a fan-in that is not merely wrong but
  # wrong in the direction that promotes a concept to Tier 2.
  #
  # Whitespace goes with it, and a newline is the reason: ripgrep refuses a
  # literal newline outside multiline mode, so `okf fanin` would report a failed
  # scan for what is really a malformed name. The rest of the whitespace is
  # refused alongside it because it is the same mistake — a shell quoting slip,
  # or a `<Name>` pasted with its surroundings — and because `-w` around a space
  # counts word boundaries rather than references.
  case "$name" in
    "") die "fanin needs a name to count references to, and was given an empty one" \
          "usage: okf fanin <Name>" ;;
    *[[:space:]]*)
      die "fanin takes one name, and this one has whitespace in it: $name" \
          "a fan-in count is over a single whole word — check the quoting" \
          "usage: okf fanin <Name>"
      ;;
  esac

  load_in_scope

  # SPEC.md §5's "minus the declaration site", decided by co-location because
  # that is the only thing the shell has to decide it with: §5 puts a concept
  # beside its source as `<stem>.md`, so a type named `RouteRegistry` is
  # declared in a `RouteRegistry.<ext>` and its own file's mentions of itself —
  # the declaration, the constructors, its own javadoc — are not fan-in.
  #
  # The whole file goes rather than one line of it. What "the declaration site"
  # names is the place the type is defined, and subtracting a single occurrence
  # would leave a Java class's constructors counting as references to
  # themselves, so a big self-contained type would out-rank a small
  # widely-used one.
  #
  # One file, or none. Two in-scope files can bear the name as their stem —
  # `src/a/config.ts` and `src/b/config.ts`, `com/a/Result.java` and
  # `com/b/Result.java` — and then nothing here can say which of them declares
  # the name being counted, or whether either does. Dropping both would throw
  # away every reference they make as well as any declaration they hold, and a
  # widely-used name would come back under SPEC.md §5's `tier2_min_fan_in` for
  # having callers in like-named files. So an ambiguous stem excludes nothing
  # and the declarations stay in the count.
  #
  # Where it is still wrong, and in which direction, since neither is a thing to
  # find out from a number that comes back looking the same either way.
  #
  # High, when the file okf cannot spot as a declaration site keeps its own
  # declaration in: a language that does not name the file after the type —
  # `Core` in `core.py` — a second top-level type sharing a file, and the
  # ambiguous stem above. Each of those adds a handful to a name that is
  # under-referenced anyway.
  #
  # Low, in the one case a single stem match is not the declaration: `Widget`
  # declared in `src/index.ts` and referenced from `src/tests/Widget.ts` loses
  # that file's references. Nothing short of reading the source tells that file
  # from the declaring one — which is why SPEC.md §5 calls fan-in "a ranking
  # signal for where documentation effort goes, never a correctness claim", and
  # rules out the parser that would look like the fix. It is left as §5 defines
  # it, and named here so that a fan_in that reads low against
  # `tier2_min_fan_in` has somewhere to be explained rather than trusted.
  #
  # Between the two, ties break high: that is what the ambiguous-stem rule above
  # buys, and it is the cheap half. A name counted a little high costs a concept
  # more prose than it needed; a hot type counted low is a type nobody documents.
  local -a named=()
  local path base stem
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    base="${path##*/}"
    stem="${base%.*}"
    [ "$stem" = "$name" ] || continue
    named+=("$path")
  done

  local -a targets=()
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    if [ "${#named[@]}" -eq 1 ]; then
      base="${path##*/}"
      stem="${base%.*}"
      [ "$stem" != "$name" ] || continue
    fi
    targets+=("$path")
  done

  OKF_FANIN_TOTAL=0

  # No files left to search is 0 references and not an error: a bundle whose
  # only in-scope file is the one declaring this name is a real answer, and so
  # is a repository with nothing in scope yet. ripgrep given no paths at all
  # would read stdin instead, and hang.
  if [ "${#targets[@]}" -gt 0 ]; then
    local -a batch=()
    for path in "${targets[@]}"; do
      batch+=("$path")
      if [ "${#batch[@]}" -ge "$OKF_FANIN_BATCH" ]; then
        count_batch_references "$name" "${batch[@]}"
        batch=()
      fi
    done
    [ "${#batch[@]}" -eq 0 ] || count_batch_references "$name" "${batch[@]}"
  fi

  # One number and nothing else, so `fan_in=$(okf fanin RouteRegistry)` is the
  # whole of reading it and a threshold test is arithmetic on what comes back.
  printf '%d\n' "$OKF_FANIN_TOTAL"
}

# The in-scope sources for a caller that must not die when the walk cannot be
# made. Fills OKF_SOFT_IN_SCOPE and returns 0; returns 1 with it emptied when
# load_in_scope gave up, having already said on stderr why.
#
# `okf check` is the only caller, and SPEC.md §8 is the whole reason this
# exists. load_in_scope's last step is the one that opens files — the
# `@Generated` scan — and it refuses to guess when ripgrep cannot read one of
# them. That is right for `okf list`, whose entire answer is that listing:
# SPEC.md §7's exit 1, and nothing printed that would be read as a complete
# scope. It is not right for `okf check`, whose answer is three sets of which
# that walk decides one. One file somebody chmod'ed to 000 must not turn §8's
# "CI warns, never gates" into a non-zero status, and it must not take the drift
# report down with it — drift is computed from concepts and their own resources
# and has nothing to do with which sources are in scope.
#
# Degrading rather than dying is also the honest answer to what was asked. The
# question `missing:` answers is "which in-scope sources have no concept", and a
# run that cannot say which sources are in scope cannot answer it — so it says
# so, and answers the two questions it still can. Silently reporting the sources
# it did manage to walk would be the worst of the three: a short listing looks
# exactly like a well-documented repository.
#
# The walk runs in a subshell with its exit status carried back out as one more
# NUL record — load_tracked_paths' idiom, for the same reason it uses it: a
# process substitution's own status is invisible to the shell reading it. The
# `set +e` that lets that status be written is undone inside the inner subshell,
# because leaving errexit off would change what the walk itself does.
OKF_SOFT_IN_SCOPE=()
soft_load_in_scope() {
  local -a records=()
  local record
  while IFS= read -r -d '' record; do
    records+=("$record")
  done < <(
    set +e
    (
      set -euo pipefail
      load_in_scope
      # An empty scope must write no record at all: `printf '%s\0'` with no
      # arguments still runs its format once, and the empty string that came
      # back would be read out here as a source whose name is nothing.
      [ "${#OKF_IN_SCOPE[@]}" -eq 0 ] || printf '%s\0' "${OKF_IN_SCOPE[@]}"
    )
    printf 'status:%s\0' "$?"
  )

  OKF_SOFT_IN_SCOPE=()
  local count="${#records[@]}"
  # Not a bundle okf could not read but a subshell that did not run: the status
  # record is written unconditionally, so its absence is this script broken
  # rather than this repository being in some state. SPEC.md §7's exit 1, like
  # load_tracked_paths' own version of this line.
  [ "$count" -gt 0 ] \
    || die "the in-scope source walk wrote nothing at all, not even its exit status"
  local status="${records[$((count - 1))]}"
  unset "records[$((count - 1))]"
  [ "$status" = "status:0" ] || return 1

  OKF_SOFT_IN_SCOPE=(${records[@]+"${records[@]}"})
  return 0
}

# One JSON array of strings, built by jq rather than by quoting them here.
#
# The alternative — wrapping each element in `"` and escaping what has to be
# escaped — is a JSON encoder written in bash, and it would be wrong about the
# first path that contains a `"`, a backslash or a tab. jq is a hard requirement
# of every okf run (see OKF_REQUIRED_TOOLS), so there is nothing to weigh here:
# the tool that knows the grammar does the encoding.
#
# NUL is the separator because it is the one byte a path cannot contain, so the
# elements reach jq intact — a path with a newline in it is legal in git and in
# a POSIX filesystem, and any line-oriented hand-off would silently split one
# finding into two. `split` leaves a trailing empty element after the final
# separator, which `[:-1]` drops.
#
# The empty case is answered without jq at all, because `printf '%s\0'` with no
# arguments still runs its format once, and the lone NUL that came back would
# split into one empty string: an empty set reported as a finding whose path is
# nothing. soft_load_in_scope guards the same printf for the same reason.
json_string_array() { # $1.. = the elements
  if [ $# -eq 0 ]; then
    printf '[]'
    return 0
  fi
  printf '%s\0' "$@" | jq -Rs 'split("\u0000")[:-1]'
}

# SPEC.md §8's `--stamp`, one concept at a time: "writes the standard
# `stale_after` at the detection instant, so plain OKF consumers see the signal
# without understanding `code:`".
#
# The instant is written into `stale_after`, not an interval added to it, and
# that is the point of the sentence rather than a shortcut through it. A
# `stale_after` in the past is what every OKF reader already treats as stale —
# no extension, no `code.content_hash`, no okf — so setting it to the moment the
# drift was found is precisely how a bundle says "this concept is stale now" in
# the vocabulary OKF already has. A date some months out would say the opposite:
# that the concept is good until then, which is the one thing this run has just
# established is false.
#
#   0  a stale_after was written
#   1  it could not be, with the reason in OKF_FRONTMATTER_ERROR
#   2  there was nothing to write, and why that is not a failure is below
#
# Three statuses because the third case is common and is not a no-op that got
# away: a concept already carrying a `stale_after` at or before this instant is
# already saying what this run came to make it say, and the value already there
# is the *earlier* detection — which is the truer fact of the two. Rewriting it
# would move the moment this concept went stale forward to today, and would do
# it again on the next run, so a hook running `okf check --stamp` on every
# commit would produce a fresh diff every time over a bundle nobody had touched.
# SPEC.md §8's neighbouring rule about `verified` entries — "never stripped,
# they are historical facts" — is the same instinct applied to the other field.
#
# A `stale_after` this cannot compare against is overwritten rather than left
# alone, which is the opposite call and the right one for the opposite reason.
# A future instant is a concept claiming a freshness the drift has just ended; a
# value of some other shape is one nothing here can place in time at all, and
# leaving it would be a drifted concept still reading as fresh to the OKF
# consumers this whole flag exists for. Neither is a fact worth keeping over the
# one being written.
#
# **No `verified` entry is touched, and that is structural rather than
# promised.** write_frontmatter_field replaces exactly one line and copies every
# other byte of the concept out as it came in — see its own comment — and the
# line it is given here names `stale_after`. There is no path from this function
# to a list. The absent case inserts immediately above the closing `---`, which
# is after any `verified:` entries rather than among them: an unindented key is
# where that sequence ends, so the entries stay entries and stay every one of
# them. tests/toolkit.sh holds this to both halves.
# The reason a stamp was refused, for the caller to report. Its own variable
# rather than write_frontmatter_field's, because not every refusal below is
# that function's: the symlink is turned away before the writer is ever called.
OKF_STAMP_REFUSAL=""
stamp_concept() { # $1 = a drifted concept, $2 = the detection instant, $3 = its stored stale_after
  local concept="$1" now="$2" existing="$3"
  OKF_STAMP_REFUSAL=""

  if is_stamp_instant "$existing"; then
    # Not later than now, so the concept already reads as stale, and has done
    # since an instant this run has no business moving forward.
    [ "$existing" \> "$now" ] || return 2
  fi

  # A symbolic link, refused — init_guard's refusal, for init_guard's reason,
  # and it belongs here rather than in load_concepts because this is the only
  # place in okf that opens a concept for writing.
  #
  # A redirection writes *through* a link. `src/A.md -> /elsewhere/A.md` is a
  # tracked file to git, a concept to load_concepts and a perfectly ordinary
  # path to the writer, so a stamp would rewrite a file outside the work tree
  # and `git status` would have nothing to say about it. There is no reading of
  # `--stamp` under which that is what was asked for: the flag marks concepts in
  # this bundle stale, and whatever the link points at is not in it.
  #
  # Refused rather than skipped in silence, and refused as a *failure* — this is
  # a drifted concept that will never carry the signal `--stamp` exists to
  # write, and the repair is somebody's to make.
  #
  # Only the write is refused. The concept is still read, still compared and
  # still reported drifted, because none of that follows a link anywhere it
  # should not go: reading through one is reading the file git tracks.
  if [ -L "$concept" ]; then
    OKF_STAMP_REFUSAL="it is a symbolic link, and a stamp would write through it into whatever it points at"
    return 1
  fi

  if ! write_frontmatter_field "$concept" stale_after "$now"; then
    OKF_STAMP_REFUSAL="$OKF_FRONTMATTER_ERROR"
    return 1
  fi
  return 0
}

# okf check [--strict] [--stamp] [--json] — drift, missing and orphan concepts
#
# SPEC.md §8's drift rule, and nothing more than it: "stored `code.content_hash`
# differs from the current sha256 of `resource`". Computed on demand from the
# two files, with no cache under `.okf/` to invalidate — the whole point of
# storing a digest is that the comparison needs nothing else kept in step.
#
# Two promises SPEC.md §8 makes about plain `okf check`, both load-bearing:
#
#   * It never mutates a file. Not the concept, not the source, not a cache.
#     `--stamp` is the flag that writes, and it is a separate one precisely so
#     that the run a hook or a CI job makes on every commit cannot dirty a work
#     tree. There is exactly one place below that opens a file for writing —
#     the stamping loop after the concept walk — and it is reached only when
#     `--stamp` was asked for and only for concepts on the drifted list.
#   * It always exits 0. "CI warns, never gates" — drift is the ordinary state
#     of a repository between a refactor and the doc refresh that follows it,
#     and a check that failed the build for it would be turned off within a
#     week. `--strict` is the opt-in that exits 3.
#
#     Exiting 0 is about what the *check found*, not about okf being able to run
#     at all: a bundle okf cannot read — no git work tree, an okf.json that will
#     not parse — is SPEC.md §7's exit 1 like anywhere else, because that run
#     did not find no drift, it found nothing.
#
# One line per finding on stdout, `<kind>: <path>`, so a caller pipes it into
# `cut -d' ' -f2` or greps it by kind. Three kinds, because three different
# things go wrong between a bundle and its sources and each has its own repair:
#
#   * `drifted: <concept>` — the concept describes a version of its source that
#     is not the one on disk any more. Re-read the source, re-author the body.
#   * `missing: <source>` — an in-scope source with no concept beside it.
#     Write one; `/okf-generate` is what walks these.
#   * `orphan: <concept>` — a concept whose `resource` is gone. Delete the
#     concept, or correct the `resource` it names.
#
# The kind is on the line rather than implied by a section header because the
# three are paths of different kinds — two name concepts, one names a source —
# and a listing whose meaning depends on how far down it a line appears is one
# a filter destroys. The lines are still grouped by kind, because a reader
# works through one repair at a time and interleaving three of them helps
# nobody; but the grouping carries no meaning the label does not, so `grep
# '^orphan: '` gets the same answer whatever order they come out in.
#
# A clean bundle prints nothing at all, which is `okf list --orphans`'s
# convention and the one a warning should keep: something to read means
# something to do.
#
# `--stamp` is the one flag that writes, and it writes nothing but SPEC.md §8's
# `stale_after`, onto the `drifted:` set and onto nothing else. The other two
# kinds are deliberately outside it: a `missing:` finding has no concept to
# stamp, and an `orphan:`'s source is gone, so there is no version of it the
# concept could be stale against — its repair is a deletion or a corrected
# `resource`, and marking it stale would only add a second thing wrong with a
# file that is going away. What each stamp does and does not disturb is
# stamp_concept's, above.
#
# It changes nothing about the report. The same walk, the same findings on
# stdout, the same warnings on stderr — a stamped concept is still drifted, and
# still needs its body re-read against the source — so `--stamp` is a side
# effect on the bundle rather than a fourth kind of line, and `--stamp --json`
# is the same three sets as `--json`. What it does add is a status: a stamp that
# could not be written leaves the run at 1, because unlike everything else this
# subcommand warns about, that is okf failing to do what it was told rather than
# a fact about one file. See the return at the bottom.
#
# `--json` prints the same three sets as one document — `{"drifted": [...],
# "missing": [...], "orphan": [...]}` — keyed by the labels the plain report
# uses, so the two spellings cannot come to mean different things. It is a
# rendering of the finished report and nothing else: the same walk, the same
# warnings on stderr, the same exit status, so `--json --strict` is still 3 on
# drift. The one place the two shapes differ is the clean bundle, which prints
# nothing plainly and three empty arrays as JSON — see the emitting branch.
#
# Which concepts are walked is load_concepts', and so git's: a `.md` written and
# never added is not in the bundle yet. That is the same rule `okf list
# --orphans` follows and the same one that keeps gitignored files off `okf
# list` — scope is read out of git throughout — so the two subcommands cannot
# disagree about which concepts exist. It does mean a concept `/okf-generate`
# has just written is not compared until it is staged, which costs nothing in
# practice: a concept written from its source this minute stores that source's
# current digest and has no drift to find. `git add` is enough; no commit is
# needed.
#
# Which sources are walked for the missing set is the other rule, deliberately:
# it is has_concept's, which asks the filesystem. So each half of this report
# says exactly what the listing that already reports it says — `missing:` is
# `okf list --missing`'s output and `orphan:` is `okf list --orphans`'s — and a
# caller who runs both never sees the two disagree about the same file.
#
# That the two halves read different sets is the point rather than an oversight
# nobody got round to. Asking git's index for the missing set would report every
# concept `/okf-generate` had just written as still missing until somebody
# staged it, which is noise on the one listing whose whole use is "what is left
# to write". Asking the filesystem for the orphan set would put files git has
# never heard of on a listing acted on by deleting them. The difference between
# the two sets is git's index, and each side takes the rule that costs less when
# it is the wrong one.
cmd_check() {
  local strict=0 stamp=0 json=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --strict) strict=1 ;;
      --stamp) stamp=1 ;;
      --json) json=1 ;;
      --)
        shift
        break
        ;;
      -*)
        die "check: unknown flag: $1" \
          "usage: okf check [--strict] [--stamp] [--json]"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -eq 0 ] || die "check takes no arguments, but was given: $1" \
    "usage: okf check [--strict] [--stamp] [--json]"

  # The clock, demanded of the run that will need it and of no other — see
  # require_clock. Asked for here rather than at the first write, so that a
  # machine without `date` is told immediately: a `--stamp` that exited 0
  # because this particular bundle happened to have no drift in it would let
  # somebody install okf, watch it succeed, and meet the missing tool for the
  # first time on the run that finally had something to record.
  #
  # `--strict` and `--json` need nothing of the sort, and neither reaches
  # anything before the bottom of this function: one decides the status the run
  # comes back with, the other how the same three sets are spelled on stdout, so
  # everything between here and there is written as though neither flag were
  # there. `--stamp` is the one that is not like them, because it writes.
  [ "$stamp" -eq 0 ] || require_clock "check --stamp"

  load_bundle_globs
  load_concepts

  # Collected rather than printed as they are found, so the three kinds come out
  # grouped and the source walk below does not have to be threaded through the
  # concept walk above to keep them so. Nothing here is large: each set is
  # bounded by the bundle, and a report too big to hold in memory is a repository
  # nobody was going to work through a line at a time anyway.
  # drifted_stale is drifted's twin, appended to at the same statement and read
  # back by index: the `stale_after` each drifted concept already carried, kept
  # because `--stamp` has to know whether the concept is already marked stale
  # and read_frontmatter's variables hold only the concept last read. Taken as
  # the drift is found rather than by opening every drifted concept a second
  # time, which would be a second reading of a file that may have changed
  # between the two — and so a decision made about a version of the concept
  # this run never compared.
  local -a drifted=() drifted_stale=() missing=() orphans=()

  local concept resource stored
  for concept in ${OKF_CONCEPTS[@]+"${OKF_CONCEPTS[@]}"}; do
    # A concept that stopped being readable between load_concepts and here is
    # left off rather than reported: nothing was compared, so there is nothing
    # to say about whether it drifted.
    read_frontmatter "$concept" || continue

    # Which concepts this bundle answers for at all — see concept_resource. The
    # same rule `okf list --orphans` uses, deliberately: a concept inside a
    # nested bundle, or one whose `resource` is not co-located with it, is not
    # this run's to have an opinion about in any of the three directions.
    concept_resource "$concept" "$OKF_FM_RESOURCE" || continue
    resource="$OKF_CONCEPT_RESOURCE"

    # A resource that is not there is an orphan, and an orphan is not drift: the
    # repair is a different one — the concept goes, or its `resource` is
    # corrected — and reporting it as drift would send somebody to re-read a
    # file that does not exist. `-e` and not `-f`, so that this and `okf list
    # --orphans` agree on what "gone" means; a dangling symlink is gone to both.
    #
    # Asked before the stored hash below, and that order is the whole of whether
    # the two listings agree. `okf list --orphans` never looks at
    # `code.content_hash` — a concept is an orphan because of what happened to
    # its resource, not because of what it wrote down about it — so a check that
    # skipped hashless concepts first would report every hand-written concept's
    # deleted source on one listing and not the other. The concept whose source
    # is gone and which never stored a digest is precisely the one somebody
    # wrote by hand and then deleted the file for; it is the most orphaned
    # concept in the bundle, not the least.
    if [ ! -e "$resource" ]; then
      orphans+=("$concept")
      continue
    fi

    # No stored hash is not drift. A concept written by hand, or one a slash
    # command has not stamped yet, has never claimed to describe a particular
    # version of its source — and §8's rule is a comparison between two values,
    # not a demand that both exist. The concept still shows up as a draft to
    # whoever is reading `status`, and `okf verify` is what settles its trust.
    #
    # Everything past this line is about drift alone, so a concept that gets no
    # further has still been asked both of the other two questions.
    stored="$OKF_FM_CODE_CONTENT_HASH"
    [ -n "$stored" ] || continue

    # Present, but not something a sha256 can be taken of: a resource replaced
    # by a directory, or one that is a fifo — which would hang here waiting on a
    # writer that is never coming — or a device, whose bytes are nobody's file
    # contents. Neither listing would otherwise mention it: `--orphans` sees
    # something there and this run cannot read it, so it falls between the two
    # and the concept is never checked again.
    if [ ! -f "$resource" ]; then
      warn "$concept: $resource is not a regular file, so it cannot be checked for drift"
      continue
    fi

    # The stored value is checked for shape before it is compared, because the
    # comparison cannot tell a digest that differs from a value that was never a
    # digest. Both would print the same line, and the repair for the second one
    # — fix what is written in the concept — is not the repair the line implies.
    if ! is_content_hash "$stored"; then
      warn "$concept: code.content_hash is not \`sha256:\` and 64 lower-case hex characters, so there is nothing to compare it with: $stored" \
        "  restore it with: okf hash $resource"
      continue
    fi

    # Said out loud rather than skipped in silence, in both of the next two
    # cases. A source okf cannot hash is a concept that will never be reported
    # drifted again, and a check that quietly stops checking things is worse
    # than one that finds nothing. stderr, so it stays out of the listing a
    # caller is parsing, and the run still exits 0: this is a fact about one
    # file, not a finding about the bundle.
    if [ ! -r "$resource" ]; then
      warn "$concept: cannot read $resource, so it cannot be checked for drift"
      continue
    fi

    if ! file_digest "$resource"; then
      # file_digest's own reason, and not a paraphrase of it: a read that failed
      # part way through and a sha256sum that answered with something which was
      # not a digest are different things to go and look at, and only the first
      # is about the file. Passing the reason back in a variable is what that
      # function does it for.
      warn "$concept: $OKF_FILE_DIGEST_ERROR" \
        "  so it cannot be checked for drift"
      continue
    fi

    [ "$OKF_FILE_DIGEST" != "$stored" ] || continue
    drifted+=("$concept")
    drifted_stale+=("$OKF_FM_STALE_AFTER")
  done

  # SPEC.md §8's `--stamp`, carried out here: after the walk that found the
  # drift, so "the detection instant" is one instant for one run rather than a
  # clock read per concept — a run stamping two hundred concepts would otherwise
  # spread them over a minute and invite somebody to read an ordering into the
  # difference — and before the scope walk below, which can be the slow half and
  # has nothing to do with any of this.
  #
  # Nothing is stamped when there is no drift, including the clock, so a
  # `--stamp` over a clean bundle is byte for byte the run a plain `okf check`
  # would have been.
  local stamp_refused=0
  if [ "$stamp" -eq 1 ] && [ "${#drifted[@]}" -gt 0 ]; then
    if stamp_instant; then
      local now="$OKF_STAMP_INSTANT" rc=0 at=0
      for ((at = 0; at < ${#drifted[@]}; at++)); do
        rc=0
        stamp_concept "${drifted[at]}" "$now" "${drifted_stale[at]}" || rc=$?
        # 2 is stamp_concept's "already said so, earlier" and is not a failure;
        # 1 is a concept that could not be written, which is said out loud with
        # the writer's own reason — a frontmatter block it never closes, a
        # read-only file — rather than a paraphrase, because the two are
        # different things to go and look at.
        if [ "$rc" -eq 1 ]; then
          # The concept named first and the writer's reason on its own line
          # below, rather than folded into one: not every reason
          # write_frontmatter_field gives names the file it was working on, and
          # a warning about a concept has to say which concept whatever else it
          # says.
          #
          # "could not be stamped" and not "was left as it was", because those
          # are two different claims and only the refusal knows which one holds.
          # Almost every one leaves the concept untouched; the one that does not
          # — a write that failed part way through — says so itself, in the line
          # printed just below this one.
          warn "${drifted[at]}: could not be stamped" \
            "  $OKF_STAMP_REFUSAL"
          stamp_refused=$((stamp_refused + 1))
        fi
      done
    else
      # No usable clock, so none of them can be stamped and each would fail for
      # the same reason. Said once, with the count, rather than once per
      # concept.
      warn "$OKF_STAMP_ERROR" \
        "  so no stale_after was stamped on any of the ${#drifted[@]} drifted concepts"
      stamp_refused="${#drifted[@]}"
    fi
  fi

  # SPEC.md §5's co-location read the third way: an in-scope source with nothing
  # documenting it. has_concept holds the whole of what "beside it" means — the
  # stem rule, §4's reserved names, a `.md` source not being its own concept —
  # so that rule stays in one place and this report and `okf list --missing`
  # cannot come apart.
  #
  # `if !` rather than `has_concept "$path" && continue`, because that AND-list
  # is the last command in the loop body and a failing one is a status `set -e`
  # would take the whole run down on — on exactly the undocumented source this
  # loop exists to find.
  #
  # Walked last, and softly: see soft_load_in_scope. The two sets above are
  # already collected by the time this runs, so a scope okf cannot work out
  # costs this report the `missing:` lines and nothing else.
  # Whether the missing set is a set at all, kept because `--json` has to say so
  # and an empty array cannot. A run whose scope could not be worked out found
  # no undocumented sources in the same sense that an unopened book contains no
  # words, and the warning below that says as much goes to stderr — which is
  # exactly the stream a caller reading this report with `jq` has thrown away.
  local scoped=1

  local path
  if soft_load_in_scope; then
    for path in ${OKF_SOFT_IN_SCOPE[@]+"${OKF_SOFT_IN_SCOPE[@]}"}; do
      if ! has_concept "$path"; then
        missing+=("$path")
      fi
    done
  else
    scoped=0
    warn "the in-scope source listing could not be made — see the message above" \
      "  so no missing concepts are reported by this run" \
      "  drifted and orphan findings are unaffected: neither is read out of scope"
  fi

  # The same three sets, spelled either way. `--json` changes nothing about what
  # was walked, warned about or found — every line above this one runs
  # identically under both — so the flag is a rendering and not a second report,
  # and a caller can compare the two and find the same paths under the same
  # three names.
  #
  # One document, not one JSON object per finding: the sets are the answer, and
  # a stream of objects could not distinguish "no drift" from "the run stopped
  # before it got there".
  if [ "$json" -eq 1 ]; then
    # Emitted whatever was found, including over a bundle with nothing wrong
    # with it. The plain report's convention is the opposite — a clean bundle
    # prints nothing, because something to read has to mean something to do —
    # but that convention is for a person, and the empty output it produces is
    # not a JSON document. A caller who has asked for JSON is parsing what comes
    # back, and `jq` given nothing at all fails rather than reporting an empty
    # bundle.
    #
    # The keys are the three labels the plain report prints, spelled exactly the
    # same way, so `grep '^orphan: '` and `.orphan` name one set and not two
    # that drifted apart.
    #
    # `missing` is null rather than `[]` when scope could not be worked out.
    # They are different facts — "every in-scope source has a concept" against
    # "which sources are in scope could not be established" — and the first is
    # what a dashboard would light up green for. The other two keys are arrays
    # either way: neither is read out of scope, so both were answered.
    local missing_json="null"
    [ "$scoped" -eq 0 ] || missing_json="$(json_string_array ${missing[@]+"${missing[@]}"})"

    jq -n \
      --argjson drifted "$(json_string_array ${drifted[@]+"${drifted[@]}"})" \
      --argjson missing "$missing_json" \
      --argjson orphan "$(json_string_array ${orphans[@]+"${orphans[@]}"})" \
      '{drifted: $drifted, missing: $missing, orphan: $orphan}' \
      || die "the drift report could not be rendered as JSON"
  else
    # Grouped in the order the repairs are usually worked through: concepts that
    # describe their source wrongly, then sources described nowhere, then
    # concepts describing nothing at all. Within a group the bundle's own order,
    # which is git's, and so `okf list`'s. The JSON above keeps both orders, for
    # the same reason.
    local finding
    for finding in ${drifted[@]+"${drifted[@]}"}; do
      printf 'drifted: %s\n' "$finding"
    done
    for finding in ${missing[@]+"${missing[@]}"}; do
      printf 'missing: %s\n' "$finding"
    done
    for finding in ${orphans[@]+"${orphans[@]}"}; do
      printf 'orphan: %s\n' "$finding"
    done
  fi

  # SPEC.md §8's exit statuses, decided here and nowhere else. Explicit, and not
  # left to the loop's own status: the last thing the walk did was a comparison,
  # and under `set -e` a final concept that turned out not to have drifted would
  # otherwise be the status the whole run came back with.
  #
  # Plain `okf check` is 0 whatever it found — "CI warns, never gates" — and
  # every line above this one is printed identically either way, so `--strict`
  # is a status and not a second, sterner report.
  #
  # SPEC.md §7's 3 is `--strict` *and* drift. Nothing else is drift: a `missing:`
  # or an `orphan:` line leaves a `--strict` run at 0, because §8 defines drift
  # as one thing — a stored `code.content_hash` that differs from its resource's
  # current sha256 — and §7's table names that same finding. The two other kinds
  # would also make a hopeless gate: a repository part way through being written
  # up is nearly all `missing:`, so a job failing on those would fail from the
  # first commit until the last concept was authored and be switched off long
  # before it ever caught real drift. Drift is different in kind — it is a
  # concept that is actively wrong about the code beside it, and it appears
  # between one commit and the next rather than being the starting state.
  #
  # The warnings above do not reach here either, for the same reason they go to
  # stderr: a resource that cannot be hashed is a fact about one file, not a
  # finding about the bundle, and a `--strict` run that failed a build over a
  # fifo somebody left in a work tree would be gating on the wrong thing. Nor
  # does a scope that could not be worked out — that costs this report its
  # `missing:` lines, which are not what `--strict` answers for.
  # A `--stamp` that could not stamp is the one thing in this subcommand that
  # is not a finding and not a fact about one file: it is okf failing to do
  # what it was asked, which is SPEC.md §7's 1. Silence and a 0 there would
  # leave a hook, or the caller who typed it, believing a signal had been
  # written into concepts that do not carry it.
  #
  # Ahead of `--strict`'s 3, because the two say different kinds of thing and
  # only one of them can be said. 3 is "this bundle has drift in it", which a
  # caller opted into gating on and which the listing above has already told
  # them; 1 is "and I could not record it", which nothing else in this run
  # reports. A gate reading 3 still fails on 1, so nothing is let through by
  # preferring the news.
  if [ "$stamp_refused" -gt 0 ]; then
    return 1
  fi

  if [ "$strict" -eq 1 ] && [ "${#drifted[@]}" -gt 0 ]; then
    return 3
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Per-directory indexes (SPEC.md §4)
# ---------------------------------------------------------------------------

# The line that separates what a person wrote in the bundle-root index.md from
# what `okf index` regenerates underneath it. Everything from this line to the
# end of that file belongs to okf; everything above it is left exactly as it
# was found.
#
# Only the bundle root has one, and that asymmetry is the whole design of this
# subcommand. SPEC.md §4 gives the root index.md an identity that cannot be
# derived from the file tree — `type: Codebase`, and the bundle's only legal
# `okf_version` — so okf index is not entitled to author it and does not try:
# it appends its listing below the marker and copies the rest through byte for
# byte, which is what leaves that `okf_version` intact in the strongest sense
# available. A per-directory `type: Package` index is the opposite: it is
# nothing but a listing of what is in that directory, every word of it
# derivable, so okf index writes the whole document and says so in the document
# itself.
#
# An HTML comment because that is the one thing markdown renders as nothing at
# all, and a marker a reader has to look at is one they will eventually delete.
OKF_INDEX_MARKER="<!-- okf index -->"

# The directories `okf index` writes an index.md into, and the order it writes
# them in: the bundle root first, then every directory holding a concept and
# every ancestor of one, each outermost-first and otherwise in git's order —
# which is the order `okf list` and `okf check` report in.
OKF_INDEX_DIRS=()

# The concepts those indexes list. load_concepts' set, less anything under an
# `exclude` glob — see cmd_index for why `include` is not applied here.
OKF_INDEX_CONCEPTS=()

# A directory, as this section spells one: `.` for the bundle root, and a
# bundle-relative path with no trailing slash for every other. One spelling
# throughout, because "the root" turns up as the empty string, as `.` and as a
# path in three different quarters of a shell script and a comparison between
# two of those spellings silently answers no.
OKF_DIR_PARENT=""
dir_parent() { # $1 = a directory
  case "$1" in
    # The bundle root has no parent inside the bundle. Deliberately not `.`,
    # which would make the root its own parent and list it as a subdirectory of
    # itself.
    .) OKF_DIR_PARENT="" ;;
    */*) OKF_DIR_PARENT="${1%/*}" ;;
    *) OKF_DIR_PARENT="." ;;
  esac
}

# Whether a directory is already in a list.
#
# Linear, and deliberately so. bash 3.2 — still what macOS ships, and what this
# script is written for throughout — has no associative arrays, and the obvious
# alternative is `sort -u` over a newline-separated list, which would split a
# path containing a newline into two directories that do not exist. git allows
# such a path; this cannot. The lists are bounded by the number of directories
# in one bundle, so the cost is not the kind anyone notices.
dir_listed() { # $1 = a directory, $2.. = the list so far
  local wanted="$1" seen
  shift
  for seen in ${1+"$@"}; do
    [ "$seen" != "$wanted" ] || return 0
  done
  return 1
}

# Adds a directory and every one of its ancestors to OKF_INDEX_DIRS, outermost
# first, skipping any already there.
#
# The ancestors are what keeps the link graph whole. A concept in
# `src/core/util` earns that directory an index.md, and if `src/core` and `src`
# had none the only way to reach it would be to already know it was there —
# which is the one thing an index exists to spare a reader.
#
# Walked child-to-parent and replayed in reverse, because a chain built the
# other way round would need to ask "does this directory hold a concept?" of
# every directory between the root and this one, and the answer for the ones in
# between is exactly what is not known yet.
add_index_dir() { # $1 = a directory
  local dir="$1"
  local -a chain=()

  while ! dir_listed "$dir" ${OKF_INDEX_DIRS[@]+"${OKF_INDEX_DIRS[@]}"}; do
    chain=("$dir" ${chain[@]+"${chain[@]}"})
    case "$dir" in
      # The root is where the walk stops: it is in the list before the first
      # concept is looked at, so this is reached only when the list was empty.
      .) break ;;
      */*) dir="${dir%/*}" ;;
      *) dir="." ;;
    esac
  done

  [ "${#chain[@]}" -eq 0 ] || OKF_INDEX_DIRS+=("${chain[@]}")
}

# One markdown link, `[text](target)`, left in OKF_INDEX_LINK.
#
# Both halves are escaped, because both are file names and a file name is
# whatever the filesystem allowed. An unescaped `]` in the text ends the link
# early and leaves the rest of the name as prose; an unescaped space or `(` in
# the target ends the target early and leaves a link pointing at nothing. The
# whole point of this listing is that its links resolve, so a name nobody
# expected must not be the thing that breaks them.
#
# The target takes CommonMark's angle-bracket form when it holds a character
# the bare form cannot carry, and the bare form otherwise — `<>` around every
# link would be correct and would also make every one of these files harder to
# read than the directory listing it replaces.
#
# What the bare form cannot carry is CommonMark's own list: a space, an ASCII
# control character, or an unbalanced parenthesis. Whitespace and control
# characters are tested as classes rather than as the space alone, because a
# tab in a file name truncates a bare destination exactly as a space does and
# is the one a reader proof-reading the file would never see.
OKF_INDEX_LINK=""
index_link() { # $1 = the link text, $2 = the bundle-absolute target
  local text="${1//\\/\\\\}" target="${2//\\/\\\\}"
  text="${text//\[/\\[}"
  text="${text//\]/\\]}"

  # The backslash is doubled above, before either form is chosen, because both
  # of them read one as an escape: a directory called `we\_ird` written bare
  # links to `/src/we_ird/index.md`, which is not a path anything in this
  # bundle answers to.
  case "$target" in
    *[[:space:][:cntrl:]\(\)\<\>]*)
      # Inside `<...>` only `<` and `>` still need escaping on top of that; a
      # space or a parenthesis is ordinary there, which is the reason for this
      # form.
      target="${target//</\\<}"
      target="${target//>/\\>}"
      target="<$target>"
      ;;
  esac

  OKF_INDEX_LINK="[$text]($target)"
}

# The bundle-absolute path of a directory's own index.md — SPEC.md §4's
# leading-slash form, which OKF recommends because it survives a file move.
index_target() { # $1 = a directory
  case "$1" in
    .) printf '%s\n' "/index.md" ;;
    *) printf '%s\n' "/$1/index.md" ;;
  esac
}

# The two listing sections for one directory: the concepts it holds and the
# subdirectories that have an index of their own. Printed, because this is
# built once per directory rather than once per line.
#
# A section with nothing in it is left out entirely rather than printed empty.
# A heading with no list under it reads as a listing that failed, and the fact
# it would be conveying — this directory documents nothing yet — is already
# what `okf list --missing` is for.
#
# Only directories that are in OKF_INDEX_DIRS are listed as subdirectories, so
# every link written here has a file at the other end of it. A directory
# holding sources and no concepts gets no index and so is not linked: there is
# nothing to point at, and a link into a listing that does not exist is worse
# than no link at all.
index_sections() { # $1 = a directory
  local dir="$1" concept child base
  local -a concepts=() subdirs=()

  for concept in ${OKF_INDEX_CONCEPTS[@]+"${OKF_INDEX_CONCEPTS[@]}"}; do
    case "$concept" in
      */*) [ "${concept%/*}" = "$dir" ] || continue ;;
      *) [ "$dir" = "." ] || continue ;;
    esac
    concepts+=("$concept")
  done

  for child in ${OKF_INDEX_DIRS[@]+"${OKF_INDEX_DIRS[@]}"}; do
    dir_parent "$child"
    [ "$OKF_DIR_PARENT" = "$dir" ] || continue
    subdirs+=("$child")
  done

  if [ "${#concepts[@]}" -gt 0 ]; then
    printf '\n## Concepts\n\n'
    for concept in "${concepts[@]}"; do
      base="${concept##*/}"
      # The text is SPEC.md §5's concept ID last component — the bundle-relative
      # path minus `.md` — and the target is the file itself. The two are the
      # same fact spelled for two readers: a person following the link, and a
      # tool resolving it.
      index_link "${base%.md}" "/$concept"
      printf -- '- %s\n' "$OKF_INDEX_LINK"
    done
  fi

  if [ "${#subdirs[@]}" -gt 0 ]; then
    printf '\n## Subdirectories\n\n'
    for child in "${subdirs[@]}"; do
      index_link "${child##*/}" "$(index_target "$child")"
      printf -- '- %s\n' "$OKF_INDEX_LINK"
    done
  fi
}

# A per-directory index.md, whole: SPEC.md §4's `type: Package`, and a body
# that is the listing and nothing else.
#
# No `okf_version` anywhere in it, and not by omission — §4 makes the bundle
# root the only file where that key is legal, so a Package index carrying one
# would be a second answer to a question the bundle has one answer to. This
# function is the only thing that writes a non-root index.md, which is what
# makes that a property of the code rather than a rule someone has to remember.
#
# Written to §4's formatting contract for the reason every writer here is: the
# shell reads frontmatter with awk, so `---` on line 1, a closing `---`,
# top-level keys unindented, no tabs and no folded scalars.
#
# `status: draft` because nothing has reviewed it — SPEC.md §8's trust rules
# are about `verified` entries, and a file okf regenerates on demand is never
# going to carry one. There is no `generated:` stamp, for the reason
# root_index_document has none: SPEC.md §3's tool list has no clock in it, and
# a document with no timestamp is worth more than one with an unportable one.
package_index_document() { # $1 = a directory
  local dir="$1" name quoted

  name="${dir##*/}"
  yaml_quoted "$name"
  quoted="$OKF_YAML_QUOTED"
  local description
  yaml_quoted "OKF package index for /$dir."
  description="$OKF_YAML_QUOTED"

  printf '%s\n' \
    '---' \
    'type: Package' \
    "title: \"$quoted\"" \
    "description: \"$description\"" \
    'status: draft' \
    '---' \
    '' \
    "# $name" \
    '' \
    "What the bundle documents under \`/$dir\`." \
    '' \
    'Regenerated in full by `okf index`, so anything written into this file by' \
    'hand is overwritten on the next run.'

  index_sections "$dir"
}

# Everything above OKF_INDEX_MARKER in an existing bundle-root index.md, with
# its trailing blank lines removed, left in OKF_INDEX_HEAD. Returns 1 when
# there is no such file to read, which is the caller's cue to author one.
#
# The whole file when it carries no marker: a root index.md that predates this
# subcommand — the one `okf init` writes, or one somebody wrote themselves — is
# all head, and its listing gets appended below it on this run and regenerated
# in place on every run after.
#
# Read line by line rather than with `cat`, for the reason usage() prints with
# printf: SPEC.md §3's preflight can only promise to name exactly what is
# missing about the tools it knows to look for, and `cat` is not one of them.
#
# CRLF and a UTF-8 BOM are stripped from the *comparison* and not from the
# line, which is the difference that matters: a root index.md written on
# Windows keeps its line endings through a regeneration, and its marker is
# still recognised as one.
OKF_INDEX_HEAD=""
index_head() { # $1 = a path
  local path="$1" line probe
  OKF_INDEX_HEAD=""

  [ -f "$path" ] && [ -r "$path" ] || return 1

  local -a lines=()
  # `|| [ -n "$line" ]` so a last line with no newline after it is still read.
  while IFS= read -r line || [ -n "$line" ]; do
    probe="${line#$'\xef\xbb\xbf'}"
    probe="${probe%$'\r'}"
    [ "$probe" != "$OKF_INDEX_MARKER" ] || break
    lines+=("$line")
  done 2> /dev/null < "$path"

  # Trailing blank lines dropped, because the marker is written back with
  # exactly one blank line in front of it. Left in, each run would add another
  # and the file would grow a line every time nothing at all had changed.
  local count="${#lines[@]}"
  while [ "$count" -gt 0 ]; do
    probe="${lines[$((count - 1))]}"
    probe="${probe%$'\r'}"
    [ -z "$probe" ] || break
    count=$((count - 1))
  done

  local at=0
  for ((at = 0; at < count; at++)); do
    OKF_INDEX_HEAD="$OKF_INDEX_HEAD${lines[at]}"$'\n'
  done
  # The final newline comes off so that what is left composes like every other
  # `$(...)` in this script: a document is its lines, and the newline after the
  # last of them belongs to whatever writes it out.
  OKF_INDEX_HEAD="${OKF_INDEX_HEAD%$'\n'}"
  return 0
}

# The bundle-root index.md, whole: the head above the marker exactly as it was
# found, then the marker, then this run's listing.
#
# Authored from scratch only when there is no file to preserve, and then it is
# `okf init`'s own document — the same function, so the two cannot come apart
# and a bundle initialised by either route declares the same OKF version in the
# same words.
root_index_regenerated() { # $1 = the bundle's name, $2 = the okf_version to declare if authoring
  if index_head "index.md"; then
    printf '%s\n' "$OKF_INDEX_HEAD"
  else
    root_index_document "$1" "$2"
  fi
  printf '\n%s\n' "$OKF_INDEX_MARKER"
  index_sections "."
}

# Whether a file already holds exactly the document about to be written to it.
#
# Asked so that a regeneration that changes nothing writes nothing: an `okf
# index` run over an up-to-date bundle should leave the work tree as clean as
# it found it, and rewriting identical bytes would put every index.md in the
# repository into `git status` and into whatever watches the tree for changes.
#
# Compared line by line, which is a comparison of what the document says rather
# than of its bytes: a file whose last line has no newline after it reads the
# same here as one properly terminated, and is left alone. That is the right
# answer — there is nothing to regenerate — and the wrong one costs a rewrite
# nobody sees.
index_unchanged() { # $1 = a path, $2 = the document
  local path="$1" want="$2" line existing=""

  [ -f "$path" ] && [ -r "$path" ] || return 1

  while IFS= read -r line || [ -n "$line" ]; do
    existing="$existing$line"$'\n'
  done 2> /dev/null < "$path"

  [ "$existing" = "$want"$'\n' ]
}

# Writes one index.md, if it needs writing. Returns 0 when it wrote, 2 when the
# file was already the document, and 1 when it refused or could not — having
# said why.
#
# Refusals are per file rather than per run. A bundle with one unwritable
# directory in it is a bundle whose other twenty indexes are still worth
# regenerating, and the caller counts what was refused and comes back with
# SPEC.md §7's 1 at the end.
#
# A symbolic link is refused whichever way it points, for the reason init_guard
# refuses one: a redirection writes *through* the link, so a regeneration would
# replace a file somewhere else entirely — outside the repository, if that is
# where the link goes. Replacing the link instead would silently detach whoever
# put it there on purpose, and neither is what "regenerate this directory's
# index" asked for.
index_write() { # $1 = a path, $2 = the document
  local path="$1" content="$2"

  if [ -L "$path" ]; then
    warn "$path is a symbolic link, so it was left alone" \
      "  okf index writes this directory's own index, not whatever the link points at"
    return 1
  fi
  if [ -e "$path" ] && [ ! -f "$path" ]; then
    warn "$path is not a regular file, so it was left alone"
    return 1
  fi

  index_unchanged "$path" "$content" && return 2

  # stderr silenced for the reason init_write silences it: what bash prints
  # here names a line number inside bin/okf, and it arrives ahead of the line
  # that actually says which file the caller has to do something about.
  printf '%s\n' "$content" 2> /dev/null > "$path" || {
    warn "cannot write $path"
    return 1
  }
  return 0
}

# okf index — regenerate the per-directory index.md files
cmd_index() {
  while [ $# -gt 0 ]; do
    case "$1" in
      # The subcommand's own end-of-flags marker — parse_globals passes this
      # one through — after which index still takes no operands, so whatever
      # follows falls to the check below and is named there.
      --)
        shift
        break
        ;;
      -*) die "index: unknown flag: $1" "usage: okf index" ;;
      *) break ;;
    esac
    shift
  done

  # SPEC.md §7 gives index neither a flag nor an argument, and a mistyped one
  # is answered rather than acted on: `okf index --frce` is not a run that
  # quietly regenerated every index.md in the bundle.
  [ $# -eq 0 ] || die "index takes no arguments, but was given: $1" \
    "usage: okf index"

  load_bundle_globs
  load_concepts

  OKF_INDEX_CONCEPTS=()
  OKF_INDEX_DIRS=()
  # The bundle root is indexed whatever the bundle holds, and is first in the
  # list so that add_index_dir's walk always terminates on a directory that is
  # already there. A bundle with no concepts in it still has a root, and a root
  # index.md that stopped existing because the last concept was deleted would
  # take the bundle's `okf_version` with it.
  add_index_dir "."

  # One pass over the index, in git's order — the order `okf list` and `okf
  # check` report in, and so the order every listing here comes out in. Two
  # things are picked out of it, and picking them out together is what keeps
  # that one order: walked separately, a directory found only by the second
  # walk would be appended after every directory found by the first, and a
  # parent's `## Subdirectories` would reshuffle on the run where an unrelated
  # concept happened to be deleted.
  local ci=0 ccount="${#OKF_CONCEPTS[@]}" tracked dir is_concept
  for tracked in ${OKF_TRACKED[@]+"${OKF_TRACKED[@]}"}; do
    # load_concepts builds OKF_CONCEPTS by walking this same list and appending,
    # so it is a subsequence of it in the same order and a cursor is enough to
    # say whether this path is one — no search, and no second reading of every
    # markdown file in the repository to find out. Advanced here, ahead of every
    # reason this path might be passed over, because a cursor that stopped
    # moving would stop recognising every concept after the one it stuck on.
    is_concept=0
    if [ "$ci" -lt "$ccount" ] && [ "${OKF_CONCEPTS[ci]}" = "$tracked" ]; then
      ci=$((ci + 1))
      is_concept=1
    fi

    # Whether this path is one the index would have anything to say about. A
    # concept is listed; an index.md earns its directory a listing of its own,
    # for the reasons below. Everything else in the repository — the sources
    # themselves, okf.json, a README — is not indexed and is passed over here
    # rather than half-considered below. SPEC.md §4's reserved names keep an
    # index.md out of OKF_CONCEPTS, so the two cases cannot both hold.
    if [ "$is_concept" -eq 0 ]; then
      case "$tracked" in
        index.md | */index.md) ;;
        *) continue ;;
      esac
    fi

    # A path with a line ending in it cannot be written into either half of this
    # listing: markdown has no spelling for a link destination that spans two
    # lines, in the bare form or in `<...>`, and a `- [name](target)` broken
    # across two is not a link at all. Left out, and said out loud, rather than
    # written as something that looks like a link and is not — an index whose
    # links resolve is the whole of what this subcommand is for.
    #
    # Warned about and not counted as a refusal, which is the line `okf check`
    # draws for a source it cannot hash: this is a fact about one path, not okf
    # failing to do what it was asked with the bundle.
    #
    # Line endings alone. A tab is awkward and perfectly spellable — index_link
    # puts the destination in `<...>` and yaml_quoted writes `\x09` — so
    # refusing one would drop a documented directory out of the bundle for
    # nothing.
    case "$tracked" in
      *[$'\n'$'\r']*)
        warn "a path with a line ending in it cannot be written as a markdown link, so it is left out of the index:" \
          "  $tracked"
        continue
        ;;
    esac

    # `exclude` is applied and `include` is not, and the asymmetry is
    # deliberate. SPEC.md §6's `include` says which *sources* are in scope to be
    # documented — under the defaults, `src/**` and `lib/**` — while SPEC.md §4
    # puts the higher-order concepts under `docs/`, which no default `include`
    # reaches. Filtered by `include`, a bundle's Playbooks and Architecture
    # Decisions would be linked from nowhere at all. `exclude` is the other
    # thing: it names trees that are not part of the bundle in any direction —
    # `node_modules`, `vendor`, a build output — and a concept found in one of
    # those is not this bundle's to list.
    if matches_any "$tracked" ${OKF_EXCLUDE_RES[@]+"${OKF_EXCLUDE_RES[@]}"}; then
      continue
    fi

    if [ "$is_concept" -eq 1 ]; then
      OKF_INDEX_CONCEPTS+=("$tracked")
      case "$tracked" in
        */*) dir="${tracked%/*}" ;;
        *) dir="." ;;
      esac
      add_index_dir "$dir"
      continue
    fi

    # An index.md earns its directory a place in the walk whether or not that
    # directory still holds a concept, and this is what makes a deletion
    # regenerate rather than rot. A directory whose last concept is removed
    # drops out of the concept half above, and left there its index.md would
    # keep a link to the file that just went — a dangling link, in the one
    # document whose whole purpose is that its links resolve — while no longer
    # being linked from its own parent, because the parent stopped listing a
    # directory that had nothing to list. Adopted here, it is regenerated into
    # an index with nothing in it, its ancestors keep pointing at it, and the
    # day somebody deletes the file it stays deleted.
    #
    # From the index rather than from the filesystem, so this reads the bundle
    # the same way everything else in okf does — and so an index.md okf itself
    # wrote a moment ago and nobody has committed does not make its directory
    # permanent.
    #
    # Gone from the working tree is nothing to regenerate and nothing to link:
    # `git ls-files` answers from the index, which still holds a file deleted
    # and not yet staged as removed.
    [ -f "$tracked" ] || continue
    case "$tracked" in
      index.md) dir="." ;;
      *) dir="${tracked%/index.md}" ;;
    esac
    add_index_dir "$dir"
  done

  # Only wanted when there is no bundle-root index.md to preserve, and read out
  # of the settings for the same reason `okf init` reads it out of the defaults:
  # SPEC.md §6 settles the version in okf.json and §4 makes the root index.md
  # the only other file allowed to name one, so the two had better be the same
  # number. A root index.md that is already there declares whatever it declares
  # and this run does not look — that value is the bundle's own, and copying the
  # head through untouched is what leaves it intact.
  local version=""
  version="$(printf '%s\n' "$OKF_SETTINGS" | jq -r '.okf_version // empty')" || version=""

  local name="${OKF_ROOT##*/}"
  [ -n "$name" ] || name="$OKF_ROOT"

  local refused=0 rc path content remedy
  for dir in "${OKF_INDEX_DIRS[@]}"; do
    if [ "$dir" = "." ]; then
      path="index.md"
      remedy="  write the bundle root with: okf init --force"
    else
      path="$dir/index.md"
      remedy="  move it aside and re-run, and okf index will write this directory's listing there"
    fi

    # A file under one of SPEC.md §4's reserved names that is not an OKF
    # document — an empty file, a block that opens and is never closed,
    # somebody's own landing page — is one okf index will not write over.
    #
    # Refused rather than replaced because there is no way back from the
    # replacement and no flag to ask for it: SPEC.md §7 gives index neither a
    # --force nor anything else, and a run that silently overwrote a page
    # somebody wrote would be discovered by them and not by okf. Refused rather
    # than preserved, too, at least at the root: appending a listing to it
    # would leave the bundle rooted in a document with no `type: Codebase` and
    # no `okf_version`, which is SPEC.md §4's bundle root in name only.
    #
    # Said out loud, counted, and then the rest of the bundle is regenerated
    # regardless — one document okf may not write is no reason to leave twenty
    # directories without a listing.
    #
    # `-L` first, so a symlinked index is diagnosed as the link it is by
    # index_write rather than answered for by whatever it points at.
    if [ ! -L "$path" ] && [ -f "$path" ] && ! has_frontmatter "$path"; then
      warn "$path carries no OKF frontmatter, so it was left alone" \
        "  SPEC.md §4 reserves index.md for the bundle's own document, and this file is not one" \
        "$remedy"
      refused=$((refused + 1))
      continue
    fi

    if [ "$dir" = "." ]; then
      if [ ! -f "$path" ] && [ -z "$version" ]; then
        # Authoring the root document needs a version and there is none to be
        # had: `okf.json` names none and there is no index.md to take one from.
        # Said once and skipped, rather than written with an empty value — SPEC
        # §4's one legal `okf_version` spelled as nothing at all is worse than
        # the file not being there, because the second is visibly unfinished.
        warn "no okf_version to declare, so the bundle-root index.md was not written" \
          "  add one to $(display_path "$OKF_CONFIG"), or run okf init"
        refused=$((refused + 1))
        continue
      fi
      content="$(root_index_regenerated "$name" "$version")"
    else
      content="$(package_index_document "$dir")"
    fi

    rc=0
    index_write "$path" "$content" || rc=$?
    case "$rc" in
      # Reported as it happens and one line per file, which is the convention
      # `okf init` prints in. Nothing is printed for a file that was already
      # the document it would have been written: an `okf index` over an
      # up-to-date bundle prints nothing at all, for the reason a clean `okf
      # check` does — something to read has to mean something to do.
      0) printf 'wrote %s\n' "$path" ;;
      2) ;;
      *) refused=$((refused + 1)) ;;
    esac
  done

  # SPEC.md §7's 1: okf was asked to regenerate the bundle's indexes and some
  # of them are not regenerated. Silence and a 0 would leave a hook, or the
  # caller who typed it, believing a listing had been written that is not
  # there. Every refusal has already said which file and why.
  [ "$refused" -eq 0 ] || return 1
  return 0
}

# ---------------------------------------------------------------------------
# Trust (SPEC.md §8)
# ---------------------------------------------------------------------------

# Whether one concept has drifted, as SPEC.md §8 defines it: 0 for drifted, 1
# for not, 2 for a comparison this run could not make — with the reason for
# that third answer left in OKF_DRIFT_REASON.
#
# Three answers and not two, because the caller has to be able to tell "the
# stored digest and the source's disagree" from "there is no digest to
# disagree with". `okf check` makes the same distinction and spends it on
# whether to print a `drifted:` line or a warning; the trust tier below spends
# it on whether it may say Human-reviewed, which is a claim that has to be
# earned rather than defaulted into.
#
# What is *not* drift is drawn exactly where cmd_check draws it, so the two
# cannot come apart: a concept with no stored hash has never claimed to
# describe a particular version of its source, and a resource that is gone is
# an orphan, whose repair is a different one.
#
# The resource is located from the concept rather than from the bundle root.
# SPEC.md §4 spells `resource` bundle-absolute and §5 puts a concept beside the
# source it documents, so between them the file is the resource's own name in
# the concept's own directory — which is the file cmd_check resolves from the
# root, and is still the right file when the concept was named by an absolute
# path or from outside the root. `okf verify` accepts both, and `okf check`,
# which walks a bundle it has already entered, never has to.
OKF_DRIFT_REASON=""
concept_drift() { # $1 = a concept path, $2 = its `resource`, $3 = its `code.content_hash`
  local concept="$1" resource="$2" stored="$3"
  local res="" res_dir="" base="" dir="" path=""
  OKF_DRIFT_REASON=""

  # cmd_check's "no stored hash is not drift", and its reason: §8's rule is a
  # comparison between two values rather than a demand that both exist.
  [ -n "$stored" ] || return 1

  if [ -z "$resource" ]; then
    OKF_DRIFT_REASON="it stores a code.content_hash but names no resource to compare it against"
    return 2
  fi

  res="${resource#/}"
  case "$res" in
    "" | */)
      OKF_DRIFT_REASON="its resource names a directory rather than a file: $resource"
      return 2
      ;;
    */*)
      res_dir="${res%/*}"
      base="${res##*/}"
      ;;
    *) base="$res" ;;
  esac

  dir="${concept%/*}"
  [ "$dir" != "$concept" ] || dir=""
  # A concept directly under `/`, whose directory the strip above leaves empty
  # when it is in fact the filesystem root.
  case "$concept" in
    /?*) [ -n "$dir" ] || dir="/" ;;
  esac

  # §5's co-location, asked of the two paths as they are spelled: the resource's
  # directory has to be the tail of the concept's. `src/route` satisfies it for
  # a concept named `src/route/X.md`, for `./src/route/X.md` and for
  # `/tmp/bundle/src/route/X.md` alike, and nothing else does — a `resource`
  # pointing into another directory is a concept this cannot pick a file for,
  # and hashing the co-located file anyway would be reporting on a source the
  # concept never named.
  #
  # Compared with `=` and a quoted suffix strip rather than with a `case`
  # pattern, because a directory name carrying a `*` or a `[` would be a glob
  # there and would match directories it does not name.
  if [ -z "$res_dir" ]; then
    # At the bundle root, so the concept must be too: `` and `.` are how a
    # root-level concept is spelled relative to the root okf entered, and
    # OKF_ROOT is how the same file is spelled absolutely.
    if [ -n "$dir" ] && [ "$dir" != "." ] && [ "$dir" != "$OKF_ROOT" ]; then
      OKF_DRIFT_REASON="its resource does not sit beside it, so okf cannot tell which file to hash: $resource"
      return 2
    fi
  elif [ "$dir" != "$res_dir" ] && [ "${dir%"/$res_dir"}" = "$dir" ]; then
    OKF_DRIFT_REASON="its resource does not sit beside it, so okf cannot tell which file to hash: $resource"
    return 2
  fi

  case "$dir" in
    "") path="$base" ;;
    /) path="/$base" ;;
    *) path="$dir/$base" ;;
  esac

  # `-e` and not `-f`, so this and `okf list --orphans` agree on what "gone"
  # means: a dangling symlink is gone to both.
  if [ ! -e "$path" ]; then
    OKF_DRIFT_REASON="its resource is gone: $resource"
    return 2
  fi
  if [ ! -f "$path" ]; then
    OKF_DRIFT_REASON="its resource is not a regular file, so it cannot be hashed: $resource"
    return 2
  fi
  # Shape before comparison, cmd_check's order and its reason: a comparison
  # cannot tell a digest that differs from a value that was never a digest.
  if ! is_content_hash "$stored"; then
    OKF_DRIFT_REASON="its code.content_hash is not \`sha256:\` and 64 lower-case hex characters, so there is nothing to compare it with: $stored"
    return 2
  fi
  if [ ! -r "$path" ]; then
    OKF_DRIFT_REASON="its resource cannot be read, so it cannot be hashed: $resource"
    return 2
  fi
  if ! file_digest "$path"; then
    OKF_DRIFT_REASON="$OKF_FILE_DIGEST_ERROR"
    return 2
  fi

  [ "$OKF_FILE_DIGEST" != "$stored" ] || return 1
  return 0
}

# SPEC.md §8's trust tier for one concept, left in OKF_TRUST_TIER: `Unverified`,
# `Machine-confirmed` or `Human-reviewed`, spelled as §8 spells them. Returns 1
# — with the tier empty — when the concept could not be read at all, because a
# file okf cannot read is not a concept it can grade.
#
# §8's rule, in its own words: "no `verified` → Unverified; verified only by
# non-`human:` actors → Machine-confirmed; a `human:<id>` entry →
# Human-reviewed, but only if that entry's `at >= generated.at` and the concept
# is not drifted. Otherwise it degrades to Machine-confirmed."
#
# Read as: Human-reviewed is a claim that one particular entry earns, so it is
# asked of each `human:` entry in turn and granted if any one of them earns it.
# A concept whose most recent human review predates a regeneration is not
# rescued by that — but nor is it condemned by it when an earlier human entry
# does not, which is why this is a question about entries rather than about the
# newest one.
#
# Two readings §8 does not spell out, both decided towards saying less rather
# than more:
#
#   * **No `generated.at` at all.** There is no instant for the entry to
#     predate, so the timestamp half of the rule has nothing to say and the
#     entry is not degraded by it. A concept that never recorded when it was
#     written is not thereby evidence that the review came first.
#   * **A `generated.at` or an `at` that is not an instant okf can compare.**
#     A claim exists and cannot be checked, so the entry does not earn
#     Human-reviewed and OKF_TRUST_NOTE says why. Nothing here parses a date —
#     see is_stamp_instant — so "cannot compare" is a shape and not a failure.
#
# OKF_TRUST_NOTE is set only when the answer is worth explaining: a human review
# that did not count, or a Human-reviewed granted without drift having been
# ruled out. A concept with no human entry at all is Machine-confirmed for the
# plainest of reasons and gets no note, because a line explaining every ordinary
# outcome is one nobody reads.
OKF_TRUST_TIER=""
OKF_TRUST_NOTE=""
concept_trust_tier() { # $1 = a concept path
  local concept="$1"
  local generated_at="" at="" by="" i=0 human=0 earned=0 rc=0 note=""

  OKF_TRUST_TIER=""
  OKF_TRUST_NOTE=""

  read_frontmatter "$concept" || return 1

  # Entries and not instants: an entry written with no `at:` leaves nothing in
  # OKF_FM_VERIFIED_AT, and a concept whose only entry is that one has still
  # been verified by somebody. It cannot earn Human-reviewed — there is no
  # instant to compare — but §8's first question is answered, and the answer is
  # not Unverified.
  if [ "$OKF_FM_VERIFIED_COUNT" -eq 0 ]; then
    OKF_TRUST_TIER="Unverified"
    return 0
  fi

  generated_at="$OKF_FM_GENERATED_AT"
  for ((i = 0; i < ${#OKF_FM_VERIFIED_AT[@]}; i++)); do
    # `:-` so a reader that ever left the two arrays different lengths is a bug
    # to find rather than an aborted run: under `set -u` an unset element ends
    # the whole invocation, on a line that only wanted to know who signed.
    by="${OKF_FM_VERIFIED_BY[i]:-}"
    case "$by" in
      "human:"?*) ;;
      # §8's second tier exactly: `process:`, `claude-code/` and `ralph/` are
      # confirmations by a machine, and SPEC.md §11 rules out one of them
      # writing an entry here at all.
      *) continue ;;
    esac
    human=1
    at="${OKF_FM_VERIFIED_AT[i]}"

    if [ -n "$generated_at" ]; then
      if ! is_stamp_instant "$generated_at"; then
        note="generated.at is not an ISO 8601 UTC instant, so okf cannot tell whether the review by $by came after it: $generated_at"
        continue
      fi
      if ! is_stamp_instant "$at"; then
        note="the verified entry by $by is not stamped with an ISO 8601 UTC instant, so okf cannot tell whether it came after generated.at: $at"
        continue
      fi
      if [ "$at" \< "$generated_at" ]; then
        note="the review by $by at $at predates generated.at $generated_at, so it is not a review of the prose this concept now carries"
        continue
      fi
    fi

    earned=1
    break
  done

  if [ "$human" -eq 0 ] || [ "$earned" -eq 0 ]; then
    OKF_TRUST_TIER="Machine-confirmed"
    OKF_TRUST_NOTE="$note"
    return 0
  fi

  # A human review no older than the prose it reviewed. Drift is the last thing
  # standing between it and Human-reviewed — and the only one that reads a file
  # off the disk, which is why it is asked here rather than above: a concept
  # nobody has humanly reviewed is Machine-confirmed whatever its source says.
  rc=0
  concept_drift "$concept" "$OKF_FM_RESOURCE" "$OKF_FM_CODE_CONTENT_HASH" || rc=$?
  case "$rc" in
    0)
      OKF_TRUST_TIER="Machine-confirmed"
      OKF_TRUST_NOTE="the concept has drifted: $OKF_FM_RESOURCE no longer hashes to the code.content_hash it stores"
      ;;
    2)
      # Drift is a comparison that was made and came out unequal — cmd_check's
      # rule, and the reason `okf check` reports these as warnings rather than
      # as findings. So a comparison that could not be made is not drift, and
      # the tier stands; the note is what stops that from being a silent claim.
      OKF_TRUST_TIER="Human-reviewed"
      OKF_TRUST_NOTE="$OKF_DRIFT_REASON, so this run could not rule out drift"
      ;;
    *) OKF_TRUST_TIER="Human-reviewed" ;;
  esac
  return 0
}

# The `<concept>` operand, resolved to the path of a file that is actually
# there, in OKF_CONCEPT. Dies with the reason when there is no such concept.
#
# Shared by every subcommand that names one concept, because the refusals are
# the useful half of this and a second copy of them is a second place for the
# "did you mean" to go quietly out of date.
# SPEC.md §5's concept ID for a concept file: "the bundle-relative path minus
# `.md`, so concept ID, file path, and link target are the same fact". Left in
# OKF_CONCEPT_ID.
#
# Worked out from where the file *is* rather than from how the caller spelled
# it, because the spelling is not the caller's answer to anything: `okf chunk
# src/Router.md`, `okf chunk ./src/Router.md` and `okf chunk
# /tmp/repo/src/Router.md` all name one concept from one root, and an ID taken
# from the argument would be three. SPEC.md §9 builds the Qdrant point ID out of
# `{repo}|{concept_id}|{chunk_kind}|{symbol}` precisely "so upserts are
# idempotent and deletes targeted" — three IDs for one concept is three points
# for one concept, and a delete that clears none of them.
#
# The root itself does move the ID, and has to: `-C src` says the bundle root is
# `src`, and §5's "bundle-relative path" is relative to whatever the bundle root
# is. That is a different bundle, not a different spelling of this one, and §9's
# `{repo}` is the field that keeps two bundles' IDs apart. What this function
# rules out is one root answering two ways.
#
# The bundle root is the repo root: load_settings refuses any other
# `bundle.root` outright, and says so.
#
# Both sides are resolved with `pwd -P`, physically, so the comparison cannot
# turn on which of `pwd` and `pwd -P` each side happened to be built with — a
# symlinked directory component is exactly how one file comes to have two
# absolute paths, and OKF_ROOT is the logical one.
OKF_CONCEPT_ID=""
concept_id_of() { # $1 = a path to a concept file
  local path="$1" dir base root relative

  dir="${path%/*}"
  if [ "$dir" = "$path" ]; then
    dir="."
  elif [ -z "$dir" ]; then
    dir="/"
  fi
  base="${path##*/}"

  # CDPATH cleared and stderr silenced for the reasons every other cd here is.
  dir="$(CDPATH= cd -- "$dir" 2> /dev/null && pwd -P)" \
    || die "cannot resolve the directory holding $path"
  root="$(CDPATH= cd -- "$OKF_ROOT" 2> /dev/null && pwd -P)" \
    || die "cannot resolve the repo root: $OKF_ROOT"

  # The root with exactly one trailing slash, which is what makes "below the
  # root" a prefix test. Spelled out rather than written `"$root"/*` inline
  # because a root of `/` would make that pattern `//*`, which matches nothing
  # under it — and every concept in the bundle would be refused as outside it.
  local prefix="$root"
  [ "$prefix" = "/" ] || prefix="$root/"

  if [ "$dir" = "$root" ]; then
    relative="$base"
  else
    case "$dir" in
      "$prefix"*) relative="${dir#"$prefix"}/$base" ;;
      *)
        # Outside the bundle, so §5's "bundle-relative path" does not exist for
        # it. Refused rather than answered with a `../` or an absolute path,
        # neither of which is an ID: it would name a concept this bundle does
        # not contain, and it would name it differently from every other root
        # the same file could be reached from.
        die "$path is outside the bundle" \
          "SPEC.md §5 makes a concept ID the bundle-relative path minus .md," \
          "and a file above the root has no such path" \
          "the root this run is using is $(display_path "$OKF_ROOT")" \
          "use -C DIR to run against the root that concept belongs to"
        ;;
    esac
  fi

  OKF_CONCEPT_ID="${relative%.md}"
}

OKF_CONCEPT=""
resolve_concept() { # $1 = the subcommand asking, $2 = the operand as typed
  local sub="$1" given="$2"
  OKF_CONCEPT=""

  if [ -f "$given" ]; then
    # The path as typed, which is `<concept>.md` and also the way a `drifted:`
    # line from `okf check` spells it.
    OKF_CONCEPT="$given"
    return 0
  fi
  if [ -f "$given.md" ]; then
    # SPEC.md §5's concept ID: the bundle-relative path minus `.md`.
    OKF_CONCEPT="$given.md"
    return 0
  fi

  # SPEC.md §4 spells path-valued fields bundle-absolute — a leading `/` that
  # means the bundle root and not the filesystem's — so a `resource` or a
  # link target handed straight to this names a file that is almost never
  # there. cmd_hash's line, for cmd_hash's reason: the argument stays a
  # filesystem path, and the guess is spent on naming the other spelling
  # rather than on quietly acting for it.
  local rooted="${given#/}"
  if [ "$rooted" != "$given" ] && { [ -f "$rooted" ] || [ -f "$rooted.md" ]; }; then
    die "no such concept: $given" \
      "paths are read as the filesystem's, not as SPEC.md §4's bundle-absolute form" \
      "did you mean $rooted ?"
  fi
  if [ -e "$given" ]; then
    # There, and not a regular file: a directory named like a concept, or a
    # device. "No such concept" would read as okf having failed to see
    # something the caller can see perfectly well.
    die "$sub takes a concept file, but $given is not a regular file"
  fi
  die "no such concept: $given" \
    "a concept is a markdown file carrying SPEC.md §4 frontmatter, named <concept>.md"
}

# okf verify <concept> [--by ACTOR] — append a verified entry
#
# SPEC.md §8's trust half, written the only way a shell script honestly can: okf
# does not review anything. What it records is that somebody says they did, at
# an instant, and the record is a `verified` entry in SPEC.md §4's own shape.
# Everything that decides what the entry is worth — SPEC.md §8's trust tiers —
# is read back out of the concept afterwards, by whoever is asking.
#
# The actor defaults to `human:` and the current username, because the caller
# who typed this is the person who did the reviewing. `--by` is for the other
# cases §4's vocabulary names: `process:okf/0.2` for something automated,
# `claude-code/<model>` for a slash command that read the source. SPEC.md §11
# rules out one of them explicitly — ralph-authored prose never gets a verified
# entry at all, because unattended regeneration is safe precisely because it
# cannot forge review — and that is a rule about who runs this, not one this
# subcommand can enforce.
#
# Entries accumulate, and are never merged or replaced: see
# append_verified_entry, and SPEC.md §8's "verified entries are never stripped.
# They are historical facts."
#
# `<concept>` is SPEC.md §5's concept ID — the bundle-relative path minus `.md`
# — and the path itself is accepted too, since §5's whole point is that the two
# are the same fact. `okf verify src/route/RouteRegistry` and `okf verify
# src/route/RouteRegistry.md` are one invocation, which is what lets a caller
# pipe `okf check`'s own `drifted:` lines back in without editing them.
#
# Nothing here reads git. A concept is a file with §4 frontmatter in it, and
# `okf verify` on one that was written a second ago and not staged yet is a
# perfectly good verify — `okf check`'s reasons for asking git which concepts
# exist are about walking a bundle, and this walks nothing. The path is the
# caller's own; the only thing that has to be true of it is that it is a
# concept.
cmd_verify() {
  local usage="usage: okf verify <concept> [--by ACTOR]"
  local by="" seen_by=0 endflags=0
  local -a rest=()

  # Flags are read across the whole line rather than only ahead of the operand,
  # for parse_globals' reason: `okf verify src/route/RouteRegistry --by
  # human:dcruver` is how anybody types this, and a parser that stopped at the
  # first non-flag would take `--by` for a second concept and refuse it.
  while [ $# -gt 0 ]; do
    if [ "$endflags" -eq 1 ]; then
      rest+=("$1")
      shift
      continue
    fi
    case "$1" in
      --) endflags=1 ;;
      --by)
        shift
        [ $# -gt 0 ] || die "verify: --by needs an actor" "$usage"
        # A value that is itself a flag is a --by whose actor was left out —
        # parse_globals' objection for --config, and the same slip.
        case "$1" in
          -*) die "verify: --by needs an actor, but the next word is a flag: $1" "$usage" ;;
        esac
        [ "$seen_by" -eq 0 ] || die "verify: --by given more than once"
        seen_by=1
        by="$1"
        ;;
      # Accepted for the reason `--config=PATH` is: it is what anyone used to
      # the GNU tools will type, and left to fall through it would be an actor
      # silently recorded as a concept.
      --by=*)
        [ "$seen_by" -eq 0 ] || die "verify: --by given more than once"
        seen_by=1
        by="${1#--by=}"
        ;;
      -*) die "verify: unknown flag: $1" "$usage" ;;
      *) rest+=("$1") ;;
    esac
    shift
  done

  [ "$seen_by" -eq 0 ] || [ -n "$by" ] || die "verify: --by needs an actor, not an empty argument"

  local count="${#rest[@]}"
  [ "$count" -gt 0 ] || die "verify needs a concept to verify" "$usage"
  # One concept and not a list. A run over several would have to decide what to
  # do about the third when the second could not be written, and there is no
  # answer to that which is not either "stop, having half done it" or "carry
  # on, having said so in a line the caller has to go and find". A caller who
  # wants several has a loop, and a status per concept.
  [ "$count" -eq 1 ] || die "verify takes one concept, but was given $count: ${rest[*]}" \
    "$usage"

  # The clock, demanded before anything is read or written — see require_clock.
  # A verify that got as far as opening the concept and only then discovered it
  # had no instant to record would have found that out after the one step that
  # can leave a file half-written.
  require_clock verify

  local given="${rest[0]}"
  resolve_concept verify "$given"
  local concept="$OKF_CONCEPT"

  if [ "$seen_by" -eq 1 ]; then
    if ! is_actor_string "$by"; then
      # Said, and then done as asked — see is_actor_string. The line names what
      # it costs rather than what it looks like, because "not one of §4's
      # actors" is a spelling complaint and "this review will not count as a
      # human's" is the consequence.
      warn "$by is not one of SPEC.md §4's actor strings: claude-code/<model>, ralph/<model>, human:<id>, process:<id>" \
        "  it is recorded as given, but SPEC.md §8 reads a verified entry as a human's only when its actor begins human:"
    fi
  else
    default_actor || die "$OKF_ACTOR_ERROR" \
      "name the actor with --by, as in: okf verify $given --by human:<id>"
    by="$OKF_ACTOR"
  fi

  stamp_instant || die "$OKF_STAMP_ERROR" \
    "so there is no instant to record, and no entry was written"
  local now="$OKF_STAMP_INSTANT"

  append_verified_entry "$concept" "$by" "$now" \
    || die "$concept: no verified entry was appended" "  $OKF_VERIFY_ERROR"

  # One line, naming all three of the things this run decided: which file was
  # written, who it credits, and when. The actor especially — a default that
  # went unprinted is a caller finding out whose name is in their bundle by
  # opening the file.
  printf 'verified %s by %s at %s\n' "$concept" "$by" "$now"

  # And what the entry was worth: SPEC.md §8's trust tier, which is the answer
  # to the question somebody typing `okf verify` is actually asking. A run that
  # printed only "verified" would let a review land on a drifted concept, or one
  # regenerated since, and read as having settled something it has not.
  #
  # Read back out of the concept rather than worked out from the entry just
  # written, because the tier is a property of the concept and not of one entry:
  # a `--by process:okf/0.2` on a concept a human reviewed yesterday leaves it
  # Human-reviewed, and no amount of looking at the entry this run appended
  # would show that.
  #
  # The entry is written whatever the tier turns out to be, and this run still
  # exits 0. What was asked for was a record of a review, and the record is
  # there; the tier is what it is worth, which is a thing to be told rather than
  # a thing to fail over. The line explaining a degradation goes to stderr with
  # okf's other explanations, so the tier stays the one parseable answer on
  # stdout.
  if concept_trust_tier "$concept"; then
    printf 'trust: %s\n' "$OKF_TRUST_TIER"
    [ -z "$OKF_TRUST_NOTE" ] || warn "$OKF_TRUST_NOTE"
  else
    warn "the entry was written, but $concept could not be read back afterwards" \
      "  so SPEC.md §8's trust tier is not reported for this run"
  fi
}

# ---------------------------------------------------------------------------
# Chunking (SPEC.md §4, §9)
# ---------------------------------------------------------------------------

# The chunks one concept body splits into, filled by split_concept_body: three
# arrays read in step, one entry per chunk, in the order SPEC.md §9 names them
# — the summary, then one method chunk per `## ` under `# Methods` in document
# order, then the schema.
#
# Three parallel arrays rather than one array of records because bash has no
# records, and the alternative — a delimiter packed into one string — would put
# a separator inside text that is somebody's prose and can contain anything.
OKF_CHUNK_KIND=()
OKF_CHUNK_HEADING=()
OKF_CHUNK_TEXT=()

# The method chunks as they are met, held back until the summary has been
# recorded. The summary is assembled from sections scattered the length of the
# body — SPEC.md §4 feeds it `# Responsibilities`, `# Collaborators`,
# `# Invariants`, `# Failure Modes` and `# Examples`, and `# Examples` commonly
# sits below `# Methods` — so it is only complete at the end of the file, while
# SPEC.md §9 names it first.
OKF_METHOD_HEADING=()
OKF_METHOD_TEXT=()

# Everything but the blank lines at either end of a block.
#
# Either end only. A blank line *between* two paragraphs is the paragraph break,
# and a chunk that lost those would reach the embedding endpoint as one run-on
# wall of text.
OKF_TRIMMED=""
trim_blank_lines() { # $1 = a block of text
  local text="$1"
  # `${text%%$'\n'*}` is the first line and `${text##*$'\n'}` the last; each
  # loop drops one end line at a time for as long as that end line is empty. A
  # block with no newline in it at all leaves both patterns unmatched, and so
  # both loops on their first test, which is the answer for a one-line chunk.
  while [ -n "$text" ] && [ -z "${text%%$'\n'*}" ]; do
    text="${text#$'\n'}"
  done
  while [ -n "$text" ] && [ -z "${text##*$'\n'}" ]; do
    text="${text%$'\n'}"
  done
  OKF_TRIMMED="$text"
}

# The run of backticks or tildes a line opens with, when it is three or more of
# them — markdown's fenced code block — and empty when the line is not one.
#
# Fences are tracked because SPEC.md §4's headings are "structural, not
# cosmetic": they are the chunk boundaries, and a fenced block is the one place
# in a body where a `# Schema` or a `## something` line is content rather than a
# boundary. A splitter blind to fences would cut a concept that documents this
# very format into chunks along the headings in its own examples.
OKF_FENCE=""
fence_run() { # $1 = a line, already stripped of its trailing whitespace
  local line="$1" ch run=""
  case "$line" in
    '```'*) ch='`' ;;
    '~~~'*) ch='~' ;;
    *)
      OKF_FENCE=""
      return 0
      ;;
  esac
  while [ "${line#"$ch"}" != "$line" ]; do
    run="$run$ch"
    line="${line#"$ch"}"
  done
  OKF_FENCE="$run"
}

# One chunk onto the three arrays, with the blank lines trimmed off its text.
#
# A chunk whose text is empty once trimmed is dropped rather than recorded, and
# that is the only thing dropped here. Every kind but the summary carries its
# own heading line inside its text, so the guard is in practice about the one
# case that has no heading either: a concept with no body at all, whose summary
# is built out of its frontmatter instead — see stub_summary_text — and which
# comes back as `[]` rather than as an empty summary shell only when the
# frontmatter has not got the fields to build one from either.
#
# A section that is thin rather than empty — a `# Schema` with nothing yet under
# it, a `## <signature>` with no prose — is kept, deliberately. Chunks are what
# `okf search` can return, so dropping one hides a section the concept really
# has: a stub schema would become a record whose schema cannot be found at all,
# which reads as "there is no schema" rather than as "it has not been written".
# That is split_concept_body's rule about unnamed prose, applied to thin
# sections.
chunk_record() { # $1 = kind, $2 = heading, $3 = text
  trim_blank_lines "$3"
  [ -n "$OKF_TRIMMED" ] || return 0
  OKF_CHUNK_KIND+=("$1")
  OKF_CHUNK_HEADING+=("$2")
  OKF_CHUNK_TEXT+=("$OKF_TRIMMED")
}

# Splits one concept's body on SPEC.md §4's body headings, leaving the result in
# OKF_CHUNK_KIND, OKF_CHUNK_HEADING and OKF_CHUNK_TEXT.
#
#   0  the body was read, and the arrays hold what it split into
#   1  the file is not a concept — no frontmatter block, or one never closed
#
# SPEC.md §4's table gives three destinations and names five headings for the
# first of them. Everything it sends to `summary` is folded into one chunk;
# `# Methods` is a container whose own line belongs to no chunk, and each `## `
# under it is a chunk; `# Schema` is a chunk.
#
# A heading the table does not name feeds the summary, and so does prose above
# the first heading and prose between `# Methods` and its first `## `. That is a
# deliberate default rather than an omission: the table is a taxonomy for
# generated concepts, but a bundle is a text file anybody may add a paragraph
# to, and the alternative to folding unnamed prose into the summary is dropping
# it — a sentence that is in the concept, is in no chunk, and so cannot be found
# by the search the chunks exist to feed.
split_concept_body() { # $1 = a path to a concept file
  local path="$1" line trimmed stripped indent emit
  local opened=0 closed=0
  local fence="" section="summary"
  local summary="" schema="" method="" method_heading="" method_open=0

  OKF_CHUNK_KIND=()
  OKF_CHUNK_HEADING=()
  OKF_CHUNK_TEXT=()
  OKF_METHOD_HEADING=()
  OKF_METHOD_TEXT=()

  # Asked before the redirection, for read_frontmatter's reason: a redirection
  # that fails is a failure of the `while` itself, and under `set -e` that ends
  # the script instead of returning the 1 the caller is written to handle.
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    return 1
  fi

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#$'\xef\xbb\xbf'}"
    line="${line%$'\r'}"

    # The frontmatter, skipped rather than read: read_frontmatter has already
    # had the fields out of it. Both ends are still checked, because a file
    # whose block never closes has no body — everything below the `---` is
    # unclosed YAML — and chunking it would embed half a frontmatter block.
    if [ "$opened" -eq 0 ]; then
      [ "$line" = "---" ] || break
      opened=1
      continue
    fi
    if [ "$closed" -eq 0 ]; then
      [ "$line" = "---" ] && closed=1
      continue
    fi

    # The line without its trailing whitespace, which is what every comparison
    # below is made against: `# Methods ` is the same heading as `# Methods`,
    # and a line of nothing but spaces is a blank line. The line itself is kept
    # as it came for the chunk text, so two trailing spaces — markdown's hard
    # line break — survive into what is embedded.
    trimmed="${line%"${line##*[![:space:]]}"}"
    [ -n "$trimmed" ] || line=""
    emit=1

    # The same line with up to three leading spaces taken off, which is what the
    # fence tests below are made against. Markdown lets a fence sit up to three
    # spaces in — inside a list item one always does — and stops at three,
    # because a fourth space makes the line an indented code block instead.
    #
    # The heading tests keep the untrimmed `trimmed` and so still want column 0.
    # That asymmetry is deliberate: an indented line mistaken for a fence leaves
    # the headings inside it as content, while an indented line mistaken for a
    # heading cuts a chunk in half. Only one of those two errors loses text, and
    # SPEC.md §4's own examples put every heading at column 0.
    stripped="$trimmed"
    indent=0
    while [ "$indent" -lt 3 ] && [ "${stripped# }" != "$stripped" ]; do
      stripped="${stripped# }"
      indent=$((indent + 1))
    done

    if [ -n "$fence" ]; then
      # Inside a fence, so no line here is a heading. Only the fence's own
      # close is looked for: markdown closes on the same character, at least as
      # many of them, and nothing else on the line.
      fence_run "$stripped"
      if [ -n "$OKF_FENCE" ] && [ "$stripped" = "$OKF_FENCE" ] \
        && [ "${OKF_FENCE:0:1}" = "${fence:0:1}" ] \
        && [ "${#OKF_FENCE}" -ge "${#fence}" ]; then
        fence=""
      fi
    else
      fence_run "$stripped"
      if [ -n "$OKF_FENCE" ]; then
        fence="$OKF_FENCE"
      elif [ "${trimmed#"# "}" != "$trimmed" ] \
        || { [ "$section" = "methods" ] && [ "${trimmed#"## "}" != "$trimmed" ]; }; then
        # A boundary: either a top-level heading, which ends whatever section
        # was open, or a `## ` while `# Methods` is open, which ends the
        # previous method. Both close the method being accumulated, which is
        # why the two are one branch and the flush below is written once.
        if [ "$method_open" -eq 1 ]; then
          OKF_METHOD_HEADING+=("$method_heading")
          OKF_METHOD_TEXT+=("$method")
        fi
        method=""
        method_heading=""
        method_open=0

        case "$trimmed" in
          "# Methods")
            section="methods"
            # The one line in a body that belongs to no chunk. `# Methods` is a
            # container for the `## ` headings under it, and SPEC.md §4's table
            # gives it no chunk of its own — putting it in the summary would
            # announce methods the summary does not contain.
            emit=0
            ;;
          "# Schema") section="schema" ;;
          "# "*) section="summary" ;;
          *)
            method_open=1
            method_heading="${trimmed#"## "}"
            while [ "${method_heading# }" != "$method_heading" ]; do
              method_heading="${method_heading# }"
            done
            ;;
        esac
      fi
    fi

    # Blank lines run together outside a fence, because markdown reads any run
    # of them as one paragraph break and because a line lifted out from between
    # two of them — `# Methods`, whose own line belongs to no chunk — would
    # otherwise leave the gap it came from behind in the summary. Inside a
    # fence they are kept every one, being somebody's code.
    if [ "$emit" -eq 1 ] && [ -z "$fence" ] && [ -z "$line" ]; then
      local so_far=""
      case "$section" in
        methods)
          if [ "$method_open" -eq 1 ]; then so_far="$method"; else so_far="$summary"; fi
          ;;
        schema) so_far="$schema" ;;
        *) so_far="$summary" ;;
      esac
      # Nothing yet, or a blank line already at the end of it.
      if [ -z "$so_far" ] || [ "${so_far%$'\n\n'}" != "$so_far" ]; then
        emit=0
      fi
    fi

    [ "$emit" -eq 1 ] || continue
    case "$section" in
      methods)
        if [ "$method_open" -eq 1 ]; then
          method="$method$line"$'\n'
        else
          summary="$summary$line"$'\n'
        fi
        ;;
      schema) schema="$schema$line"$'\n' ;;
      *) summary="$summary$line"$'\n' ;;
    esac
  done 2> /dev/null < "$path"

  if [ "$opened" -eq 0 ] || [ "$closed" -eq 0 ]; then
    return 1
  fi

  # The last method, which has no heading after it to close it.
  if [ "$method_open" -eq 1 ]; then
    OKF_METHOD_HEADING+=("$method_heading")
    OKF_METHOD_TEXT+=("$method")
  fi

  chunk_record summary "" "$summary"
  local i=0 methods="${#OKF_METHOD_TEXT[@]}"
  while [ "$i" -lt "$methods" ]; do
    chunk_record method "${OKF_METHOD_HEADING[$i]}" "${OKF_METHOD_TEXT[$i]}"
    i=$((i + 1))
  done
  chunk_record schema "" "$schema"
  return 0
}

# SPEC.md §9's chunk for a concept with no body: "A Tier 0 concept with no body
# yields exactly one `summary` chunk built from `title`, `description`, and
# `code.signature`." The text of that chunk, out of the frontmatter
# read_frontmatter last read, left in OKF_STUB_SUMMARY.
#
# Asked of a concept with no chunks rather than of one whose `code.tier` says
# `0`, and the difference is deliberate. SPEC.md §5 defines Tier 0 as
# "frontmatter, signature, links only. No prose" — having no body is what being
# Tier 0 *is*, and the body is the fact while the field is a label that can lag
# behind it. A concept carrying `tier: 1` and no prose is a Tier 0 file whose
# label has not caught up, and reading the label would leave it with no chunk at
# all: no point in the index, and so a concept `okf search` cannot return. §5 is
# explicit that Tier 0 is "a demotion, never an exclusion", and a concept
# excluded from the index is excluded whatever its frontmatter claims.
#
# The three fields in §9's order, one paragraph each, and nothing else — no
# labels, no headings, no `code.signature:` prefix. What is being built is text
# to embed, and the fields around it travel as payload rather than as prose: the
# scaffolding would be in every stub chunk in the bundle, identical, and so is
# noise in exactly the comparison the embedding is for.
#
# A field the concept has not got is left out entirely rather than written as a
# blank paragraph, which is the same rule chunk_record applies to a section that
# trims to nothing. A concept with none of the three leaves this empty, and
# chunk_record then drops it: `okf chunk` answers `[]`, because a chunk of
# nothing is a point in the index that matches every query equally.
OKF_STUB_SUMMARY=""
stub_summary_text() {
  local text="" field
  for field in "$OKF_FM_TITLE" "$OKF_FM_DESCRIPTION" "$OKF_FM_CODE_SIGNATURE"; do
    [ -n "$field" ] || continue
    [ -z "$text" ] || text="$text"$'\n\n'
    text="$text$field"
  done
  OKF_STUB_SUMMARY="$text"
}

# SPEC.md §9's `repo`, the payload field "every point carries … so cross-repo
# search is a filter change, not a schema change". Left in OKF_INDEX_REPO.
#
# `index.repo` out of okf.json, which is where SPEC.md §6 puts it, and the
# bundle's own directory name when the settings name none — §6's "every field
# defaults if absent", answered with the same default `okf init` gives the
# bundle-root index.md its title, so that the two documents a bundle carries
# agree on what the bundle is called. Points carrying an empty `repo` would be
# points no filter could single out, which is the one thing this field is for.
#
# Shared with `okf embed` and `okf search` when they arrive: the field has to
# mean the same thing on the point that is written and in the filter that finds
# it again, and two readings of one setting is how that stops being true.
OKF_INDEX_REPO=""
index_repo() {
  load_settings

  local repo
  # stderr folded into the value so jq's own complaint about a wrong shape is
  # what gets reported, the way settings_strings reports one about a list.
  #
  # `getpath` and an explicit `null` test rather than `// empty`, which is
  # settings_strings' choice for settings_strings' reason: `//` reads `false` as
  # absent, so `"repo": false` would fall through to the directory name while
  # `7` and `[]` were refused. Every wrong shape is a wrong shape.
  repo="$(printf '%s\n' "$OKF_SETTINGS" | jq -r '
      getpath(["index", "repo"]) as $r
      | if $r == null then ""
        elif ($r | type) != "string" then
          error("must be a string, found " + ($r | type))
        elif $r == "" then error("must not be empty")
        elif ($r | contains("\n")) then error("must not have a newline in it")
        else $r end' 2>&1)" \
    || die "$(display_path "$OKF_CONFIG"): index.repo ${repo#jq: error*: }"

  if [ -z "$repo" ]; then
    # cmd_init's line and its reason: the bundle is named for the directory it
    # is in, and that name is empty only when the root is `/`, which is then
    # also its own best name.
    repo="${OKF_ROOT##*/}"
    [ -n "$repo" ] || repo="$OKF_ROOT"
  fi
  OKF_INDEX_REPO="$repo"
}

# SPEC.md §9's `lines`, as the JSON a payload carries: the pair `code.lines`
# holds, rendered as numbers in OKF_CHUNK_LINES_JSON — and `null` when the
# field is absent, is not a flow sequence, or holds anything but digits.
#
# JSON numbers and not the string `"[28, 214]"`, because a payload field exists
# to be filtered on and no range query can read a string. `null` and not `[]`
# for the same reason turned around: an empty list is a claim that the concept
# covers no lines, where an absent field claims nothing.
OKF_CHUNK_LINES_JSON="null"
chunk_lines_json() { # $1 = code.lines, exactly as the frontmatter spells it
  local raw="$1" item out="" first=1
  OKF_CHUNK_LINES_JSON="null"

  [ -n "$raw" ] || return 0
  # The flow form is the only one this field has, where `tags` is read in both.
  # The asymmetry is SPEC.md §4's: `code.X` is defined by an extraction rule —
  # "the first line matching `^  X: ` after the `^code:` line" — which is a rule
  # about a scalar on one line, and §4's own example writes `lines: [28, 214]`.
  # A block sequence under `  lines:` would also have to be told apart from the
  # `code.members` items §4 puts at the same depth. `tags` is a top-level key
  # with no such rule and no such neighbour.
  yaml_flow_items "$raw" || return 0

  # Two items, because SPEC.md §4 writes this field `lines: [28, 214]` and a
  # range is its two ends. A `[28]` rendered as it stands would be a range whose
  # end okf had lost, and a `[1, 2, 3]` one it could not place at all — both
  # read by a consumer as a range, and neither one.
  [ "${#OKF_FLOW_ITEMS[@]}" -eq 2 ] || return 0

  # Rendered into a local, so that an item found unusable halfway through leaves
  # OKF_CHUNK_LINES_JSON at the null it started as: half a pair is worse than
  # none, and `[28, ?]` must not come out as `[28]`.
  for item in "${OKF_FLOW_ITEMS[@]}"; do
    case "$item" in
      "" | *[!0-9]*) return 0 ;;
    esac

    # Leading zeros off, because `08` is not JSON — and off as text rather than
    # through `$((10#$item))`, which is arithmetic and would silently wrap at
    # 64 bits, putting a number nobody wrote on the payload.
    item="${item#"${item%%[!0]*}"}"
    [ -n "$item" ] || item=0

    # And a ceiling on what is left, because past it okf cannot promise to carry
    # the value through unchanged: jq before 1.7 re-encodes a literal too big
    # for a double, so `99999999999999999999` would reach the payload as
    # `1e+20`. Fifteen digits is more than any file has lines, so anything
    # longer was never a line number, and null — this function's answer for
    # every other value it cannot use — says so without inventing one.
    [ "${#item}" -le 15 ] || return 0

    [ "$first" -eq 1 ] || out="$out,"
    first=0
    out="$out$item"
  done
  OKF_CHUNK_LINES_JSON="[$out]"
}

# SPEC.md §9's `symbol` for one chunk: the concept's own `code.symbol` for a
# summary or a schema, and the member's — `<symbol>#<name><params>`, javadoc's
# own way of naming a member — for a method chunk. Left in OKF_CHUNK_SYMBOL.
#
# Per chunk rather than per concept, and §9's point ID is what forces that: the
# ID is a digest of `{repo}|{concept_id}|{chunk_kind}|{symbol}`, "so upserts are
# idempotent and deletes targeted". Every method chunk of one concept agrees on
# the first three of those four, so a `symbol` that stayed the type's would give
# all of them one ID — and every multi-method concept in the bundle would
# collapse to a single point on upsert, silently.
#
# The parameter list is part of the symbol for the same reason, one level down:
# overloads share a name, and `add(String)` and `add(String, Handler)` are two
# members of one type. Kept to the parentheses and their contents — the matching
# `)` ends it — so that a return type written after them, `size(): number` or
# `resolve(&self) -> Option<Route>`, is not part of a member's identity.
#
# All of it is read off the `## ` heading rather than looked up in
# `code.members`, because the heading is the one thing certainly there: §4 makes
# it the chunk boundary, while `members` is optional and can lag the body.
#
# Which `(` opens the parameter list is the only real question, and three rules
# answer it, each one for a shape the one before it gets wrong:
#
#   * The first `(` at the top level that immediately follows an identifier
#     character. Top level, so a nested `(` in a parameter type — `new(x:
#     Foo(Bar))` — cannot cut early; identifier-hugging, so Go's receiver is
#     skipped and `func (r *Router) Add(` names Add rather than func.
#   * …unless the identifier in front of it is an annotation's, which is a
#     name preceded by `@` or by `[`: `@Deprecated(since="1") public void
#     add(String)` and `[Obsolete("x")] public void Add(string)` and
#     `#[deprecated(note="x")] pub fn new()` all put a parenthesised name ahead
#     of the member's own. Skipped rather than taken, and the scan goes on to
#     the next candidate. Not simply "the last one", which would name a Rust
#     signature after its return type: `fn f(x: u32) -> impl Fn(u32)`.
#   * Failing all of those, the first `(` anywhere, which reads a signature
#     written with a space before its parameters: `public void add (String,
#     Handler)` has no identifier-hugging `(` at all, and cutting at the only
#     one there is names `add` where the first rule alone would have gone on to
#     the last word of the parameter list.
#
# A heading with no `(` in it is not a signature — §4 asks for "one `## <signature>`
# per member" — so nothing is guessed about which of its words is a name: the
# heading is taken whole. That keeps a TypeScript property, `## name: string`,
# from being named `string`, and leaves an out-of-place prose heading visibly
# prose in the index rather than quietly wearing some word out of the middle of
# it as a member name.
OKF_CHUNK_SYMBOL=""
chunk_symbol() { # $1 = code.symbol, $2 = the chunk's kind, $3 = its heading
  local symbol="$1" kind="$2" heading="$3"
  local name="" params="" prev="" ch at cut=-1 first=-1 depth=0 start
  local annotation=0

  if [ "$kind" != "method" ]; then
    OKF_CHUNK_SYMBOL="$symbol"
    return 0
  fi

  for ((at = 0; at < ${#heading}; at++)); do
    ch="${heading:at:1}"
    case "$ch" in
      "(")
        if [ "$depth" -eq 0 ]; then
          case "$prev" in
            [A-Za-z0-9_])
              # Back over the name this `(` hugs, dots included so that a
              # qualified annotation — `@javax.annotation.Generated(` — is one
              # name and not three, and then one character further: an `@` or a
              # `[` in front of it says the parentheses are the annotation's.
              start="$at"
              while [ "$start" -gt 0 ]; do
                case "${heading:start-1:1}" in
                  [A-Za-z0-9_.]) start=$((start - 1)) ;;
                  *) break ;;
                esac
              done
              if [ "$start" -eq 0 ]; then
                cut="$at"
              else
                case "${heading:start-1:1}" in
                  # An annotation's own parentheses, which are neither the
                  # member's parameter list nor a candidate for the fallback:
                  # `first` is left alone so that a signature carrying both an
                  # annotation and a space before its parameters still lands on
                  # the space.
                  "@" | "[") annotation=1 ;;
                  *) cut="$at" ;;
                esac
              fi
              ;;
          esac
          if [ "$annotation" -eq 0 ] && [ "$first" -lt 0 ]; then
            first="$at"
          fi
          annotation=0
          [ "$cut" -lt 0 ] || break
        fi
        depth=$((depth + 1))
        ;;
      ")") [ "$depth" -eq 0 ] || depth=$((depth - 1)) ;;
    esac
    prev="$ch"
  done
  [ "$cut" -ge 0 ] || cut="$first"

  if [ "$cut" -lt 0 ]; then
    # No parentheses at all: the whole heading, trimmed, and no guess about
    # which of its words is the name.
    name="${heading#"${heading%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
  else
    name="${heading:0:cut}"
    name="${name%"${name##*[![:space:]]}"}"
    name="${name##*[[:space:]]}"

    # Reset, because the scan above stops wherever it found its answer and may
    # have left parentheses open behind it — and the count below is what decides
    # where the parameter list ends.
    depth=0

    # The parameter list, up to the `)` that closes the `(` above. Counted
    # rather than searched for, because a parameter type may carry parentheses
    # of its own — `new(x: Foo(Bar))` — and the first `)` closes the inner one.
    # An unbalanced heading runs to the end of the line, which is the only
    # answer left and is at least the whole of what was written.
    for ((at = cut; at < ${#heading}; at++)); do
      ch="${heading:at:1}"
      params="$params$ch"
      case "$ch" in
        "(") depth=$((depth + 1)) ;;
        ")")
          depth=$((depth - 1))
          [ "$depth" -gt 0 ] || break
          ;;
      esac
    done
  fi

  # A "name" holding no identifier character is not a name — `const add = (a, b)
  # => a + b` puts an `=` where the last word before the parameters ought to be.
  # The whole heading, trimmed, rather than a symbol built out of punctuation:
  # it is longer and it is what the concept says, and two members written that
  # way stay two symbols.
  case "$name" in
    *[A-Za-z0-9_]*) ;;
    *)
      name="${heading#"${heading%%[![:space:]]*}"}"
      name="${name%"${name##*[![:space:]]}"}"
      params=""
      ;;
  esac

  # A heading with nothing in it, or a concept carrying no `code.symbol`:
  # whichever half is there is the whole answer, because a `#` with nothing on
  # one side of it names nothing at all.
  if [ -z "$name$params" ]; then
    OKF_CHUNK_SYMBOL="$symbol"
  elif [ -z "$symbol" ]; then
    OKF_CHUNK_SYMBOL="$name$params"
  else
    OKF_CHUNK_SYMBOL="$symbol#$name$params"
  fi
}

# The symbol of every chunk of one concept, in step with OKF_CHUNK_KIND, left
# in OKF_CHUNK_SYMBOLS — chunk_symbol's answer for each, and then whatever it
# takes to make sure no two of them are the same.
#
# SPEC.md §9's point ID is a digest of
# `{repo}|{concept_id}|{chunk_kind}|{symbol}`, and across the chunks of one
# concept `repo` and `concept_id` are equal. So two chunks collide when their
# `chunk_kind` and their `symbol` are both equal — which is two chunks sharing
# one point: the second upsert replaces the first, and half a concept leaves the
# index with nothing anywhere reporting it.
#
# `chunk_kind` is part of that test and not an afterthought. A summary and a
# schema both take the concept's bare `code.symbol`, so a comparison on `symbol`
# alone would rename the schema chunk of every record in the bundle to settle a
# collision the ID does not have.
#
# chunk_symbol reads that symbol out of a `## ` heading, and a heading is prose
# somebody's slash command wrote — SPEC.md §4 asks for a signature there, and
# nothing enforces it. So uniqueness is not left to the reading. Any symbol that
# came out twice is replaced, on every chunk that produced it, by one built from
# the heading itself, which is what told those chunks apart to begin with.
#
# Both passes run before anything is rewritten, so that a substitution cannot
# hide the duplicate that justified it: rewriting chunk i as the loop goes would
# leave chunk j comparing against the new value and looking unique.
#
# Deterministic, which is what §9's "upserts are idempotent" needs: the
# substitution reads nothing but the concept's own headings, so one file yields
# one set of symbols on every run.
OKF_CHUNK_SYMBOLS=()
chunk_symbols() { # $1 = code.symbol
  local base="$1" total="${#OKF_CHUNK_KIND[@]}" i j collided=0
  local -a dup=()
  OKF_CHUNK_SYMBOLS=()

  for ((i = 0; i < total; i++)); do
    chunk_symbol "$base" "${OKF_CHUNK_KIND[$i]}" "${OKF_CHUNK_HEADING[$i]}"
    OKF_CHUNK_SYMBOLS[i]="$OKF_CHUNK_SYMBOL"
    dup[i]=0
  done

  for ((i = 0; i < total; i++)); do
    for ((j = i + 1; j < total; j++)); do
      [ "${OKF_CHUNK_KIND[$i]}" = "${OKF_CHUNK_KIND[$j]}" ] || continue
      [ "${OKF_CHUNK_SYMBOLS[$i]}" = "${OKF_CHUNK_SYMBOLS[$j]}" ] || continue
      collided=1
      # Only where the headings differ, because the heading is what the
      # substitution below has to offer: two chunks whose `## ` lines are
      # textually equal would swap one symbol they share for another, losing the
      # readable one for nothing. Those are left to the numbering pass.
      [ "${OKF_CHUNK_HEADING[$i]}" != "${OKF_CHUNK_HEADING[$j]}" ] || continue
      dup[i]=1
      dup[j]=1
    done
  done

  for ((i = 0; i < total; i++)); do
    [ "${dup[$i]}" -eq 1 ] || continue
    # A chunk with no heading has nothing left to be told apart by. Only the
    # summary and the schema are headed by nothing, there is one of each per
    # concept, and `chunk_kind` already tells those two apart in the ID — so
    # this is unreachable, and leaving the symbol alone is better than inventing
    # a name nobody could reproduce.
    [ -n "${OKF_CHUNK_HEADING[$i]}" ] || continue
    if [ -n "$base" ]; then
      OKF_CHUNK_SYMBOLS[i]="$base#${OKF_CHUNK_HEADING[$i]}"
    else
      OKF_CHUNK_SYMBOLS[i]="${OKF_CHUNK_HEADING[$i]}"
    fi
  done

  # And a last pass for what the heading itself cannot settle: two `## ` lines
  # that are textually equal. That is a concept naming one member twice, which
  # is a mistake — but it is a mistake in a file, and it must not cost the index
  # a chunk, so the duplicates are numbered in document order. `~2` because
  # neither `#` nor a bare digit could be told from part of a signature.
  #
  # Each symbol is compared against the ones already settled ahead of it, and
  # the suffix counts up until it clears all of them rather than counting how
  # many it saw: a concept whose third heading repeats the first would otherwise
  # be handed the `~2` the second one had just been given.
  # Skipped outright when the pass above found nothing to settle, which is every
  # ordinary concept: this is a second quadratic sweep, and there is no point
  # walking it to confirm what has already been established.
  [ "$collided" -eq 1 ] || return 0

  local candidate n taken
  for ((i = 1; i < total; i++)); do
    n=1
    candidate="${OKF_CHUNK_SYMBOLS[$i]}"
    while :; do
      taken=0
      for ((j = 0; j < i; j++)); do
        [ "${OKF_CHUNK_KIND[$j]}" = "${OKF_CHUNK_KIND[$i]}" ] || continue
        [ "${OKF_CHUNK_SYMBOLS[$j]}" = "$candidate" ] || continue
        taken=1
        break
      done
      [ "$taken" -eq 1 ] || break
      n=$((n + 1))
      candidate="${OKF_CHUNK_SYMBOLS[$i]}~$n"
    done
    OKF_CHUNK_SYMBOLS[i]="$candidate"
  done
}

# okf chunk <concept> — Tier B: emit JSON chunks for one concept
#
# Local work, and no HTTP: see OKF_HTTP_SUBCOMMANDS for why this one is Tier B
# without being one of the subcommands that needs curl.
cmd_chunk() {
  local usage="usage: okf chunk <concept>"
  local endflags=0
  local -a rest=()

  # cmd_verify's loop without its `--by`: flags are still read across the whole
  # line, because SPEC.md §7's global -C and --config may follow the operand and
  # a parser that stopped at the first non-flag would refuse them here.
  while [ $# -gt 0 ]; do
    if [ "$endflags" -eq 1 ]; then
      rest+=("$1")
      shift
      continue
    fi
    case "$1" in
      --) endflags=1 ;;
      -*) die "chunk: unknown flag: $1" "$usage" ;;
      *) rest+=("$1") ;;
    esac
    shift
  done

  local count="${#rest[@]}"
  [ "$count" -gt 0 ] || die "chunk needs a concept to split" "$usage"
  # One concept, for cmd_verify's reason turned around: the answer here is a
  # single JSON array, and a run over several would have to decide whether that
  # array is the chunks of all of them — one document whose entries no longer
  # say which concept each came from — or several arrays, which is not one
  # document at all. A caller who wants several has a loop.
  [ "$count" -eq 1 ] || die "chunk takes one concept, but was given $count: ${rest[*]}" \
    "$usage"

  resolve_concept chunk "${rest[0]}"
  local concept="$OKF_CONCEPT"

  # A markdown file is not a concept until it carries SPEC.md §4's block, and
  # reading that block is how the rest of okf decides. Three things come out of
  # it here: the refusal below, SPEC.md §9's payload — nine of its thirteen
  # fields are frontmatter read straight off — and the one case where the
  # frontmatter is all there is to build a chunk out of, a concept with no body.
  #
  # Asked *through* concept_trust_tier, which reads the block itself and returns
  # 1 for exactly the reason read_frontmatter does: there was no block to read.
  # So the refusal and §9's `trust_tier` come out of one pass over the file,
  # where the obvious two calls would be two passes over every concept in a
  # bundle — and `okf chunk` is the subcommand run over all of them in a loop.
  # It leaves the OKF_FM_ variables set, as any successful read does; nothing
  # between here and stub_summary_text below disturbs them.
  #
  # §9's `trust_tier` is computed rather than read: §8 defines it out of the
  # `verified` entries, `generated.at` and whether the concept has drifted, and
  # no field in the file holds the answer. It is the one payload field that
  # opens a second file — the resource, to hash it — and a concept whose source
  # is gone is still gradeable, because §8 makes drift a comparison that was
  # made and came out unequal rather than one that could not be made at all.
  #
  # OKF_TRUST_NOTE is deliberately not warned about here, where `okf verify`
  # prints it. Verify is one person asking about one concept; this is a
  # subcommand whose stdout somebody is piping into jq, and the tier itself
  # travels on every chunk.
  concept_trust_tier "$concept" \
    || die "$concept is not a concept" \
      "a concept opens with --- on line 1 and closes with the next line that is exactly ---" \
      "SPEC.md §4 calls that layout a contract rather than a preference"
  local p_trust="$OKF_TRUST_TIER"

  # The concept-level half of §9's payload, copied out of the read above rather
  # than read again — and copied now, so that a later edit does not have to know
  # that stub_summary_text below reads the same variables.
  local p_type="$OKF_FM_TYPE" p_status="$OKF_FM_STATUS"
  local p_path="$OKF_FM_RESOURCE" p_language="$OKF_FM_CODE_LANGUAGE"
  local p_hash="$OKF_FM_CODE_CONTENT_HASH" p_commit="$OKF_FM_CODE_COMMIT"
  local base_symbol="$OKF_FM_CODE_SYMBOL"

  # `path` is the source the concept documents and not the concept file, which
  # is what `concept_id` already names. §9 puts `lines` beside it on the same
  # payload, and a line range is a range in the source.
  #
  # `tags` and `lines` reach the payload as JSON of their own — a list of
  # strings, a pair of numbers — rather than as the text §4 spells them in: a
  # payload field exists to be filtered on, and `"[28, 214]"` is a value no
  # filter can read.
  local p_tags p_lines
  p_tags="$(json_string_array ${OKF_FM_TAGS[@]+"${OKF_FM_TAGS[@]}"})"
  chunk_lines_json "$OKF_FM_CODE_LINES"
  p_lines="$OKF_CHUNK_LINES_JSON"

  index_repo
  local p_repo="$OKF_INDEX_REPO"

  split_concept_body "$concept" \
    || die "$concept: its body could not be read, so there are no chunks to emit"

  concept_id_of "$concept"
  local concept_id="$OKF_CONCEPT_ID"

  local total="${#OKF_CHUNK_KIND[@]}"
  if [ "$total" -eq 0 ]; then
    # A body with nothing in it, which is SPEC.md §9's Tier 0 concept: the one
    # summary chunk it yields is built from the frontmatter instead.
    stub_summary_text
    chunk_record summary "" "$OKF_STUB_SUMMARY"
    total="${#OKF_CHUNK_KIND[@]}"
  fi
  if [ "$total" -eq 0 ]; then
    # No body, and no frontmatter to stand in for one. `[]` and not silence,
    # for the reason `check --json` spells out at length: a caller parsing this
    # is running jq, and jq given an empty stream fails rather than reporting an
    # empty answer.
    printf '[]\n'
    return 0
  fi

  # The per-chunk fields flattened into one NUL-separated stream and put back
  # together by jq, which is json_string_array's trick for its reason: a chunk's
  # text is somebody's prose and may hold quotes, backslashes, tabs and
  # newlines, and NUL is the one byte `read` cannot have left in it. The
  # concept-level fields go as `--arg` instead, being one value apiece rather
  # than one per chunk.
  chunk_symbols "$base_symbol"

  local -a fields=()
  local i=0
  while [ "$i" -lt "$total" ]; do
    fields+=("${OKF_CHUNK_KIND[$i]}" "${OKF_CHUNK_SYMBOLS[$i]}" \
      "${OKF_CHUNK_HEADING[$i]}" "${OKF_CHUNK_TEXT[$i]}")
    i=$((i + 1))
  done

  # SPEC.md §9's payload in §9's own order, and then the two fields that are not
  # payload at all: `text` is what gets embedded rather than something stored
  # beside the vector, and `heading` is what tells one method chunk from its
  # siblings before `symbol` is built out of it.
  #
  # `heading` is empty for the summary and the schema on purpose. There is one
  # of each per concept, so neither needs telling apart from a sibling; a method
  # chunk does, and its `## ` line is the signature that does it.
  printf '%s\0' "${fields[@]}" | jq -Rs \
    --arg repo "$p_repo" \
    --arg concept_id "$concept_id" \
    --arg path "$p_path" \
    --argjson lines "$p_lines" \
    --arg language "$p_language" \
    --arg type "$p_type" \
    --argjson tags "$p_tags" \
    --arg status "$p_status" \
    --arg trust_tier "$p_trust" \
    --arg content_hash "$p_hash" \
    --arg commit "$p_commit" '
      split("\u0000")[:-1] as $f
      | [ range(0; ($f | length); 4)
          | { repo: $repo,
              concept_id: $concept_id,
              chunk_kind: $f[.],
              symbol: $f[. + 1],
              path: $path,
              lines: $lines,
              language: $language,
              type: $type,
              tags: $tags,
              status: $status,
              trust_tier: $trust_tier,
              content_hash: $content_hash,
              commit: $commit,
              heading: $f[. + 2],
              text: $f[. + 3] } ]
    ' || die "the chunks for $concept could not be rendered as JSON"
}

# okf embed [--all] — Tier B: embed and upsert to Qdrant
cmd_embed() { not_implemented embed; }

# okf search <query> [--hyde-prompt] [--k N] [--repo R] [--type T]
cmd_search() { not_implemented search; }

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  # SPEC.md §3: on every invocation, before anything else — including before
  # the global flags are read, so a machine missing rg is told about rg rather
  # than about the -C directory it also mistyped. The tools Tier B needs on top
  # of these are checked at dispatch, where the subcommand asked for is known —
  # a caller who typed `okf list` is not told to install curl.
  preflight

  # Before anything reaches git, and before -C is even read: what these name
  # outranks both the flag and the directory okf is standing in.
  isolate_git_environment

  # SPEC.md §7's -C DIR and --config PATH, taken out of the line here so that
  # everything below — the bare-invocation check, dispatch, the subcommand's
  # own flags — sees only what the caller asked okf to *do*.
  parse_globals ${1+"$@"}
  enter_root
  set -- ${OKF_ARGV[@]+"${OKF_ARGV[@]}"}

  # No subcommand at all: the same help, but on stderr and exiting 1. A caller
  # that reached here with an empty argument asked for nothing and got nothing
  # done, and exiting 0 would let it mistake that for success. `okf -C repo`
  # lands here too — a root and nothing to do with it.
  if [ $# -eq 0 ]; then
    usage >&2
    return 1
  fi

  local sub="$1"
  shift

  # Answered before the subcommand table, so `--help` stays help rather than
  # becoming "unknown subcommand: --help".
  case "$sub" in
    -h | --help)
      usage
      return 0
      ;;
  esac

  local known
  for known in "${OKF_SUBCOMMANDS[@]}"; do
    [ "$sub" = "$known" ] || continue
    if ! declare -F "cmd_$sub" > /dev/null; then
      # Listed in OKF_SUBCOMMANDS but never written: a bug in this script, not
      # in the caller's command line, so say which of the two it is.
      die "$sub is listed as a subcommand but has no cmd_$sub function"
    fi
    http_preflight "$sub" ${1+"$@"}
    # ${1+"$@"} rather than "$@": under `set -u` an empty "$@" is an unbound
    # variable on bash 3.2, which is still what macOS ships.
    #
    # Not caught in a `|| status=$?`, deliberately, even though SPEC.md §7's 3
    # is a status this line has to carry out rather than a failure: putting the
    # call in an OR-list turns `set -e` off for the whole of the subcommand it
    # runs, and every one of them is written expecting errexit to be on. So the
    # status leaves here the way any non-zero status does — errexit ends the
    # shell at this line with the status the subcommand returned, which is the
    # 3 `okf check --strict` came back with. `return $?` below is what runs when
    # the subcommand succeeded.
    "cmd_$sub" ${1+"$@"}
    return $?
  done

  case "$sub" in
    -*)
      # Nothing beginning with a dash was ever going to be a subcommand, so the
      # useful thing to say is which flags do belong here — `okf -Csrc list` is
      # a -C whose directory was glued to it.
      die "unknown subcommand: $sub" \
        "the flags accepted here are -C DIR, --config PATH and --help" \
        "expected one of: ${OKF_SUBCOMMANDS[*]}"
      ;;
  esac
  die "unknown subcommand: $sub" "expected one of: ${OKF_SUBCOMMANDS[*]}"
}

# Guarded so that sourcing bin/okf yields its functions without also running a
# command line. Executed — installed on $PATH, or run from the checkout — the
# two are the same path and main runs as always; sourced, $0 is the sourcing
# shell's and it does not. That is what lets tests/toolkit.sh call
# parse_globals directly and read back the root and config path it resolved,
# which no subcommand prints and none should have to.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main ${1+"$@"}
fi
