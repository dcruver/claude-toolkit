#!/usr/bin/env bash
# okf — OKF code knowledge for a repository.
#
# Deterministic, offline bookkeeping over co-located OKF concept files: which
# sources are in scope, what has drifted, how often a type is referenced, and
# (Tier B, opt-in) chunking/embedding for semantic search. The design reference
# is SPEC.md; §7 defines this CLI surface and its exit codes.
#
# This script never parses source code and never invokes an LLM. Reading source,
# deciding a tier and authoring prose belong to the commands/okf-*.md slash
# commands — see SPEC.md's division of labour.
#
# Exit codes (SPEC.md §7):
#   0  success
#   1  error, or a missing prerequisite
#   2  a Tier B subcommand was invoked without an `index` block in okf.json
#   3  `check --strict` found drift
#
# Installed exactly like bin/ralph: copied onto $PATH by install.sh. There is no
# compiled artifact and no build step.

set -euo pipefail

# The SPEC.md §7 subcommand surface, and the single source of truth for what
# dispatch accepts. Each name routes to the cmd_<name> function below; adding a
# name here without its function is caught at dispatch rather than silently
# doing nothing.
OKF_SUBCOMMANDS=(init list hash fanin check index verify chunk embed search)

# The help text, and the user-facing half of the SPEC.md §7 CLI surface.
#
# Written out as one literal block rather than generated from OKF_SUBCOMMANDS,
# because the flags and the one-line summaries are as much a part of that
# surface as the names are, and a generated list could only ever print names.
# The names here and in OKF_SUBCOMMANDS are both checked against SPEC.md §7 by
# tests/toolkit.sh, so the two cannot drift apart unnoticed.
#
# Nothing here reads okf.json or the repo: help is the one thing that must
# print the same for every caller, in any directory, whatever the bundle
# contains. SPEC.md §3's preflight still runs ahead of it, and so does -C's own
# check that the directory it names is there: an invocation okf cannot carry
# out is better answered with the reason than with a page of help.
usage() {
  # Printed with printf rather than a here-document into `cat`: what bin/okf
  # needs is SPEC.md §3's list and nothing besides. A `cat` here would be a
  # tool the preflight does not know to check and so could never name — the
  # one failure it exists to turn into a single readable line.
  printf '%s\n' \
    'okf — OKF code knowledge for a repository.' \
    '' \
    'Usage: okf [-C DIR] [--config PATH] <subcommand> [flags]' \
    '' \
    'Subcommands:' \
    '  init [--force]                       write okf.json + the bundle-root index.md' \
    '  list [--missing] [--orphans]         in-scope source files' \
    '  hash <file>                          the sha256: digest of one file' \
    '  fanin <Name>                         whole-word reference count for a name' \
    '  check [--strict] [--stamp] [--json]  drift, missing and orphan concepts' \
    '  index                                regenerate the per-directory index.md files' \
    '  verify <concept> [--by ACTOR]        append a verified entry' \
    '  chunk <concept>                      JSON chunks for one concept' \
    '  embed [--all]                        embed and upsert to Qdrant' \
    '  search <query> [--hyde-prompt] [--k N] [--repo R] [--type T]' \
    '' \
    'Global flags:' \
    '  -C DIR                               resolve every path against DIR' \
    '                                       instead of the current directory' \
    '  --config PATH                        read settings from PATH, itself' \
    '                                       relative to the root (default:' \
    '                                       ./okf.json)' \
    '  -h, --help                           print this help' \
    '' \
    '-C and --config may be given before or after the subcommand; -h is asked' \
    'for on its own.' \
    '' \
    'chunk, embed and search are Tier B: each needs an `index` block in okf.json.' \
    '' \
    'Exit codes:' \
    '  0  success' \
    '  1  error, or a missing prerequisite' \
    '  2  a Tier B subcommand was invoked without an `index` block in okf.json' \
    '  3  `check --strict` found drift'
}

die() { # $1.. = message lines
  local line
  for line in "$@"; do
    printf 'okf: %s\n' "$line" >&2
  done
  exit 1
}

# Placeholder for a subcommand that dispatch recognises but that has not been
# built yet. Exits 1 — "recognised" is not "succeeded", and a stub that exited 0
# would let a caller mistake doing nothing for having done the work.
not_implemented() { # $1 = subcommand name
  die "$1 is not implemented yet"
}

# ---------------------------------------------------------------------------
# Preflight (SPEC.md §3)
# ---------------------------------------------------------------------------

# Everything bin/okf shells out to, in SPEC.md §3's order. jq and rg are on
# this list as hard requirements and not as niceties: install.sh can fall back
# to a jq-less permission merge, but nothing okf does — reading okf.json,
# counting fan-in — has a fallback, and a half-finished run is worse than a
# refusal. bash is listed because §3 lists it; see have_tool for how it is
# checked.
OKF_REQUIRED_TOOLS=(bash git sha256sum awk sed rg jq)

# Needed by Tier B alone, which is the only part of okf that speaks HTTP. Its
# absence degrades okf to Tier A rather than breaking it, so it is required
# only of the invocations that would use it — `okf list` on a machine without
# curl is a perfectly good okf.
#
# Deliberately not announced on the runs it does not affect: a warning printed
# by every `okf list` and every `okf --help` is noise on the many invocations
# that are working perfectly, and stderr is where a caller's pipeline reads its
# errors. What SPEC.md §3 asks be said about degradation is said on the one run
# that is degraded, by the subcommand that cannot proceed without it.
OKF_TIER_B_TOOLS=(curl)

# The subcommands that actually reach for those tools. Not the same thing as
# the Tier B subcommands, and the difference matters: SPEC.md §9 has `chunk`
# split a concept body into JSON locally, and only Qdrant — which is to say
# embed and search — go over REST. Demanding curl of `okf chunk` would refuse
# a command that was never going to need it.
#
# Every name here is also in OKF_SUBCOMMANDS, and tests/toolkit.sh checks that,
# that the help still calls each of them Tier B, and that the Tier B
# subcommands left out of this list are not asked for curl.
OKF_HTTP_SUBCOMMANDS=(embed search)

have_tool() { # $1 = command name
  # bash is satisfied by the interpreter already running this script rather
  # than by a PATH lookup: an environment that got as far as this function has
  # bash, whether or not PATH happens to mention it, and reporting it missing
  # there would be a lie the caller cannot act on.
  if [ "$1" = bash ] && [ -n "${BASH_VERSION:-}" ]; then
    return 0
  fi
  command -v -- "$1" > /dev/null 2>&1
}

# Exits 1 naming every one of the given tools that is not installed, all on one
# line: someone who has to install three things wants all three now, not one
# per re-run. Returns 0 when they are all there.
require_tools() { # $1 = trailing clause for the message, may be empty; $2.. = tools
  local why="$1"
  shift

  # The missing ones are accumulated as a string rather than an array: an empty
  # array expanded under `set -u` is an unbound variable on bash 3.2, which is
  # still what macOS ships, and empty is the case on every healthy run.
  local missing="" count=0 tool
  for tool in "$@"; do
    if ! have_tool "$tool"; then
      missing="${missing:+$missing, }$tool"
      count=$((count + 1))
    fi
  done
  [ -n "$missing" ] || return 0

  local noun="tool"
  if [ "$count" -gt 1 ]; then
    noun="tools"
  fi
  die "missing required $noun: $missing$why"
}

# SPEC.md §3's preflight, run on every invocation ahead of both help and
# dispatch — a subcommand that dies halfway through for want of rg has already
# half-written the bundle, and there is no point printing help describing
# subcommands that would every one of them fail.
#
# Takes no arguments on purpose. What it checks does not depend on what was
# asked for, so the SPEC.md §7 global flags cannot throw it off: `okf -C
# some/repo list` preflights exactly as `okf list` does, and does so before
# anything looks at -C's directory.
preflight() {
  require_tools "" "${OKF_REQUIRED_TOOLS[@]}"
}

# The Tier B half of the same check, for the tools SPEC.md §3 needs only there.
# Called from dispatch rather than from main, because that is where the
# subcommand is a name that was matched against OKF_SUBCOMMANDS rather than
# whatever happened to be the first argument — which, with -C DIR and --config
# PATH in the language, is as likely to be a flag as a subcommand.
http_preflight() { # $1 = the subcommand being dispatched, $2.. = its arguments
  local sub="$1" name arg
  shift
  for name in "${OKF_HTTP_SUBCOMMANDS[@]}"; do
    [ "$sub" = "$name" ] || continue

    # SPEC.md §9's one exception: `okf search --hyde-prompt` prints a prompt
    # for the slash command to answer and exits, reaching neither Qdrant nor an
    # embedding endpoint. Refusing that one for want of curl would be the same
    # mistake as demanding it of `okf chunk`. The flag is looked for anywhere
    # in the arguments, since it may as easily follow the query as precede it —
    # but not past a `--`, after which the same word is a query that happens to
    # look like a flag, and that query does have to reach Qdrant.
    if [ "$sub" = search ]; then
      for arg in ${1+"$@"}; do
        if [ "$arg" = -- ]; then
          break
        fi
        if [ "$arg" = --hyde-prompt ]; then
          return 0
        fi
      done
    fi
    # Says why curl is being demanded of `okf search` when `okf list` never
    # mentions it. Without that, the line reads as okf having grown a new
    # requirement rather than as these two subcommands needing something the
    # rest of okf does not.
    local subs="${OKF_HTTP_SUBCOMMANDS[*]}"
    require_tools " (needed only by ${subs// /, }, which reach Qdrant over HTTP)" \
      "${OKF_TIER_B_TOOLS[@]}"
    return 0
  done
  return 0
}

# ---------------------------------------------------------------------------
# Global flags (SPEC.md §7)
# ---------------------------------------------------------------------------

# The two things every subcommand needs before it can resolve a single path:
# where the repo root is, and which settings file describes it. Filled in by
# parse_globals ahead of dispatch, so a subcommand reads these rather than
# reaching for $PWD or the string "okf.json" on its own — the one place -C and
# --config would otherwise have to be honoured ten times over.
OKF_ROOT=""
OKF_CONFIG=""

# Whether --config named that path or it is SPEC.md §7's default. The two are
# the same string to everything downstream but not the same request: SPEC.md §6
# says every field defaults if absent, so a repo with no okf.json is a repo
# using the defaults, while a --config pointing at a file that is not there is a
# caller who meant a particular file and mistyped it. Only the second is an
# error, and nothing but this flag can tell them apart.
OKF_CONFIG_GIVEN=0

# SPEC.md §7's default, `./okf.json`, and SPEC.md §6's "okf.json (repo root)":
# the same file named twice. Relative to the root, so -C moves it too.
OKF_CONFIG_DEFAULT="okf.json"

# What is left of the command line once the global flags are taken out of it —
# the subcommand and its own arguments, in their original order.
OKF_ARGV=()

# Reads the SPEC.md §7 global flags out of the whole command line and leaves
# the rest in OKF_ARGV.
#
# Scanned across the entire line rather than only its head, because SPEC.md §7
# says *every subcommand* accepts these two: `okf check -C ../other` is as
# valid as `okf -C ../other check`. Doing it here, once, is also what keeps
# them out of every future subcommand's own argument parser.
#
# Both values are resolved after the whole line has been read, so the flags are
# order-independent: `okf --config ci.json -C repo list` and `okf -C repo
# --config ci.json list` are the same invocation. Repeating either one is an
# error rather than a last-wins race, because a silently ignored -C is a run
# against the wrong repository.
parse_globals() { # $1.. = the command line, minus the program name
  local dir="" config="" seen_dir=0 seen_config=0 flag
  local -a rest=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # Past `--` the same word is an argument and not a flag of ours,
        # however much it looks like one.
        #
        # Which side of the subcommand it falls on decides whose marker it is.
        # Ahead of the subcommand there is nothing yet for it to belong to, so
        # it is this parser's — consumed, leaving `okf -- list` to run list
        # rather than to look for a subcommand called `--`. After it, it is the
        # subcommand's own end-of-flags marker — `okf search -- --hyde-prompt`
        # is a query that begins with a dash — and is passed along untouched.
        if [ "${#rest[@]}" -eq 0 ]; then
          shift
        fi
        rest+=(${1+"$@"})
        break
        ;;
      -C | --config)
        flag="$1"
        shift
        # An option whose value is missing swallows whatever follows it, and
        # what follows it here is usually the subcommand: `okf -C list` would
        # otherwise run against a directory named "list", or against no
        # subcommand at all.
        [ $# -gt 0 ] || die "$flag needs an argument"
        # A value that is itself a flag is the same slip one argument later:
        # `okf check --config --strict` is a --config whose path was left out,
        # and taking --strict for a filename loses the flag and reads a config
        # that is not there. A file whose name really does begin with a dash is
        # reachable as ./-name, which is how every other tool spells it too.
        case "$1" in
          -*)
            die "$flag needs an argument, but the next word is a flag: $1" \
              "spell it ./$1 if that really is the name"
            ;;
        esac
        if [ "$flag" = -C ]; then
          [ "$seen_dir" -eq 0 ] || die "-C given more than once"
          seen_dir=1
          dir="$1"
        else
          [ "$seen_config" -eq 0 ] || die "--config given more than once"
          # `okf --config list` is a --config that lost its path, not a request
          # to read settings from a file called "list". -C catches the same
          # slip for free, because no such directory exists; --config would
          # otherwise take the subcommand, find nothing left to run, and answer
          # a typo with a page of help.
          local known
          for known in "${OKF_SUBCOMMANDS[@]}"; do
            [ "$1" = "$known" ] || continue
            die "--config needs a path, but was given the subcommand: $1" \
              "spell it ./$1 if that really is the settings file"
          done
          seen_config=1
          config="$1"
        fi
        ;;
      # `--config=PATH` is accepted because it is what anyone used to the GNU
      # tools will type, and left to fall through it would be an okf.json
      # silently not read. Its short counterpart `-CDIR` is deliberately *not*
      # accepted: SPEC.md §7 spells the flag `-C DIR`, and two subcommands take
      # free-form text — `okf search <query>`, `okf fanin <Name>` — which a
      # scan that glued -C to whatever followed it would quietly eat. Left
      # alone, `okf search -Csrc` searches for "-Csrc", and `okf -Csrc list`
      # is rejected by name rather than acted on.
      --config=*)
        [ "$seen_config" -eq 0 ] || die "--config given more than once"
        seen_config=1
        config="${1#--config=}"
        ;;
      *)
        rest+=("$1")
        ;;
    esac
    shift
  done

  if [ "$seen_dir" -eq 1 ]; then
    [ -n "$dir" ] || die "-C needs a directory, not an empty argument"
    # Checked here rather than left to the cd below, so the message names -C
    # and the directory the caller typed instead of reporting a failure from
    # somewhere in the middle of a subcommand.
    [ -d "$dir" ] || die "-C: no such directory: $dir"
    # Made absolute now, while the process is still where the caller invoked
    # it: a relative -C is relative to that directory and to nothing else, and
    # a root that is still relative once entered would resolve differently for
    # any subcommand that itself changes directory.
    # CDPATH is cleared for the cd, not inherited: with it set, a relative -C
    # is looked up along it before the current directory, so `okf -C src` would
    # silently run against someone else's src — and cd would echo the directory
    # it picked into this command substitution on top of it.
    #
    # cd's own diagnostic is silenced for the same reason: it names a line
    # number inside this script, and arrives ahead of the line below that
    # actually says which flag and which directory the caller has to do
    # something about.
    OKF_ROOT="$(CDPATH= cd -- "$dir" 2> /dev/null && pwd)" \
      || die "-C: cannot enter directory: $dir"
  else
    OKF_ROOT="$PWD"
  fi

  # An explicit empty path is a mistake — `--config ""` — and not a request for
  # the default, so it is caught before the resolution below turns it into one.
  if [ "$seen_config" -eq 1 ] && [ -z "$config" ]; then
    die "--config needs a path, not an empty argument"
  fi

  OKF_CONFIG_GIVEN="$seen_config"

  case "$config" in
    "")
      # Not given. SPEC.md §7's default, which is the root's okf.json.
      OKF_CONFIG="$OKF_ROOT/$OKF_CONFIG_DEFAULT"
      ;;
    /*)
      OKF_CONFIG="$config"
      ;;
    *)
      # Relative to the root, not to the caller's directory. -C sets what `.`
      # means for the run — the default config is `./okf.json` in the root — so
      # `okf -C ../other --config okf.ci.json` reads the other repo's CI
      # config, which is the one a caller pairing the two flags means. An
      # absolute path, handled above, is the way to point somewhere else.
      OKF_CONFIG="$OKF_ROOT/$config"
      ;;
  esac

  # ${rest[@]+"..."} rather than "${rest[@]}": an empty array expanded under
  # `set -u` is an unbound variable on bash 3.2, which is still what macOS
  # ships, and empty is exactly the case of a bare `okf -C somewhere`.
  OKF_ARGV=(${rest[@]+"${rest[@]}"})
}

# Clears the git environment variables that would have git answer for a
# different repository than the one okf was pointed at.
#
# `git ls-files` reads GIT_DIR, GIT_WORK_TREE and GIT_INDEX_FILE ahead of the
# directory it is run in, so those three outrank both -C and the caller's own
# cwd. They are not exotic: git exports them to every hook it runs, and to
# everything under `git rebase --exec` — which is exactly where SPEC.md §11 has
# bin/ralph refreshing concepts as part of a commit. An okf that inherited them
# would list another repository's files, and the failure would be silent, since
# none of those paths exists under the real root and what comes out is an empty
# listing exiting 0.
#
# Cleared for the same reason CDPATH is cleared at every cd here, and ripgrep is
# run with --no-config: what okf answers has to depend on the repository it was
# pointed at, and on nothing else that happens to be in the environment.
isolate_git_environment() {
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_CEILING_DIRECTORIES \
    GIT_NAMESPACE
}

# Enters the root, so that every relative path a subcommand touches — and every
# `git ls-files` it runs — resolves against it without that subcommand having
# to remember to. Split from parse_globals so the resolution can be reasoned
# about, and tested, without a process changing directory underneath it.
enter_root() {
  # CDPATH cleared as above. OKF_ROOT is absolute by the time it gets here, so
  # nothing should consult CDPATH at all — but a cd that reads it is one
  # relative path away from entering the wrong tree, and it also prints where
  # it went, which nothing calling this expects on stdout.
  CDPATH= cd -- "$OKF_ROOT" || die "cannot enter the repo root: $OKF_ROOT"
}

# A path as the caller would have typed it: relative to the root when it is
# inside it, absolute when it is not.
#
# Every path okf holds is absolute — parse_globals makes them so, and enter_root
# then moves the process — but "okf.json already exists" is a better line than
# that same sentence with forty characters of temp directory in front of the one
# word that matters. Absolute is kept for anything outside the root, where the
# path is the news: `--config /etc/okf.json` did not write in this repo at all.
display_path() { # $1 = an absolute path
  case "$1" in
    "$OKF_ROOT"/*) printf '%s\n' "${1#"$OKF_ROOT"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The same file, spelled the same way: the directory part resolved, the final
# component left exactly as given. What it is for is telling whether two paths
# okf holds are one file — `--config index.md` and `--config ./index.md` both
# name the bundle root's own index.md, and a plain string comparison sees three
# different paths there.
#
# cd and `pwd -P` rather than realpath, which is not on SPEC.md §3's list, and
# rather than `-ef`, which compares inodes and so can only answer for files
# that already exist — the interesting case here is two paths okf is about to
# create. `-P` and not a plain pwd: a symlinked directory component is exactly
# how two paths that look nothing alike turn out to name one file, and the
# logical pwd would hand back the path as typed and hide it. The final
# component is deliberately left unresolved: a symlink named by it is the link
# and not its target, which is what init_guard refuses.
#
# A directory that does not exist cannot be resolved, so the path is returned
# as it came. That is the right answer for a comparison — an unresolvable path
# is not demonstrably the same file as anything — and the write that follows
# reports the missing directory itself.
canonical_path() { # $1 = an absolute path
  local dir="${1%/*}" base="${1##*/}" resolved

  [ -n "$dir" ] || dir="/"
  # CDPATH cleared and stderr silenced for the reasons every other cd here is.
  resolved="$(CDPATH= cd -- "$dir" 2> /dev/null && pwd -P)" || {
    printf '%s\n' "$1"
    return 0
  }
  case "$resolved" in
    */) printf '%s%s\n' "$resolved" "$base" ;;
    *) printf '%s/%s\n' "$resolved" "$base" ;;
  esac
}

# ---------------------------------------------------------------------------
# Settings (SPEC.md §6)
# ---------------------------------------------------------------------------

# The effective settings for this run: SPEC.md §6's defaults with the repo's
# okf.json laid over them. Read once and kept, because several subcommands ask
# for several of its lists and each ask is a jq process.
OKF_SETTINGS=""
OKF_SETTINGS_LOADED=0

# Resolves okf.json against the defaults, per SPEC.md §6's "every field defaults
# if absent".
#
# The overlay is jq's `*`, which merges objects recursively and lets the
# right-hand side win — so a repo that sets only `bundle.include` keeps §6's
# `exclude` and `extensions`, and an `index` block, which the defaults
# deliberately have not got, arrives intact. Arrays replace rather than
# concatenate, which is what a caller narrowing `extensions` to `["java"]`
# means; a `*` that appended would leave them with all eight and no way back.
#
# OKF_DEFAULT_CONFIG is reused as the left-hand side rather than a second
# transcription of §6, so `okf init` and every later run agree on what a field
# means when it is missing — including in a repo that never ran init.
load_settings() {
  [ "$OKF_SETTINGS_LOADED" -eq 0 ] || return 0

  # `-L` as well as `-e`, so a symlink pointing at nothing is diagnosed as the
  # broken settings file it is rather than silently taken for no settings at
  # all.
  if [ -e "$OKF_CONFIG" ] || [ -L "$OKF_CONFIG" ]; then
    [ -f "$OKF_CONFIG" ] || die "$(display_path "$OKF_CONFIG") is not a regular file"
    [ -r "$OKF_CONFIG" ] || die "$(display_path "$OKF_CONFIG") is not readable"

    local merged
    # jq reads the file itself, so its parse errors name it. --slurpfile rather
    # than plain input because it makes "how many JSON values are in there?"
    # answerable: an empty okf.json and a file with two objects in it are both
    # mistakes, and both would otherwise pass as something.
    merged="$(jq -n --argjson defaults "$OKF_DEFAULT_CONFIG" \
      --slurpfile given "$OKF_CONFIG" '
        if ($given | length) != 1 then
          error("expected one JSON object, found "
            + (($given | length) | tostring) + " JSON values")
        elif ($given[0] | type) != "object" then
          error("expected a JSON object, found " + ($given[0] | type))
        else
          ($defaults * $given[0]) as $merged
          | if ($merged.bundle | type) != "object" then
              error("bundle must be a JSON object, found " + ($merged.bundle | type))
            else $merged end
        end' 2>&1)" \
      || die "cannot read settings from $(display_path "$OKF_CONFIG")" "$merged"
    OKF_SETTINGS="$merged"
  elif [ "$OKF_CONFIG_GIVEN" -eq 1 ]; then
    # See OKF_CONFIG_GIVEN: a path the caller named and okf cannot find is a
    # typo, not a request for the defaults.
    die "--config: no such file: $(display_path "$OKF_CONFIG")"
  else
    OKF_SETTINGS="$OKF_DEFAULT_CONFIG"
  fi

  # SPEC.md §6 gives `bundle.root` a default of `.` and says nothing else about
  # it, and nothing in okf acts on any other value: the bundle root is the repo
  # root, which is what -C DIR moves. A setting nothing reads is worse than one
  # that is not there — the caller has said where the bundle is and been ignored
  # — so a root that is anything but the default is refused rather than quietly
  # treated as the default. Whichever checklist item teaches okf to honour it
  # replaces this.
  # stderr to /dev/null: the merge above has already settled that `.bundle` is
  # an object, so there is nothing left here for jq to complain about, and a
  # diagnostic naming `<stdin>` would arrive ahead of okf's own line if there
  # ever were.
  local root
  root="$(printf '%s\n' "$OKF_SETTINGS" \
    | jq -r '.bundle.root // "." | tostring' 2> /dev/null)" \
    || die "cannot read bundle.root from $(display_path "$OKF_CONFIG")"
  case "$root" in
    . | ./ | "") ;;
    *)
      die "bundle.root is set to \"$root\" in $(display_path "$OKF_CONFIG")" \
        "okf does not act on it yet: the bundle root is the repo root" \
        "use -C DIR to run against another root, and set bundle.root back to \".\""
      ;;
  esac

  OKF_SETTINGS_LOADED=1
}

# One of SPEC.md §6's lists of strings, one per line.
#
# load_settings has already laid §6's defaults underneath, so every list §6
# defines is there by the time this runs and a `null` cannot mean "not
# configured" — it can only be one somebody wrote, and jq's `*` merge lets it
# override the default it was written over. `{"exclude": null}` would otherwise
# read as an empty exclude list and quietly put the whole build directory in
# scope, which is the one wrong shape a type check would let through. Refused by
# name instead, alongside every other wrong shape; an exclude list of nothing is
# spelled `[]`.
#
# An empty string in one of these lists is refused here too, and refused here
# rather than in the caller: by the time the caller reads this back, an empty
# list and a list holding one empty string are both a single blank line and
# cannot be told apart. Dropped as unusable, `"include": [""]` would leave no
# include patterns at all, which reads as no narrowing — and so would put the
# whole repository in scope for a setting nobody could act on.
#
# Newline-separated rather than NUL-separated, and a value containing a newline
# is refused rather than supported: these are globs and file extensions, a
# newline in one could only be a mistake, and every caller reads the result back
# through a command substitution, which drops NUL bytes.
#
# The key path arrives as jq's own $ARGS.positional rather than interpolated
# into the program text, so nothing here has to reason about quoting.
settings_strings() { # $1.. = the path to a list, e.g. `bundle include`
  load_settings

  local label="" part
  for part in "$@"; do
    label="$label.$part"
  done

  local out
  out="$(printf '%s\n' "$OKF_SETTINGS" | jq -r '
      getpath($ARGS.positional) as $list
      | if ($list | type) != "array" then
          error("must be a list, found " + ($list | type))
        else $list end
      | map(
          if type != "string" then
            error("must hold strings, found " + type)
          elif . == "" then
            error("must not hold an empty value")
          elif contains([10] | implode) then
            error("must not hold a value with a newline in it")
          else . end)
      | .[]' --args "$@" 2>&1)" \
    || die "$(display_path "$OKF_CONFIG"): $label ${out#jq: error*: }"

  printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Scope (SPEC.md §5)
# ---------------------------------------------------------------------------

# SPEC.md §5's last exclusion: "files carrying a `@Generated`-style annotation".
#
# What has to be told apart here is a file a generator wrote from a file that
# merely says the word. Four branches, each shaped by how one family of language
# actually writes the marker, and each narrow enough that prose does not fit:
#
#   `^@Generated(`     the annotation on the file's top-level type, which in
#                      every language that has annotations sits in column 0 —
#                      bare, or package-qualified as `@javax.annotation.Generated`.
#   `^ * @generated`   the same fact inside a comment, at any indentation: the
#                      docblock convention JavaScript and Flow use puts it on a
#                      javadoc continuation line, and `#` languages put it in a
#                      header comment.
#   Go's header        which has no annotations and so states it in the only
#                      form it has, in a shape its own tooling defines exactly.
#
# Every branch that anchors on the end of a line allows a `\r` before it, so a
# repository checked out with CRLF line endings is scanned the same as one
# without: without that, a generated file would read as hand-written on Windows
# and on any checkout configured for it.
#
# Three narrowings do the work of telling a marker from a sentence, and each one
# is a hand-written file that would otherwise be dropped from the bundle in
# silence:
#
#   * Column 0, for the annotation form. A member annotation is indented and a
#     type annotation is not, so a hand-written class carrying one generated
#     `@Generated("lombok")` accessor stays — losing a whole file to one
#     generated method would lose exactly the code most worth documenting.
#   * Nothing after the marker but its own argument list or the end of the line.
#     Column 0 alone cannot tell an annotation from prose in a language whose
#     string literals reach it: a Python docstring opening a line with
#     "@generated is what the codegen writes" is a sentence. This is also what
#     keeps `@NotGenerated(...)` and `@regenerated` out — the name must be
#     `Generated` itself, or a qualified path ending in it, and not merely end
#     with the letters.
#   * Lower case, for the comment form. `@generated` in a comment is the
#     docblock convention, whereas `@Generated` is the name of a Java annotation
#     — and Java writes that annotation in the code, never in a comment. So a
#     comment naming it, as in `// @Generated marks the classes our codegen
#     owns`, is a sentence about the annotation and not a marker.
#   * Nothing after the comment form either, unless it closes the comment —
#     `/* @generated */` is the whole of one — or it is the provenance a
#     generator stamps beside it: `by`, `from`, `with`, or Facebook's
#     `SignedSource`. That list is short because the real conventions are, and
#     it is what separates `# @generated by codegen` from `# @generated is the
#     marker our codegen writes` — the same shape, one a marker and one a
#     sentence about markers. A generator that words its provenance some other
#     way is missed, and a generated file left in the listing is at least a
#     visible mistake; a hand-written file dropped from the bundle is not.
#
# JPA's `@GeneratedValue`, an ordinary field annotation on hand-written code, is
# kept out by all of them at once.
#
# Deliberately no bare "DO NOT EDIT": that phrase turns up in hand-written
# configuration and in comments about generated files, and dropping a source
# from the bundle is a silent loss, so the marker has to be one nothing but a
# generator writes.
#
# Written without a repeated group — `[A-Za-z_.]*` rather than
# `([A-Za-z_][A-Za-z0-9_]*\.)*` — because ripgrep 14.1.0 silently stops matching
# a repeated group once a second pattern is in play, and this pattern has four.
OKF_GENERATED_MARKER='^@[Gg]enerated(\(|\r?$)|^@[A-Za-z_.]*\.[Gg]enerated(\(|\r?$)|^[[:space:]]*[/#*]+[[:space:]]*@generated([[:space:]]+(by|from|with|SignedSource)\b|[[:space:]]*\*/|\(|\r?$)|^//[[:space:]]*Code generated .* DO NOT EDIT\.\r?$'

# How many paths go to ripgrep at once. One process for the whole repo would be
# ideal and one per file would be slow; a batch keeps the argument list well
# inside any ARG_MAX while leaving a normal repo at a single invocation.
OKF_GENERATED_BATCH=400

# The in-scope sources, bundle-relative and sorted, as `load_in_scope` left them.
OKF_IN_SCOPE=()

# The repo's concept files, bundle-relative and sorted, as `load_concepts` left
# them.
OKF_CONCEPTS=()

# The repo's tracked paths, bundle-relative and sorted, as `load_tracked_paths`
# left them.
OKF_TRACKED=()

# The file extensions in scope, as `load_bundle_globs` read them from the
# settings.
OKF_EXTENSIONS=()

# SPEC.md §6's `include` and `exclude`, compiled to the anchored regular
# expressions matches_any wants, as `load_bundle_globs` left them.
OKF_INCLUDE_RES=()
OKF_EXCLUDE_RES=()

# `git ls-files` is how SPEC.md §5's first exclusion — "anything gitignored" —
# is honoured, so a bundle root outside a work tree is not a scope okf can
# answer for. Said here rather than left to git, whose own line is about a
# missing .git directory and does not mention okf or the root it was pointed at.
require_git_repo() {
  local inside
  inside="$(git rev-parse --is-inside-work-tree 2> /dev/null)" || inside=""
  [ "$inside" = "true" ] || die "not inside a git work tree: $OKF_ROOT" \
    "okf reads the repo's scope from git ls-files, which needs one"
}

# Compiles SPEC.md §6's `include` and `exclude` into the anchored regular
# expressions matches_any wants, and reads `extensions` alongside them.
#
# Its own function rather than the head of load_in_scope because the orphan
# listing needs the same bundle boundary: it asks these globs about a concept's
# `resource`, which is a source path like any other. Transcribed a second time,
# the two listings could disagree about the edges of one bundle — `okf list` and
# `okf list --orphans` answering for different repositories — and the
# disagreement would surface only as a concept nobody could account for.
load_bundle_globs() {
  load_settings

  # Assigned on their own lines, not as `local x="$(...)"`: `local` returns
  # success whatever the command substitution did, which would swallow both
  # `set -e` and the status of a settings_strings that died inside the subshell
  # having already printed why.
  local includes excludes extensions
  includes="$(settings_strings bundle include)" || exit 1
  excludes="$(settings_strings bundle exclude)" || exit 1
  extensions="$(settings_strings bundle extensions)" || exit 1

  OKF_INCLUDE_RES=()
  OKF_EXCLUDE_RES=()
  local pattern
  # The blank line is the empty list, not an empty pattern: settings_strings
  # refuses an empty string outright, and a here-string of nothing is still one
  # line. Past it, bundle_pattern always answers with a pattern — the bundle
  # root comes back as `**` rather than as nothing — so there is nothing else
  # here to skip.
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    check_supported_glob "$pattern" .bundle.include
    OKF_INCLUDE_RES+=("$(glob_regex "$(bundle_pattern "$pattern")")")
  done <<< "$includes"
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    check_supported_glob "$pattern" .bundle.exclude
    OKF_EXCLUDE_RES+=("$(glob_regex "$(bundle_pattern "$pattern")")")
  done <<< "$excludes"

  OKF_EXTENSIONS=()
  local ext
  while IFS= read -r ext; do
    [ -n "$ext" ] || continue
    # A settings file that spells them `.java` means the same thing as `java`.
    OKF_EXTENSIONS+=("${ext#.}")
  done <<< "$extensions"
}

# Whether a bundle-relative path is inside the bundle SPEC.md §6's `include` and
# `exclude` describe. `exclude` is asked first, because it is the one that can
# take a path back out of an `include` that reached it.
in_bundle_globs() { # $1 = a bundle-relative path
  if matches_any "$1" ${OKF_EXCLUDE_RES[@]+"${OKF_EXCLUDE_RES[@]}"}; then
    return 1
  fi
  # An include list that narrows nothing is no narrowing rather than no files:
  # `include` is the filter, and with nothing to filter by there is nothing
  # filtered out.
  if [ "${#OKF_INCLUDE_RES[@]}" -gt 0 ]; then
    matches_any "$1" "${OKF_INCLUDE_RES[@]}" || return 1
  fi
  return 0
}

# Fills OKF_TRACKED with every path `git ls-files` names, in git's order and
# without git's repeats.
#
# No pathspec: the whole index comes out here and each caller narrows it
# afterwards, because `include` and `exclude` have to be matched by one matcher
# and git's cannot be the one — see glob_regex.
load_tracked_paths() {
  local -a records=()
  local record
  while IFS= read -r -d '' record; do
    records+=("$record")
  done < <(
    # A process substitution's exit status is invisible to the shell reading it,
    # so git's is carried out as one more NUL record. Without it, a git that
    # failed — an unreadable index, a repository in a state it will not answer
    # for — would be an empty listing reported as a repo with nothing in scope.
    # `set +e` because the errexit inherited here would otherwise take the
    # subshell down before the status could be written.
    set +e
    git ls-files -z
    printf 'status:%s\0' "$?"
  )

  local count="${#records[@]}"
  [ "$count" -gt 0 ] \
    || die "git ls-files wrote nothing at all, not even its exit status"
  local status="${records[$((count - 1))]}"
  unset "records[$((count - 1))]"
  [ "$status" = "status:0" ] \
    || die "git ls-files failed in $OKF_ROOT — see its message above"

  OKF_TRACKED=()
  local previous="" path
  for path in ${records[@]+"${records[@]}"}; do
    # `git ls-files` prints an unmerged path once per stage, so a repo stopped
    # in the middle of a conflicted merge names the same file three times. The
    # listing is sorted, so the repeats are adjacent.
    [ "$path" != "$previous" ] || continue
    previous="$path"
    OKF_TRACKED+=("$path")
  done
}

# Refuses the gitignore constructs glob_regex does not implement, rather than
# letting them through to be escaped into literals that can never match. Every
# other setting of the wrong shape is refused by name; a `[Gg]` that quietly
# excluded nothing at all would be the one that was not.
check_supported_glob() { # $1 = a glob from okf.json, $2 = the key it came from
  local where
  where="$(display_path "$OKF_CONFIG"): $2"
  case "$1" in
    '!'*)
      die "$where: a leading ! is gitignore's negation, which okf has not got: $1" \
        "an exclude is undone by narrowing include, not by negating the exclude"
      ;;
    *'['* | *']'* | *'\'*)
      die "$where: okf's globs have no character classes and no escapes: $1" \
        "its wildcards are **, * and ?"
      ;;
    # The whole bundle, however it is spelled. Named here so the segment check
    # below does not read the `.` in it as a segment going nowhere.
    . | ./ | /) return 0 ;;
  esac

  # A `..` names something outside the bundle and a bare `.` names a step that
  # goes nowhere, and okf matches the paths git lists — which have neither in
  # them, so either one is a pattern that can only ever match nothing. Wrapped
  # in separators so the test is on whole segments: a directory called `..stuff`
  # is a perfectly ordinary name.
  local segments="/${1#./}/"
  case "$segments" in
    */../* | */./*)
      die "$where: a glob cannot contain a . or a .. segment: $1" \
        "okf matches the paths under the bundle root that git lists, and they have neither"
      ;;
  esac
}

# One of SPEC.md §6's globs, spelled the one way the matcher below expects, or
# nothing when it says nothing.
#
# Only what is genuinely redundant is folded away: a leading `./`, which says
# nothing a bare name does not, and a run of trailing separators, which is one
# separator. The leading `/` and the single trailing `/` are both left in place
# and both mean something to glob_regex — anchored to the bundle root, and names
# a directory. A leading `/` is SPEC.md §4's bundle-absolute spelling and
# gitignore's anchor at once, and the two say the same thing: measured from the
# bundle root and from nowhere else.
#
# A pattern that says only that — `.`, `/`, `./` — is the whole bundle, and
# comes back as the `**` that says so. See the case at the end for why that is
# not the same as dropping it.
bundle_pattern() { # $1 = a glob from okf.json
  local pattern="$1"

  # `./x` becomes `/x` rather than `x`: both spellings say "x at the bundle
  # root", and it is the leading `/` that carries that here. Stripped to a bare
  # `x`, the pattern would be one with no `/` in it, which glob_regex reads as
  # matching at any depth — `./src` would start matching `vendor/src/`.
  #
  # `./?*` and not `./*`: a bare `./` is the bundle root itself, and stripping
  # it to nothing would lose that rather than shorten it.
  local anchor=""
  while :; do
    case "$pattern" in
      ./?*)
        pattern="${pattern#./}"
        anchor="/"
        ;;
      *) break ;;
    esac
  done
  pattern="$anchor$pattern"

  # A run of separators is one separator, wherever it falls: `src//**` is
  # `src/**` written twice over, and left alone it compiles to a regular
  # expression with a `//` in it that no path can match — an include that
  # silently selects nothing.
  while :; do
    case "$pattern" in
      *//*) pattern="${pattern%%//*}/${pattern#*//}" ;;
      *) break ;;
    esac
  done

  # The bundle root, however it is spelled, is the whole bundle — and is written
  # out as such rather than dropped. Dropped, it would read as "narrows
  # nothing", which is the right answer for `include` and the exact opposite of
  # it for `exclude`: `"exclude": ["/"]` means every file, not no files.
  case "$pattern" in
    . | / | ./) pattern="**" ;;
  esac

  printf '%s\n' "$pattern"
}

# One of SPEC.md §6's globs as an anchored extended regular expression, which is
# what bash's `=~` matches paths with.
#
# The dialect is gitignore's, because that is the one every `exclude` glob in
# §6's defaults is written in and the one anybody editing okf.json will expect:
#
#   `**`      a whole path component of nothing but asterisks: any run of
#             characters, `/` included
#   `**/`     the same at the head of a component: any number of directories,
#             none among them
#   `*`       any run of characters within a single path component — and so is
#             a `**` that is not a whole component of its own, which is what
#             makes `src/**.ts` the same pattern as `src/*.ts`
#   `?`       one character, but not `/`
#   anything else, literally
#
# Gitignore's remaining constructs — `!` negation, `[...]` classes, backslash
# escapes — are not implemented, and check_supported_glob refuses a pattern that
# uses one rather than letting this function escape it into a literal nobody
# meant and nothing matches.
#
# And gitignore's two rules about the separator, which are what decide where a
# pattern is measured from and how far down it reaches:
#
#   * A `/` anywhere but at the end anchors the pattern to the bundle root, and
#     a leading `/` anchors it while saying nothing else. A pattern with no `/`
#     in it — `target`, `*.min.js` — matches at any depth, which is what makes
#     the obvious `"exclude": ["target"]` reach `src/target/` and not only a
#     `target/` sitting at the root.
#   * Every pattern matches what is under it as well as itself, because okf only
#     ever matches file paths and a pattern naming a directory would otherwise
#     match nothing at all: `git ls-files` prints no directories for `vendor` or
#     `**/vendor/` to match. A trailing `/` says the pattern names a directory,
#     and then it is only the contents that match.
#
# Written here rather than handed to `git ls-files` as a `:(glob,exclude)`
# pathspec, which is where this started: git derives a common directory prefix
# from the positive pathspecs and matches the negative ones against paths with
# that prefix already taken off, so `**/vendor/**` stops excluding as soon as
# every include shares one directory — and a second exclude that matches nothing
# at all can empty the listing outright (git 2.43). Matching both lists here
# instead also means include and exclude cannot disagree about what a pattern
# means, which two matchers eventually would.
glob_regex() { # $1 = a normalised glob
  local rest="$1" out tail='(/.*)?$' ch anchored=0

  case "$rest" in
    */)
      rest="${rest%/}"
      tail='/.*$'
      ;;
  esac

  case "$rest" in
    /*)
      anchored=1
      rest="${rest#/}"
      ;;
    */*) anchored=1 ;;
  esac

  if [ "$anchored" -eq 1 ]; then
    out="^"
  else
    out="^(.*/)?"
  fi

  # Whether the next character starts a whole path component, which is what
  # decides between gitignore's two readings of `**`: a component that is
  # nothing but `**` crosses separators, and asterisks anywhere else are a
  # plain `*` however many of them there are. `src/**.ts` is `src/*.ts`.
  local at_component=1

  while [ -n "$rest" ]; do
    case "$rest" in
      '**/'*)
        if [ "$at_component" -eq 1 ]; then
          out="$out(.*/)?"
          rest="${rest#'**/'}"
          at_component=1
          continue
        fi
        ;;
      '**')
        if [ "$at_component" -eq 1 ]; then
          out="$out.*"
          rest=""
          continue
        fi
        ;;
    esac

    case "$rest" in
      '*'*)
        # A run of asterisks that is not a whole component: one `*`, per
        # gitignore's "other consecutive asterisks are considered regular
        # asterisks".
        while :; do
          case "$rest" in
            '*'*) rest="${rest#'*'}" ;;
            *) break ;;
          esac
        done
        out="$out[^/]*"
        at_component=0
        ;;
      '?'*)
        out="$out[^/]"
        rest="${rest#?}"
        at_component=0
        ;;
      /*)
        out="$out/"
        rest="${rest#/}"
        at_component=1
        ;;
      *)
        # The first character, taken by removing everything after it. Only the
        # extended regular expression metacharacters are escaped: a backslash
        # before an ordinary character is undefined in POSIX ERE, so escaping
        # everything would be the less safe of the two. `*`, `?` and `/` are not
        # on the list because the branches above have already taken every one of
        # them.
        ch="${rest%"${rest#?}"}"
        case "$ch" in
          '\' | '.' | '[' | ']' | '(' | ')' | '{' | '}' | '+' | '|' | '^' | '$')
            out="$out\\$ch"
            ;;
          *) out="$out$ch" ;;
        esac
        rest="${rest#?}"
        at_component=0
        ;;
    esac
  done

  printf '%s%s\n' "$out" "$tail"
}

# Whether a path matches any of the given anchored regular expressions. No
# expressions is no match, which is what leaves an empty `exclude` excluding
# nothing.
matches_any() { # $1 = a bundle-relative path, $2.. = anchored regular expressions
  local path="$1" expression
  shift
  # ${1+"$@"} rather than "$@": under `set -u` an empty "$@" is an unbound
  # variable on bash 3.2, which is still what macOS ships, and empty is exactly
  # the case of an `exclude` list with nothing in it.
  for expression in ${1+"$@"}; do
    # Unquoted on the right, which is what makes bash read it as a pattern
    # rather than as the literal text of one.
    if [[ $path =~ $expression ]]; then
      return 0
    fi
  done
  return 1
}

# Whether a path's extension is one of SPEC.md §6's `extensions`.
#
# Matched exactly as written, not case-folded: the settings say `java`, every
# toolchain in §6's default list writes its extension in lower case, and folding
# would need a tool SPEC.md §3 does not list. A project whose sources are `.CBL`
# spells it `CBL` in okf.json.
#
# An empty list is no restriction rather than no files: `extensions` narrows the
# listing, and there is nothing to narrow by. A file whose name has no dot in it
# past a leading one has no extension at all, so `.gitignore` is not a file with
# a `gitignore` extension.
in_scope_extension() { # $1 = a bundle-relative path
  [ "${#OKF_EXTENSIONS[@]}" -gt 0 ] || return 0

  local name="${1##*/}" ext want
  name="${name#.}"
  case "$name" in
    *.*) ext="${name##*.}" ;;
    *) return 1 ;;
  esac

  for want in "${OKF_EXTENSIONS[@]}"; do
    [ "$ext" = "$want" ] || continue
    return 0
  done
  return 1
}

# Appends the given paths to OKF_IN_SCOPE, in the order given, minus the ones
# carrying a generated marker.
#
# One batch, one ripgrep, and the membership test that follows is over that
# batch alone. That bound is the point of batching, not the argument list: the
# test is a substring search per path over a string holding the batch's
# generated paths, so what it costs depends on OKF_GENERATED_BATCH and not on
# how big the repository is. Over the whole repository at once it would be
# quadratic in the file count, and worst exactly where it matters — a repo that
# is mostly generated code has both the most paths to test and the longest
# string to test them against.
#
# The paths are joined by newlines and each wrapped in them, so the test is on
# whole paths and not on any path that ends in another. That is exact for every
# path without a newline in it; one that has a newline is legal, vanishingly
# rare and cheap to notice, and falls back to a scan of the batch's generated
# paths rather than being matched against the wrong entry.
keep_hand_written() { # $1.. = one batch of candidate paths
  local -a generated=()
  local record
  while IFS= read -r -d '' record; do
    generated+=("$record")
  done < <(
    # ripgrep's status carried out in the stream, since a process
    # substitution's own is invisible to the shell reading it. Without it a
    # ripgrep that failed outright would hand back no generated paths at all —
    # which reads exactly like a batch with none, and would put every generated
    # file in the bundle with nothing said. `set +e` so the errexit inherited
    # here does not act on the 1 that means "nothing matched", which is the
    # ordinary answer for a hand-written repo.
    set +e
    rg --no-config --no-ignore --files-with-matches --null \
      -e "$OKF_GENERATED_MARKER" -- "$@"
    printf 'status:%s\0' "$?"
  )

  local count="${#generated[@]}"
  [ "$count" -gt 0 ] \
    || die "the generated-source scan wrote nothing at all, not even its exit status"
  local status="${generated[$((count - 1))]}"
  unset "generated[$((count - 1))]"
  case "$status" in
    # Matched, or matched nothing. Anything else is a scan that did not happen,
    # and a scan that did not happen looks exactly like a batch with no
    # generated code — so it is said rather than acted on. ripgrep's own
    # message, naming the file it could not read, has already gone to stderr.
    status:0 | status:1) ;;
    *)
      die "ripgrep could not scan for generated sources — see its message above" \
        "okf cannot tell which of these files a generator wrote, so it will not guess"
      ;;
  esac

  local newline='
'
  local blob="" joined=1
  for record in ${generated[@]+"${generated[@]}"}; do
    case "$record" in
      *"$newline"*)
        joined=0
        break
        ;;
    esac
    blob="$blob$record$newline"
  done
  blob="$newline$blob"

  local path marked
  for path in "$@"; do
    if [ "$joined" -eq 1 ]; then
      case "$blob" in
        *"$newline$path$newline"*) marked=1 ;;
        *) marked=0 ;;
      esac
    else
      marked=0
      for record in ${generated[@]+"${generated[@]}"}; do
        if [ "$record" = "$path" ]; then
          marked=1
          break
        fi
      done
    fi
    [ "$marked" -eq 0 ] || continue
    OKF_IN_SCOPE+=("$path")
  done
}

# Fills OKF_IN_SCOPE with the repo's in-scope sources: SPEC.md §5's exclusions
# applied to `git ls-files`, narrowed by SPEC.md §6's include, exclude and
# extensions.
#
# The exclusions divide up as follows. Gitignored files are absent from
# `git ls-files` to begin with — which also settles the one case where "is it
# ignored?" has two answers: a file somebody committed with `git add -f` matches
# an ignore rule and is tracked anyway, and git does not ignore it. Neither does
# okf. A file deliberately put under version control is part of what the repo
# says it is, and a repo that wants it out of the bundle as well says so in
# `exclude`, where it can be seen.
#
# Build and output directories and vendored trees
# are `exclude` globs, and nothing here hard-codes either: a list okf applied on
# top of the settings would be one no okf.json could take back out, and §6 makes
# `exclude` the place that decision is written down.
#
# That leaves one gap worth naming: §5 calls out vendored trees and §6's default
# `exclude` covers only the build and output directories — `target`, `build`,
# `node_modules`, `dist` — so a repo with a `vendor/` tree and no okf.json lists
# it. §6 is where that is settled and §6 is read-only, so the answer is a
# `**/vendor/**` in the repo's own okf.json, which is what tests/fixtures/scoped
# does.
#
# The `@Generated` scan is the one that has to read files, so it runs last, over
# what is left.
load_in_scope() {
  require_git_repo
  load_bundle_globs
  load_tracked_paths

  local -a candidates=()
  local path
  for path in ${OKF_TRACKED[@]+"${OKF_TRACKED[@]}"}; do
    # Extension first: it is the cheapest of the three and, on the repos §6's
    # defaults describe, the one that rules out the most.
    in_scope_extension "$path" || continue
    # A tracked symbolic link is a path whose content, as far as git is
    # concerned, is the target it names and not the source at the end of it.
    # Following one would put a second concept beside a file that already has
    # its own — SPEC.md §5 co-locates one concept per declared type, and a link
    # is not a second declaration — and the two would then drift apart
    # independently. A link out of the work tree is worse: what `okf check`
    # would take a sha256 of is content git does not version at all. Tested
    # before `-f`, which follows the link and would answer for its target.
    [ ! -L "$path" ] || continue
    # `git ls-files` answers from the index, which still holds a file that has
    # been deleted from the working tree and not yet staged as removed. Nothing
    # downstream of this listing can do anything with a path that is not there —
    # not the @Generated scan below, not the sha256 `okf check` will want, and
    # not the read a slash command has to do to document it.
    [ -f "$path" ] || continue
    in_bundle_globs "$path" || continue
    candidates+=("$path")
  done

  OKF_IN_SCOPE=()
  [ "${#candidates[@]}" -gt 0 ] || return 0

  # The @Generated scan, in batches: one ripgrep per batch, and each batch
  # filtered against its own results before the next one starts. Batching keeps
  # the argument list well inside any ARG_MAX, and — see keep_hand_written —
  # keeps the cost of deciding which paths came back bounded by the batch rather
  # than by the size of the repository.
  local -a batch=()
  for path in "${candidates[@]}"; do
    batch+=("$path")
    if [ "${#batch[@]}" -ge "$OKF_GENERATED_BATCH" ]; then
      keep_hand_written "${batch[@]}"
      batch=()
    fi
  done
  [ "${#batch[@]}" -eq 0 ] || keep_hand_written "${batch[@]}"
}

# ---------------------------------------------------------------------------
# Co-location (SPEC.md §5)
# ---------------------------------------------------------------------------

# SPEC.md §4's reserved OKF filenames. Neither is ever a source's concept:
# `index.md` is the directory's own document — `type: Package`, or `type:
# Codebase` at the bundle root — and `log.md` is left to OKF's own semantics and
# is never generated.
OKF_RESERVED_CONCEPT_NAMES=(index.md log.md)

# Whether a file carries a SPEC.md §4 frontmatter block: `---` on line 1, closed
# by the next line that is exactly `---`. Both ends are checked, because a file
# that opens one and never closes it is the half-written concept this is here to
# tell from a whole one.
#
# Whether the block *says* anything in particular is not asked. Which fields are
# in there is the frontmatter reader a later PLAN.md item builds; what is being
# asked here is only whether there is frontmatter at all.
has_frontmatter() { # $1 = a path to a file
  local line opened=0
  # `|| [ -n "$line" ]` so a last line with no newline after it is still read.
  while IFS= read -r line || [ -n "$line" ]; do
    # A checkout with CRLF line endings ends every line with a `\r`, and an
    # editor on Windows opens the file with a UTF-8 BOM. Neither changes what
    # the line says, and neither may turn a concept into something unrecognised
    # — a source whose concept goes unrecognised is one that never comes off
    # `okf list --missing`.
    line="${line#$'\xef\xbb\xbf'}"
    line="${line%$'\r'}"
    if [ "$opened" -eq 0 ]; then
      [ "$line" = "---" ] || return 1
      opened=1
      continue
    fi
    [ "$line" != "---" ] || return 0
  # stderr redirected before the input, and not after it: the order is the
  # order they are opened in, and a `2> /dev/null` written second is set up too
  # late to catch the shell's own complaint about the first. A concept whose
  # permissions have been taken away is answered by the source turning up in
  # `okf list --missing`, which is a line the caller can act on — not by a
  # "Permission denied" carrying a line number from inside this script.
  done 2> /dev/null < "$1"
  # Falls through for an empty file, one that opens a block it never closes, and
  # one that could not be read at all — none of them a concept.
  return 1
}

# Whether a source has the co-located concept SPEC.md §5 puts beside it:
# `UserException.java` -> `UserException.md` in the same directory. Returns 0
# when it is there, 1 when it is not. The path is bundle-relative, as everything
# out of `load_in_scope` is, and is resolved against the root okf is standing
# in.
#
# The stem is the name minus its final extension, so the concept for
# `helper.ts` is `helper.md` and not `helper.ts.md`. A name that is all
# extension — a dotfile such as `.gitignore` — keeps its whole name, because
# stripping it would leave nothing and every dotfile in a directory would then
# share the one concept `.md`.
#
# Only `<stem>.md` is looked for, never the `<stem>.<TypeName>.md` files §5
# gives a file's *additional* top-level types: §5 also says the first or
# same-named type takes `<stem>.md`, so a documented source always has that one.
# Which types a file declares is Claude's to know and not the shell's — see
# SPEC.md §1's division of labour — so the additional files cannot be predicted
# here anyway.
#
# Existence on disk, not `git ls-files`: a concept written by /okf-generate and
# not yet committed is a concept, and a run of `okf list --missing` straight
# after generating is the obvious way to see what is left.
#
# One thing this cannot see, deliberately: two sources in one directory sharing
# a stem — `helper.ts` beside `helper.py` — share `helper.md`, so documenting
# either covers both. Telling them apart means reading the concept's `resource`
# field, which is the frontmatter reader a later PLAN.md item builds; until then
# the answer here is the mechanical one §5 describes.
has_concept() { # $1 = a bundle-relative source path
  local path="$1" dir base stem
  base="${path##*/}"
  case "$path" in
    */*) dir="${path%/*}/" ;;
    *) dir="" ;;
  esac
  case "$base" in
    ?*.*) stem="${base%.*}" ;;
    *) stem="$base" ;;
  esac

  # A directory named `Foo.md`, or a symlink pointing at nothing, is not a
  # concept file — `-f` answers for both.
  [ -f "$dir$stem.md" ] || return 1

  # A `.md` source is not its own concept. `bundle.extensions` decides what
  # counts as a source and nothing stops it naming `md`, and a source called
  # `notes.md` has a stem of `notes` and so derives itself: without this, every
  # markdown source in the bundle would mark itself documented and drop out of
  # the listing /okf-generate walks.
  [ ! "$dir$stem.md" -ef "$path" ] || return 1

  # It has to carry SPEC.md §4 frontmatter to be a concept and not just a
  # markdown file that happens to sit there: a README beside a source of the
  # same name is prose, and a `/okf-generate` interrupted part way through
  # leaves a file that opens like a concept and stops. Counted as concepts,
  # either would take that source off this list for good — including out of the
  # re-run that is the way to finish the interrupted write.
  has_frontmatter "$dir$stem.md" || return 1

  # Last, one of SPEC.md §4's reserved names is not a concept either, whatever
  # is written in it. A source whose stem collides with one — `index.ts`,
  # `log.py` — has no concept of its own to be found, because that name is
  # already spoken for: `index.md` is the directory's own document and `log.md`
  # belongs to OKF. So it is reported as having none.
  #
  # Reporting it is the honest answer — it really has none — and the one whose
  # mistakes are visible. The alternative is counting the directory's own
  # `index.md`, which would have `okf index` mark every such source documented
  # without writing a word about it, and a source silently dropped from the
  # bundle is the failure nobody goes looking for.
  #
  # It is also, admittedly, a source `/okf-generate` cannot take off this list:
  # every name it could write the concept under is either reserved or §5's
  # additional-type spelling `<stem>.<TypeName>.md`, and a `<stem>.<X>.md` is
  # indistinguishable from the concept of a sibling source called
  # `<stem>.<X>.<ext>` — `index.spec.md` beside `index.spec.ts` — so matching
  # one here would hide `index.ts` the moment its neighbour got documented.
  # SPEC.md does not settle what that concept is called, and this is not the
  # place to invent it: a name for it belongs in SPEC.md, and until there is
  # one, saying so every run beats guessing wrong in silence.
  #
  # Asked of the filesystem with `-ef` rather than of the string, because the
  # two disagree on a case-insensitive one — macOS's APFS, Windows — where
  # `Index.md` and the directory's own `index.md` are one file that a string
  # compare reads as two. That is exactly the silent drop this is here to stop,
  # so it is the file that has to be identified and not the name. `-ef` is
  # false when the reserved file is not there at all, which is the ordinary
  # case and needs no check of its own.
  local reserved
  for reserved in "${OKF_RESERVED_CONCEPT_NAMES[@]}"; do
    [ ! "$dir$stem.md" -ef "$dir$reserved" ] || return 1
  done
  return 0
}

# Prints a concept's `resource` — the source file SPEC.md §4 says the concept
# documents — or nothing at all when it declares none. Always exits 0: "this
# file names no resource" is an answer, not a failure.
#
# Read to SPEC.md §4's formatting contract and no further: the block is `---` on
# line 1 to the next line that is exactly `---`, and a top-level key is
# unindented `key: value`. Anchoring on the unindented spelling is what keeps
# the `  - resource: https://example.invalid/DON-86` inside a `sources:` list
# out of the answer — §4 is explicit that `sources` is for external references
# and never a restatement of `resource`, so reading one as the other would point
# this at a URL that is not a path at all.
#
# The first such line wins. A block with two `resource:` lines is malformed
# YAML with no defined meaning, and taking the first is both what §4's
# extraction rule for `code.X` does and the only choice that does not depend on
# how far past the mistake the reader kept going.
#
# CRLF and a UTF-8 BOM are stripped for the reason has_frontmatter strips them:
# a checkout on Windows changes how the lines are spelled and not what they say,
# and a concept okf stopped recognising there would be one it silently reported
# as documenting nothing.
#
# Surrounding quotes come off. §4's own example writes `resource:` bare and
# `content_hash:` quoted, so both spellings are in circulation, and a quoted
# path read with its quotes is a path that never exists — which on the orphan
# listing means a live concept reported as dead.
#
# This is deliberately not the frontmatter reader of Phase 4, which owes the
# whole §4 shell-read field set. It is the one field `okf list --orphans` needs,
# written narrowly so that reader can replace it rather than work around it.
concept_resource() { # $1 = a path to a concept file
  local line opened=0 value
  # `|| [ -n "$line" ]` so a last line with no newline after it is still read.
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#$'\xef\xbb\xbf'}"
    line="${line%$'\r'}"
    if [ "$opened" -eq 0 ]; then
      [ "$line" = "---" ] || return 0
      opened=1
      continue
    fi
    # The closing `---`. Nothing past it is frontmatter.
    [ "$line" != "---" ] || return 0
    case "$line" in
      resource:*)
        value="${line#resource:}"
        # Leading then trailing whitespace. A value that is nothing but
        # whitespace comes out empty, which is the same as absent: `resource:`
        # with nothing after it names no file, and okf cannot say whether a
        # file it was never told about is still there.
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        case "$value" in
          '"'*'"') value="${value#\"}" && value="${value%\"}" ;;
          "'"*"'") value="${value#\'}" && value="${value%\'}" ;;
        esac
        [ -n "$value" ] || return 0
        printf '%s\n' "$value"
        return 0
        ;;
    esac
  # stderr redirected before the input, for the reason has_frontmatter gives:
  # a `2> /dev/null` written after it is set up too late to catch the shell's
  # own complaint about opening the file.
  done 2> /dev/null < "$1"
  return 0
}

# Fills OKF_CONCEPTS with the repo's concept files, in the order `load_in_scope`
# lists its sources: every tracked `.md` that carries SPEC.md §4 frontmatter and
# is not one of §4's reserved names.
#
# Neither `include` nor `exclude` is applied here, deliberately. Both are
# written about sources — `src/**`, `**/node_modules/**`, and nothing stops one
# being written `src/**/*.py` or `**/*.md` — and a glob that names a source
# extension matches no concept anywhere in the repository. Asked of a concept's
# own path it would empty the orphan listing and exit 0, which is a bundle full
# of leftovers reported as having none. cmd_list asks both of the `resource`
# instead, where they are being asked about the thing they describe; SPEC.md
# §5's co-location makes that the same directory either way.
#
# The cost of leaving them out is that a vendored tree's markdown is opened to
# be looked at rather than skipped on its path. That is one read of one line
# each, against the risk above.
#
# Tracked files only, where has_concept asks the filesystem. The asymmetry is
# the point of each: has_concept answers "has this source been documented yet?",
# and a concept /okf-generate wrote a second ago counts. This answers "what is
# in the bundle?", and the bundle is what the repo has put under version
# control — the same `git ls-files` reading that makes gitignored files invisible
# to `okf list`. An orphan is made by *deleting a source*, and by then its
# concept has been committed for as long as the source was.
#
# SPEC.md §4's reserved names are skipped: `index.md` is the directory's own
# document and `log.md` belongs to OKF, so neither is any source's concept and
# neither can be orphaned by one going away.
load_concepts() {
  require_git_repo
  load_tracked_paths

  OKF_CONCEPTS=()
  local path dir reserved skip
  for path in ${OKF_TRACKED[@]+"${OKF_TRACKED[@]}"}; do
    case "$path" in
      *.md) ;;
      *) continue ;;
    esac
    # `git ls-files` answers from the index, which still holds a concept deleted
    # from the working tree and not yet staged as removed. A file that is not
    # there documents nothing and cannot be read to find out what it once did.
    # has_frontmatter below reaches the same verdict by failing to open it; this
    # is the cheap answer, and the one that says so in words.
    [ -f "$path" ] || continue

    case "$path" in
      */*) dir="${path%/*}/" ;;
      *) dir="" ;;
    esac
    # `-ef` rather than a name comparison, for the reason has_concept gives:
    # on a case-insensitive filesystem `Index.md` and `index.md` are one file
    # that a string compare reads as two.
    skip=0
    for reserved in "${OKF_RESERVED_CONCEPT_NAMES[@]}"; do
      [ ! "$path" -ef "$dir$reserved" ] || skip=1
    done
    [ "$skip" -eq 0 ] || continue

    # Frontmatter last, because it is the only one of these that opens a file.
    # A markdown file without it is prose — a README, a design note — and
    # counting it would put every one of them on a listing of things to delete.
    has_frontmatter "$path" || continue
    OKF_CONCEPTS+=("$path")
  done
}

# ---------------------------------------------------------------------------
# Subcommands
#
# One function per SPEC.md §7 subcommand, each replaced by its real
# implementation as the PLAN.md checklist reaches it. The usage line above each
# stub is the contract that implementation owes.
# ---------------------------------------------------------------------------

# The document `okf init` writes, transcribed from SPEC.md §6 rather than
# assembled out of parts: every value in it is a decision made there, and one
# built up from variables here would let a default be changed without §6 moving
# with it. tests/toolkit.sh reads §6's own JSON block back out of SPEC.md and
# compares it against what init writes, so the two cannot drift apart unnoticed.
#
# §6's `index` block is the one thing deliberately left out, and leaving it out
# is what "opt-in" means. SPEC.md §1 calls Tier B opt-in, and §6 defines what
# happens without that block — Tier B subcommands exit 2 naming the missing
# keys — which is reachable only if a freshly initialised repo has not got one.
# Writing it here would instead point every new repo at a Qdrant on localhost
# nobody asked for, and leave nothing to opt into; §6 documents the block's
# defaults for whoever does.
OKF_DEFAULT_CONFIG='{
  "okf_version": "0.2",
  "bundle": {
    "root": ".",
    "include": ["src/**", "lib/**"],
    "exclude": ["**/target/**", "**/build/**", "**/node_modules/**", "**/dist/**"],
    "extensions": ["java", "ts", "tsx", "py", "rs", "go", "js", "mjs"]
  },
  "tiers": {
    "tier0_max_members": 2,
    "tier0_max_loc": 15,
    "tier2_min_fan_in": 8,
    "tier2_min_loc": 200
  }
}'

# The bundle-root index.md `okf init` writes, per SPEC.md §4: the repo-root
# index.md is the bundle root, it is `type: Codebase`, and it is the **only**
# file in a bundle where `okf_version` is legal. Both facts are the reason this
# document exists at all — without it there is nowhere for the bundle to
# declare which OKF version it is written to.
#
# Written to the §4 formatting contract, which is load-bearing rather than
# cosmetic: `---` on line 1, a closing `---`, top-level keys unindented, no
# tabs and no folded scalars, because the shell reads frontmatter with awk.
#
# There is deliberately no `generated:` stamp. SPEC.md §3's tool list has no
# clock in it — no `date` — and the preflight's promise to name exactly what is
# missing only stays true of init if init uses nothing outside that list.
# `printf '%(...)T'` would need bash 4.2, and macOS still ships 3.2. A file with
# no timestamp is worth more than one with a wrong or unportable one; the
# subcommands that must stamp a time (`check --stamp`, `verify`) own that
# problem, and this file is not where it has to be solved.
root_index_document() { # $1 = the bundle's name, $2 = the okf_version it declares
  local name="$1" version="$2" quoted

  # Quoted, and escaped for quoting, because the name is a directory basename
  # and so is whatever the filesystem allowed: a `#`, a `:` or a leading `%` in
  # it turns an unquoted YAML scalar into a comment, a mapping or a parse
  # error. A double-quoted scalar is valid YAML for every one of those, and is
  # how SPEC.md §4's own example spells `signature`.
  #
  # `okf_version` is quoted for the same reason SPEC.md §6 makes it a JSON
  # string: unquoted, YAML reads 0.2 as a float, and the next version but one
  # — 0.10 — is read as 0.1 and stops matching the okf.json it was copied from.
  # `type` and `status` are left bare: both are words out of a §4 vocabulary,
  # and nothing in either can be mistaken for a number.
  quoted="${name//\\/\\\\}"
  quoted="${quoted//\"/\\\"}"

  printf '%s\n' \
    '---' \
    'type: Codebase' \
    "title: \"$quoted\"" \
    "description: \"OKF bundle root for $quoted.\"" \
    "okf_version: \"$version\"" \
    'status: draft' \
    '---' \
    '' \
    "# $name" \
    '' \
    'The OKF bundle root for this repository. Every concept lives beside the source' \
    'it describes — `Greeter.py` is documented by `Greeter.md` in the same directory' \
    "— and each directory's own \`index.md\` lists what that directory holds." \
    '' \
    '- `okf list --missing` — in-scope sources with no concept yet' \
    '- `okf check` — concepts whose source has changed underneath them' \
    '- `okf index` — regenerate the per-directory `index.md` files'
}

# Decides, for every file `okf init` is about to write, whether writing it is
# allowed — before any of them is written.
#
# All-or-nothing on purpose. init writes two files, and a run that wrote the
# one that was missing and refused the one that was there would leave a
# half-initialised bundle behind an exit status that means both. Worse, the
# obvious way out of such a refusal is --force, and --force is what destroys
# the hand-written index.md that caused it. Refusing before anything is written
# leaves every file exactly as it was, so the caller can move theirs aside or
# merge it by hand and re-run.
#
# Every refusal init can foresee is decided here, over all of the targets and
# before any of them is written, so that none can be the thing that fails after
# another has already gone in. Only the plain "already exists" refusal
# aggregates its offenders: that list is precisely what --force would
# overwrite, and a caller deciding whether to type it needs to see all of it.
# The others each stop at the first — a symlink and a directory in the way have
# nothing to do with each other, and neither is answered by the other's remedy.
#
# What is left after this function returns is the write itself: a full disk, a
# read-only mount, an I/O error partway through. Those can still leave the
# first file written and the second not, which no check ahead of the write can
# foresee and no shell can undo without the temp-file-and-rename that SPEC.md
# §3's tool list rules out. The line printed then names the file that did not
# get written, which is the one a caller has to do something about.
#
# Existence is what the refusal turns on, not content: an okf.json somebody
# tuned by hand and one okf wrote itself a minute ago are the same file from
# here, and guessing wrong destroys the tuning. --force is the caller saying
# which of the two it is.
init_guard() { # $1 = 1 if --force was given, $2.. = absolute paths
  local force="$1" path
  shift

  # Symbolic links first, and refused whichever way --force went, because
  # neither thing --force could mean here is what the caller asked for. A
  # redirection writes *through* the link, so `okf init --force` would replace
  # a file somewhere else entirely — outside the repo, if that is where the
  # link points. Replacing the link instead would silently detach whoever put
  # it there on purpose. Saying so and stopping leaves the choice with the one
  # person who knows which they meant. Ahead of the existence check as well as
  # ahead of --force, so a linked file is diagnosed as a link rather than
  # buried in a list of things that are merely in the way.
  for path in "$@"; do
    if [ -L "$path" ]; then
      die "$(display_path "$path") is a symbolic link" \
        "okf init writes this repo's own file, not whatever the link points at" \
        "remove the link and re-run"
    fi
  done

  # Two names for one file, which the string comparison in cmd_init cannot see:
  # a hard link makes okf.json and index.md one inode, and init would then
  # write its two documents one on top of the other and report both as written.
  # After the symlink loop, so a link is still diagnosed as a link — `-ef`
  # follows one and would otherwise answer for its target.
  local -a rest=("$@")
  local other
  while [ "${#rest[@]}" -gt 1 ]; do
    path="${rest[0]}"
    rest=("${rest[@]:1}")
    for other in "${rest[@]}"; do
      # `-ef` is false unless both paths stat, so a file that is not there yet
      # needs no separate check.
      if [ "$path" -ef "$other" ]; then
        die "$(display_path "$path") and $(display_path "$other") are the same file" \
          "okf init writes a different document to each, and one file cannot hold both" \
          "they are two names for one inode — remove one and re-run"
      fi
    done
  done

  # A target that is not a regular file, refused whichever way --force went and
  # before anything is written. --force means "replace the file that is there",
  # and a directory, a fifo or a device is not a file a redirection can
  # replace: writing to it fails however many times it is tried. Caught here
  # rather than left to the redirection because that failure would arrive after
  # the *other* file had already been written, which is exactly the
  # half-initialised bundle this function exists to prevent. One line, because
  # naming the path and what is wrong with it is the whole of what a caller
  # needs to act.
  for path in "$@"; do
    if [ -e "$path" ] && [ ! -f "$path" ]; then
      die "$(display_path "$path") is not a regular file"
    fi
  done

  # Plain existence, which is the one refusal --force is allowed to overrule.
  # Aggregated rather than reported one at a time, because this list is exactly
  # what --force would overwrite, and a caller deciding whether to type it
  # needs to see all of it.
  if [ "$force" -eq 0 ]; then
    local -a existing=()
    for path in "$@"; do
      if [ -e "$path" ]; then
        existing+=("$(display_path "$path") already exists")
      fi
    done
    if [ "${#existing[@]}" -gt 0 ]; then
      if [ "${#existing[@]}" -eq 1 ]; then
        existing+=("re-run with --force to overwrite it")
      else
        # Said explicitly, because --force is one flag over both files and the
        # caller in front of this message usually wants only one of them: a
        # second config for CI, say, in a bundle whose index.md they wrote by
        # hand. Answering that with a bare "--force" would trade their index.md
        # for an okf.ci.json without ever having said so.
        existing+=("re-run with --force to overwrite them" \
          "--force overwrites every file okf init writes, so move aside any you mean to keep")
      fi
      die "${existing[@]}"
    fi
  fi

  # Permission, last, because it is the only one of these questions that is
  # worth asking about a file init has already decided it is going to write.
  # A read-only index.md is refused *here* and not by the redirection that
  # would hit it, which would only fail after okf.json had gone in — the
  # half-initialised bundle again, and this time from a cause that can be seen
  # in advance.
  #
  # `-w` is a question about this process, so it answers for the ordinary cases
  # — a read-only file, a directory nobody may write in — and not for a
  # read-only mount or an ACL that only the write itself will discover. Those
  # are why init_write still reports its own failures; this is why it rarely
  # has to.
  local dir
  for path in "$@"; do
    if [ -e "$path" ]; then
      [ -w "$path" ] || die "$(display_path "$path") is not writable"
      continue
    fi
    dir="${path%/*}"
    [ -n "$dir" ] || dir="/"
    [ -d "$dir" ] || die "cannot create $(display_path "$path"): no such directory: $dir"
    [ -w "$dir" ] || die "cannot create $(display_path "$path"): $dir is not writable"
  done
}

# Writes one of the files `okf init` is responsible for, init_guard having
# already decided that writing it is allowed.
#
# Nothing outside SPEC.md §3's tool list is used to do it — no mktemp, no mv —
# so that the preflight's promise to name exactly what is missing stays true of
# init as well. That rules out the write-elsewhere-then-rename trick, and the
# `set -C` below is what is left: it makes "is it already there?" and the
# creation a single step the filesystem takes, so a file that appeared between
# init_guard's look and this write cannot be silently clobbered by it.
init_write() { # $1 = absolute path, $2 = 1 if --force was given, $3 = content
  local path="$1" force="$2" content="$3" dir

  # ${path%/*} rather than dirname, for the reason above. An absolute path with
  # a single component — /okf.json — leaves this empty, and its directory is /.
  dir="${path%/*}"
  [ -n "$dir" ] || dir="/"
  [ -d "$dir" ] || die "cannot write $(display_path "$path"): no such directory: $dir"

  if [ "$force" -eq 1 ] && [ -e "$path" ]; then
    # This truncates at open, so a write that then fails — a full disk, a
    # quota — leaves neither the old file nor the new one. Accepted rather
    # than fixed: closing it needs the write-elsewhere-then-rename the
    # paragraph above rules out, and what is lost is a file --force was about
    # to replace anyway. The create path below has no such window, because
    # there is nothing there to truncate.
    #
    # stderr silenced for the same reason -C's cd is: what bash prints here
    # names a line number inside bin/okf, and it arrives ahead of the line
    # below that actually says which file the caller has to do something about.
    printf '%s\n' "$content" 2> /dev/null > "$path" \
      || die "cannot write $(display_path "$path")"
    return 0
  fi

  # Not `[ -e ] || create`: see above. A failure here is either that race or an
  # unwritable directory, and the message says the one thing true of both.
  (set -C && printf '%s\n' "$content" > "$path") 2> /dev/null \
    || die "cannot create $(display_path "$path")"
}

# okf init [--force] — write okf.json + the bundle-root index.md
cmd_init() {
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      # Twice is not an error: --force says overwrite, and saying it again says
      # the same thing.
      --force) force=1 ;;
      # The subcommand's own end-of-flags marker — parse_globals passes this
      # one through — after which init still takes no operands, so whatever
      # follows falls to the check below and is named there.
      --)
        shift
        break
        ;;
      -*) die "init: unknown flag: $1" "usage: okf init [--force]" ;;
      *) break ;;
    esac
    shift
  done

  # Checked before anything is written, so a mistyped line is answered rather
  # than acted on: `okf init --fore` is not an init that quietly skipped the
  # --force it was asked for.
  [ $# -eq 0 ] || die "init takes no arguments, but was given: $1" \
    "usage: okf init [--force]"

  # A self-check on the literal above, and the only reason it is worth a jq
  # invocation: an okf.json that does not parse is a repo where every later
  # subcommand fails at once, somewhere well away from the edit that caused it.
  printf '%s\n' "$OKF_DEFAULT_CONFIG" | jq empty > /dev/null 2>&1 \
    || die "the built-in default okf.json is not valid JSON — this is a bug in bin/okf"

  # Read back out of the default config rather than written twice: SPEC.md §6
  # settles the version in okf.json and §4 makes the bundle-root index.md the
  # only other file allowed to name one. Two literals could disagree, and a
  # bundle whose index.md and okf.json claim different OKF versions is a
  # question with no answer.
  local version
  version="$(printf '%s\n' "$OKF_DEFAULT_CONFIG" | jq -r '.okf_version // empty')"
  [ -n "$version" ] \
    || die "the built-in default okf.json declares no okf_version — this is a bug in bin/okf"

  # The bundle root is the repo root, which is what -C moves and --config does
  # not: --config says where the *settings* live — CI's okf.ci.json is still
  # this repo's settings — while SPEC.md §4 puts the bundle root index.md at
  # the root of the bundle itself and nowhere else.
  local index_path="$OKF_ROOT/index.md"

  # The bundle is named for the directory it is in. Empty only when the root is
  # `/`, which is then also its own best name.
  local name="${OKF_ROOT##*/}"
  [ -n "$name" ] || name="$OKF_ROOT"

  # --config can be pointed at the bundle root's own index.md, and then the two
  # documents init writes are two documents for one file: the second overwrites
  # the first, and the repo ends up with an index.md and no settings at all.
  # Caught before either is written, because with --force there is nothing
  # about the result to notice — both writes succeed, and `wrote index.md`
  # prints twice.
  if [ "$(canonical_path "$OKF_CONFIG")" = "$(canonical_path "$index_path")" ]; then
    die "--config names the bundle-root index.md: $(display_path "$index_path")" \
      "okf init writes both, and one file cannot be both"
  fi

  # $OKF_CONFIG, not the string okf.json: SPEC.md §7 gives every subcommand
  # --config PATH, and an init that wrote to a hard-coded name would be the one
  # subcommand that ignored where it was told the settings live. -C is honoured
  # for free, having already moved both the root and this path with it.
  init_guard "$force" "$OKF_CONFIG" "$index_path"

  # Each write reported as it happens, so that a second write failing on what
  # no check could foresee — a full disk, a read-only mount, an ACL — still
  # leaves the caller knowing the first file is there. Told only about the
  # failure, their obvious next move is to re-run, and the re-run refuses
  # because of the okf.json this one wrote; the way out of that looks like
  # --force, which is a much bigger hammer than the situation calls for.
  #
  # The refusals okf *can* foresee are all decided in init_guard above, before
  # any of this runs, so nothing routine prints a `wrote` line ahead of an
  # error.
  init_write "$OKF_CONFIG" "$force" "$OKF_DEFAULT_CONFIG"
  printf 'wrote %s\n' "$(display_path "$OKF_CONFIG")"

  init_write "$index_path" "$force" "$(root_index_document "$name" "$version")"
  printf 'wrote %s\n' "$(display_path "$index_path")"
  # Said here because this is the run that decided it: the config just written
  # has no `index` block, so Tier B is off until someone adds one. Left unsaid,
  # the first `okf search` looks like a broken install rather than a feature
  # that was never turned on.
  printf 'Tier B (chunk, embed, search) is opt-in: add an "index" block to %s to enable it.\n' \
    "$(display_path "$OKF_CONFIG")"
}

# okf list [--missing] [--orphans] — in-scope source files
cmd_list() {
  local missing=0 orphans=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --missing) missing=1 ;;
      --orphans) orphans=1 ;;
      --)
        shift
        break
        ;;
      -*)
        die "list: unknown flag: $1" "usage: okf list [--missing] [--orphans]"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -eq 0 ] || die "list takes no arguments, but was given: $1" \
    "usage: okf list [--missing] [--orphans]"

  # --missing narrows the source listing; --orphans replaces it with a listing
  # of concept files. Neither is a filter on the other, so there is no listing
  # that answers both — and picking one silently would hand back paths of the
  # wrong kind to a caller who cannot see which flag got dropped. Refused, with
  # both flags named, rather than ranked.
  if [ "$missing" -eq 1 ] && [ "$orphans" -eq 1 ]; then
    die "list: --missing and --orphans name different listings — sources, and concepts" \
      "give one or the other" \
      "usage: okf list [--missing] [--orphans]"
  fi

  local path
  if [ "$orphans" -eq 1 ]; then
    # SPEC.md §5's co-location read the other way round from --missing: not a
    # source with no concept beside it, but a concept whose source has gone.
    #
    # The concept's own `resource` decides it, not the sibling `<stem>.<ext>`
    # that has_concept looks for. §5 gives a file's *additional* top-level types
    # the spelling `<stem>.<TypeName>.md`, and no source is ever named
    # `RouteRegistry.Inner.<ext>` — so a listing built from the co-located name
    # would call every one of those an orphan while its source sat right beside
    # it. `resource` is where the concept says what it documents, and it is the
    # only thing here that survives §5's naming rules.
    #
    # A concept that declares no `resource` is left off. okf has not been told
    # what it documents, so it cannot have found out that thing is gone, and
    # this listing is one a caller acts on by deleting files: a wrong name on it
    # costs a concept somebody wrote, where a missing one costs a stale file
    # that stays until `resource` is filled in.
    local resource resource_dir concept_dir
    load_concepts
    load_bundle_globs
    for path in ${OKF_CONCEPTS[@]+"${OKF_CONCEPTS[@]}"}; do
      resource="$(concept_resource "$path")"
      [ -n "$resource" ] || continue
      # §4 puts path-valued fields in bundle-absolute form — a leading `/` that
      # means the bundle root and not the filesystem's. okf is standing in the
      # root, so dropping it makes the path one this can test directly. A
      # `resource` written without the leading `/` is read the same way rather
      # than refused: the two spellings name one file, and §4's form is a
      # recommendation about surviving file moves, not a gate on being read.
      resource="${resource#/}"

      # SPEC.md §5's co-location, asked as a directory and not as a filename:
      # the concept lives beside its source, so a `resource` naming a file in
      # some other directory is not one this concept documents by §5's rules.
      # The filename is deliberately not derived — §5 gives a file's additional
      # top-level types the spelling `<stem>.<TypeName>.md`, which no source is
      # ever named — so the directory is as much as can be checked, and it is
      # the part that matters.
      #
      # What it is really guarding is the bundle boundary. A vendored or
      # nested repository with its own okf.json is its own bundle, and its
      # concepts write `resource` bundle-absolute against *its* root: read from
      # out here, `/src/util/helper.ts` is a file that was never in this
      # repository, and every concept it has would be reported as this bundle's
      # orphan. This listing is acted on by deleting files, so that is the
      # expensive direction — and §5 is what tells a nested bundle's concept
      # from one of this bundle's own.
      case "$resource" in
        */*) resource_dir="${resource%/*}/" ;;
        *) resource_dir="" ;;
      esac
      case "$path" in
        */*) concept_dir="${path%/*}/" ;;
        *) concept_dir="" ;;
      esac
      [ "$resource_dir" = "$concept_dir" ] || continue

      # SPEC.md §6's `include` and `exclude`, asked of the source and not of the
      # concept. Both settings are written about sources, and one written
      # `src/**/*.py` matches no `.md` in the repository at all — asked of a
      # concept's own path it would report a bundle full of leftovers as having
      # none. Co-location above has already made this the concept's directory,
      # so what the two spellings differ over is only the filename, which is
      # exactly the part these globs are entitled to have an opinion about.
      #
      # `extensions` is deliberately not asked. It says what kind of file gets
      # documented, and a concept that exists is evidence one already was:
      # narrowing `extensions` to `["java"]` today does not make yesterday's
      # TypeScript concept stop being a leftover when its source goes.
      in_bundle_globs "$resource" || continue

      [ ! -e "$resource" ] || continue
      printf '%s\n' "$path"
    done
    return 0
  fi

  load_in_scope

  # --missing narrows the same listing rather than producing another one, so the
  # order and the paths are the ones plain `okf list` prints. That is what makes
  # it the input /okf-generate walks: the sources with no concept beside them,
  # in the order the bundle holds them.
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    if [ "$missing" -eq 1 ] && has_concept "$path"; then
      continue
    fi
    printf '%s\n' "$path"
  done
}

# okf hash <file> — sha256:… of one file
#
# The measuring half of SPEC.md §8's drift rule: a concept's `code.content_hash`
# is the sha256 of its `resource` as that file stood when the prose was written,
# and drift is that stored string differing from what this prints today. What
# comes out here is therefore a value that gets *stored* — written into
# frontmatter by a slash command, read back months later by an `okf check` that
# has nothing to go on but the two strings.
#
# Which is why the `sha256:` prefix is part of the answer and not a label on it.
# SPEC.md §4 writes the field as "sha256:9f2a…", so a bare hex digest written
# into it would be a stored value naming no algorithm at all, and the day okf
# grows a second one there would be no telling which had produced it.
#
# Nothing here reads okf.json, and nothing here reads git. A digest is a fact
# about one file's bytes rather than about the bundle, and every caller that has
# one to hash has already decided it is theirs to hash: `okf check` asks about a
# resource a concept named, and a scope test it had to pass first would refuse
# exactly the concept whose source has just moved out of `include` — the one
# where knowing whether it drifted matters most.
cmd_hash() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # End of flags. Past it a word beginning with a dash is the filename,
        # which is how a caller hashes a file that really is named `-weird.py`.
        shift
        break
        ;;
      -*)
        # The same hint parse_globals gives for a --config whose path begins
        # with a dash, because it is the same slip: a file can be named
        # anything, and nothing else here could tell the two apart.
        die "hash: unknown flag: $1" \
            "spell it ./$1, or put it after --, if that really is the file" \
            "usage: okf hash <file>"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -gt 0 ] || die "hash needs a file to hash" "usage: okf hash <file>"

  # One file and not a list. The output is a bare digest with nothing in it
  # naming what it is of, so a second path could only come back as a second
  # unlabelled line for the caller to match up by position — or be dropped in
  # silence, leaving them holding the first file's digest for the second file's
  # concept, which is a `content_hash` that is wrong rather than missing.
  [ $# -eq 1 ] || die "hash takes one file, but was given $#: $*" \
    "usage: okf hash <file>"

  local path="$1"

  if [ ! -e "$path" ]; then
    # SPEC.md §4 spells path-valued fields bundle-absolute — a leading `/` that
    # means the bundle root and not the filesystem's — so a `resource` read out
    # of a concept and handed straight to `okf hash` names a file that is almost
    # never there. The argument is read as a filesystem path all the same:
    # guessing between the two spellings would give `okf hash /etc/hosts` two
    # possible answers and no way for the caller to say which they meant. What
    # the guess is spent on instead is this line, which names the other
    # spelling without hashing anything.
    local rooted="${path#/}"
    if [ "$rooted" != "$path" ] && [ -e "$rooted" ]; then
      die "no such file: $path" \
        "paths are read as the filesystem's, not as SPEC.md §4's bundle-absolute form" \
        "did you mean $rooted ?"
    fi
    die "no such file: $path"
  fi

  # A directory is named as one rather than left to the regular-file line below,
  # because it is the answer to a plausible question — `okf hash src/util` from
  # someone expecting a digest of the tree — and "not a regular file" would read
  # as okf having failed to open something it could see.
  [ ! -d "$path" ] || die "hash takes a file, but $path is a directory"

  # -f and not -e for everything else: a fifo would hang here waiting on a
  # writer that is never coming, and a device would hand back bytes that are
  # nobody's file contents. A symlink to a regular file passes and hashes what
  # it points at, which is the file the caller named.
  [ -f "$path" ] || die "hash takes a regular file, but $path is not one"
  [ -r "$path" ] || die "cannot read: $path"

  # Fed on stdin rather than named as an argument. sha256sum echoes the name it
  # was given beside the digest, and escapes one containing a backslash or a
  # newline by prefixing the whole line with `\` — so the digest is not reliably
  # where the first field is — while a name beginning with a dash would be read
  # as an option before the file was ever opened. Redirected in, there is no
  # name in the output to work around and none on the command line to be
  # misread, and the shell has already opened the file by the time sha256sum
  # runs.
  local digest
  digest="$(sha256sum < "$path")" || die "could not hash: $path"
  digest="${digest%% *}"

  # Checked rather than trusted, because everything downstream of this compares
  # the string and never reads it: a truncated or decorated digest stored as a
  # `content_hash` would not look wrong in frontmatter, and would report drift
  # on every `okf check` from then on — against a file nobody had touched.
  case "$digest" in
    "" | *[!0-9a-f]*)
      die "sha256sum did not print a digest for $path: $digest"
      ;;
  esac
  if [ "${#digest}" -ne 64 ]; then
    die "sha256sum printed ${#digest} hex characters for $path, not a sha256's 64: $digest"
  fi

  printf 'sha256:%s\n' "$digest"
}

# okf fanin <Name> — whole-word reference count across in-scope files
#
# SPEC.md §5's fan-in, and its caveat is part of the definition rather than a
# footnote on it: this is a ripgrep count of a *name*, so it counts the word in
# a comment, in a string literal and in an unrelated type that happens to share
# the name, and it misses every reference written through an alias or an import
# rename. §5 settles what that makes it — "a ranking signal for where
# documentation effort goes, never a correctness claim" — and settles the one
# repair anybody would reach for: a parser resolves references by name too, so
# adding one buys the same number with a compiler in front of it. Do not.
#
# What it is good for is the comparison. A name at 40 and a name at 1 differ by
# more than any of the above can explain, and SPEC.md §5's tier rules ask
# exactly that kind of question — `fan_in >= tier2_min_fan_in`, `exported with
# fan_in >= 4`. Between two names a few apart, the number is not evidence.
#
# Matches and not matching lines: two references on one line are two references,
# and a `Map<RouteKey, RouteKey>` counting once would make a line's layout part
# of the answer. `rg --count-matches` is the flag for it; plain `--count` is the
# line count and is the one thing here easy to reach for by mistake.
#
# One name per invocation, and so one `git ls-files` and one @Generated scan per
# name — which is what a caller asking about every type in the repo pays twice
# over. That is SPEC.md §7's surface and §7 is read-only, so it is not something
# to route around here: the fix is not a cache under `.okf/`, whose invalidation
# would be a second drift rule to get wrong, but a caller that asks once per
# type and reads the numbers it gets back. Said here so the cost is a known one.

# How many paths go to ripgrep at once, for the same reason as the generated
# scan's own batch: the argument list stays well inside any ARG_MAX, and a
# repository of ordinary size is still one invocation. Its own constant rather
# than a shared one, because the two scans are bounded by different things —
# that one by the per-batch membership test it does afterwards, this one by
# nothing but the argument list.
OKF_FANIN_BATCH=400

# Running total for count_batch_references, which cannot hand a number back
# through a command substitution: `die` inside one exits the subshell, and the
# caller reads a failed scan as an empty count and adds nothing to it.
OKF_FANIN_TOTAL=0

# Adds one batch's whole-word match count to OKF_FANIN_TOTAL.
count_batch_references() { # $1 = the name, $2.. = one batch of in-scope paths
  local name="$1"
  shift

  local -a records=()
  local record
  while IFS= read -r record; do
    records+=("$record")
  done < <(
    # ripgrep's status carried out in the stream, as the generated scan carries
    # its own: a process substitution's exit status is invisible to the shell
    # reading it, and a ripgrep that failed outright prints no counts at all —
    # which is indistinguishable from a batch nothing matched, and would report
    # a fan-in of 0 for a name referenced everywhere. `set +e` so the inherited
    # errexit does not act on the 1 that means "matched nothing", which is the
    # ordinary answer for most names in most batches.
    #
    # --no-filename is what makes this stream safe to read as lines: every
    # record is then a bare count, so no path — with a newline, a colon or a
    # backslash in it — is ever parsed back out of ripgrep's output.
    #
    # --case-sensitive and --fixed-strings are both spelled out. ripgrep already
    # defaults to the first, but the default is smart-case in some builds'
    # configuration files, and `RouteKey` matching `routekey` would silently
    # inflate every count; the second is what keeps a name from being read as a
    # pattern, so a `.` in a qualified name matches a dot and not any character.
    # --no-config turns off the file that could have changed either.
    #
    # --text because a source file with a stray NUL in it is still a file whose
    # references count, and binary detection would drop it from the total with
    # nothing said on stdout to show a file had been skipped.
    set +e
    rg --no-config --no-ignore --case-sensitive --fixed-strings --word-regexp \
      --text --count-matches --no-filename -e "$name" -- "$@"
    printf 'status:%s\n' "$?"
  )

  local count="${#records[@]}"
  [ "$count" -gt 0 ] \
    || die "the fan-in scan wrote nothing at all, not even its exit status"
  local status="${records[$((count - 1))]}"
  unset "records[$((count - 1))]"
  case "$status" in
    # Matched, or matched nothing. Anything else is a scan that did not happen,
    # and a scan that did not happen looks exactly like a name nobody
    # references — so it is said rather than added up. ripgrep's own message,
    # naming the file it could not read, has already gone to stderr.
    status:0 | status:1) ;;
    *)
      die "ripgrep could not count references to $name — see its message above" \
        "okf will not print a fan-in it could not finish counting"
      ;;
  esac

  for record in ${records[@]+"${records[@]}"}; do
    # Every record should be a bare count, so one that is not means ripgrep
    # printed something into this stream that --no-filename was supposed to keep
    # out. Adding it as 0 would leave a total that is quietly short.
    case "$record" in
      "" | *[!0-9]*)
        die "ripgrep printed something other than a count while counting $name: $record"
        ;;
    esac
    OKF_FANIN_TOTAL=$((OKF_FANIN_TOTAL + record))
  done
}

cmd_fanin() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        # End of flags, as for `okf hash`. Past it a word beginning with a dash
        # is the name — which no type is called, but the escape hatch costs a
        # line and its absence would be a name okf could not be asked about.
        shift
        break
        ;;
      -*)
        die "fanin: unknown flag: $1" \
            "put it after --, if that really is the name" \
            "usage: okf fanin <Name>"
        ;;
      *) break ;;
    esac
    shift
  done

  [ $# -gt 0 ] || die "fanin needs a name to count references to" \
    "usage: okf fanin <Name>"

  # One name and not a list, for the reason `okf hash` takes one file: the
  # output is a bare number with nothing in it naming what it counted, so a
  # second name could only come back as a second unlabelled line to be matched
  # up by position — or be dropped in silence, leaving the caller storing the
  # first name's fan-in on the second name's concept.
  [ $# -eq 1 ] || die "fanin takes one name, but was given $#: $*" \
    "usage: okf fanin <Name>"

  local name="$1"

  # An empty name is refused rather than counted. ripgrep reads the empty
  # pattern as a match at every position, so this would come back as a number
  # roughly the size of the repository — a fan-in that is not merely wrong but
  # wrong in the direction that promotes a concept to Tier 2.
  #
  # Whitespace goes with it, and a newline is the reason: ripgrep refuses a
  # literal newline outside multiline mode, so `okf fanin` would report a failed
  # scan for what is really a malformed name. The rest of the whitespace is
  # refused alongside it because it is the same mistake — a shell quoting slip,
  # or a `<Name>` pasted with its surroundings — and because `-w` around a space
  # counts word boundaries rather than references.
  case "$name" in
    "") die "fanin needs a name to count references to, and was given an empty one" \
          "usage: okf fanin <Name>" ;;
    *[[:space:]]*)
      die "fanin takes one name, and this one has whitespace in it: $name" \
          "a fan-in count is over a single whole word — check the quoting" \
          "usage: okf fanin <Name>"
      ;;
  esac

  load_in_scope

  # SPEC.md §5's "minus the declaration site", decided by co-location because
  # that is the only thing the shell has to decide it with: §5 puts a concept
  # beside its source as `<stem>.md`, so a type named `RouteRegistry` is
  # declared in a `RouteRegistry.<ext>` and its own file's mentions of itself —
  # the declaration, the constructors, its own javadoc — are not fan-in.
  #
  # The whole file goes rather than one line of it. What "the declaration site"
  # names is the place the type is defined, and subtracting a single occurrence
  # would leave a Java class's constructors counting as references to
  # themselves, so a big self-contained type would out-rank a small
  # widely-used one.
  #
  # One file, or none. Two in-scope files can bear the name as their stem —
  # `src/a/config.ts` and `src/b/config.ts`, `com/a/Result.java` and
  # `com/b/Result.java` — and then nothing here can say which of them declares
  # the name being counted, or whether either does. Dropping both would throw
  # away every reference they make as well as any declaration they hold, and a
  # widely-used name would come back under SPEC.md §5's `tier2_min_fan_in` for
  # having callers in like-named files. So an ambiguous stem excludes nothing
  # and the declarations stay in the count.
  #
  # Where it is still wrong, and in which direction, since neither is a thing to
  # find out from a number that comes back looking the same either way.
  #
  # High, when the file okf cannot spot as a declaration site keeps its own
  # declaration in: a language that does not name the file after the type —
  # `Core` in `core.py` — a second top-level type sharing a file, and the
  # ambiguous stem above. Each of those adds a handful to a name that is
  # under-referenced anyway.
  #
  # Low, in the one case a single stem match is not the declaration: `Widget`
  # declared in `src/index.ts` and referenced from `src/tests/Widget.ts` loses
  # that file's references. Nothing short of reading the source tells that file
  # from the declaring one — which is why SPEC.md §5 calls fan-in "a ranking
  # signal for where documentation effort goes, never a correctness claim", and
  # rules out the parser that would look like the fix. It is left as §5 defines
  # it, and named here so that a fan_in that reads low against
  # `tier2_min_fan_in` has somewhere to be explained rather than trusted.
  #
  # Between the two, ties break high: that is what the ambiguous-stem rule above
  # buys, and it is the cheap half. A name counted a little high costs a concept
  # more prose than it needed; a hot type counted low is a type nobody documents.
  local -a named=()
  local path base stem
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    base="${path##*/}"
    stem="${base%.*}"
    [ "$stem" = "$name" ] || continue
    named+=("$path")
  done

  local -a targets=()
  for path in ${OKF_IN_SCOPE[@]+"${OKF_IN_SCOPE[@]}"}; do
    if [ "${#named[@]}" -eq 1 ]; then
      base="${path##*/}"
      stem="${base%.*}"
      [ "$stem" != "$name" ] || continue
    fi
    targets+=("$path")
  done

  OKF_FANIN_TOTAL=0

  # No files left to search is 0 references and not an error: a bundle whose
  # only in-scope file is the one declaring this name is a real answer, and so
  # is a repository with nothing in scope yet. ripgrep given no paths at all
  # would read stdin instead, and hang.
  if [ "${#targets[@]}" -gt 0 ]; then
    local -a batch=()
    for path in "${targets[@]}"; do
      batch+=("$path")
      if [ "${#batch[@]}" -ge "$OKF_FANIN_BATCH" ]; then
        count_batch_references "$name" "${batch[@]}"
        batch=()
      fi
    done
    [ "${#batch[@]}" -eq 0 ] || count_batch_references "$name" "${batch[@]}"
  fi

  # One number and nothing else, so `fan_in=$(okf fanin RouteRegistry)` is the
  # whole of reading it and a threshold test is arithmetic on what comes back.
  printf '%d\n' "$OKF_FANIN_TOTAL"
}

# okf check [--strict] [--stamp] [--json] — drift, missing and orphan concepts
cmd_check() { not_implemented check; }

# okf index — regenerate the per-directory index.md files
cmd_index() { not_implemented index; }

# okf verify <concept> [--by ACTOR] — append a verified entry
cmd_verify() { not_implemented verify; }

# okf chunk <concept> — Tier B: emit JSON chunks for one concept
cmd_chunk() { not_implemented chunk; }

# okf embed [--all] — Tier B: embed and upsert to Qdrant
cmd_embed() { not_implemented embed; }

# okf search <query> [--hyde-prompt] [--k N] [--repo R] [--type T]
cmd_search() { not_implemented search; }

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  # SPEC.md §3: on every invocation, before anything else — including before
  # the global flags are read, so a machine missing rg is told about rg rather
  # than about the -C directory it also mistyped. The tools Tier B needs on top
  # of these are checked at dispatch, where the subcommand asked for is known —
  # a caller who typed `okf list` is not told to install curl.
  preflight

  # Before anything reaches git, and before -C is even read: what these name
  # outranks both the flag and the directory okf is standing in.
  isolate_git_environment

  # SPEC.md §7's -C DIR and --config PATH, taken out of the line here so that
  # everything below — the bare-invocation check, dispatch, the subcommand's
  # own flags — sees only what the caller asked okf to *do*.
  parse_globals ${1+"$@"}
  enter_root
  set -- ${OKF_ARGV[@]+"${OKF_ARGV[@]}"}

  # No subcommand at all: the same help, but on stderr and exiting 1. A caller
  # that reached here with an empty argument asked for nothing and got nothing
  # done, and exiting 0 would let it mistake that for success. `okf -C repo`
  # lands here too — a root and nothing to do with it.
  if [ $# -eq 0 ]; then
    usage >&2
    return 1
  fi

  local sub="$1"
  shift

  # Answered before the subcommand table, so `--help` stays help rather than
  # becoming "unknown subcommand: --help".
  case "$sub" in
    -h | --help)
      usage
      return 0
      ;;
  esac

  local known
  for known in "${OKF_SUBCOMMANDS[@]}"; do
    [ "$sub" = "$known" ] || continue
    if ! declare -F "cmd_$sub" > /dev/null; then
      # Listed in OKF_SUBCOMMANDS but never written: a bug in this script, not
      # in the caller's command line, so say which of the two it is.
      die "$sub is listed as a subcommand but has no cmd_$sub function"
    fi
    http_preflight "$sub" ${1+"$@"}
    # ${1+"$@"} rather than "$@": under `set -u` an empty "$@" is an unbound
    # variable on bash 3.2, which is still what macOS ships.
    "cmd_$sub" ${1+"$@"}
    return $?
  done

  case "$sub" in
    -*)
      # Nothing beginning with a dash was ever going to be a subcommand, so the
      # useful thing to say is which flags do belong here — `okf -Csrc list` is
      # a -C whose directory was glued to it.
      die "unknown subcommand: $sub" \
        "the flags accepted here are -C DIR, --config PATH and --help" \
        "expected one of: ${OKF_SUBCOMMANDS[*]}"
      ;;
  esac
  die "unknown subcommand: $sub" "expected one of: ${OKF_SUBCOMMANDS[*]}"
}

# Guarded so that sourcing bin/okf yields its functions without also running a
# command line. Executed — installed on $PATH, or run from the checkout — the
# two are the same path and main runs as always; sourced, $0 is the sourcing
# shell's and it does not. That is what lets tests/toolkit.sh call
# parse_globals directly and read back the root and config path it resolved,
# which no subcommand prints and none should have to.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main ${1+"$@"}
fi
