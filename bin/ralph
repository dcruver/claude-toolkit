#!/usr/bin/env bash
# ralph — compatibility alias for ralph-claude.
#
# ralph was a single script until the step agent became pluggable; the loop now
# lives in ralph-common and the Claude-specific half in ralph-claude. This name
# is kept because it is what existing runs, muscle memory, SPEC.md and
# tests/toolkit.sh all invoke, and because a loop already running from an older
# copy of it must keep resolving after an install.
#
# Sourcing this file still defines ralph-common's helpers in the caller's shell,
# which is how tests/toolkit.sh calls item_concept_docs directly. Neither this
# file's guard nor ralph-claude's fires when sourced, so nothing runs; executed,
# only this outermost guard matches $0 and ralph_main runs exactly once.

# Set before the source so ralph-claude's `: "${RALPH_PROG:=ralph-claude}"`
# leaves it alone: --help and errors should say the name that was typed.
RALPH_PROG="ralph"

# Locating the file this wrapper sources, without shelling out. tests/toolkit.sh
# sources these wrappers on a PATH carrying nothing but bash, deliberately, so
# that a helper reaching for a tool ralph has not declared shows up as a
# failure rather than passing on the developer's own PATH. Parameter expansion
# is therefore the normal path. readlink is a rescue for a hand-made symlink
# only, and never reached by a supported install: install.sh copies bin/* onto
# $PATH rather than symlinking it.
_ralph_dir="${BASH_SOURCE[0]%/*}"
[ "$_ralph_dir" = "${BASH_SOURCE[0]}" ] && _ralph_dir="."
if [ ! -f "$_ralph_dir/ralph-claude" ] && command -v readlink > /dev/null 2>&1; then
  _ralph_self="$(readlink -f "${BASH_SOURCE[0]}")"
  _ralph_dir="${_ralph_self%/*}"
fi
# shellcheck source=/dev/null
. "$_ralph_dir/ralph-claude"

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  ralph_main "$@"
fi
